{
  "manifest_version": 3,
  "name": "Neon M5 test extension",
  "description": "Loaded by all_containers_m5.py: an options page, a background and a content script.",
  "version": "1.0",
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["tabs", "identity"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
