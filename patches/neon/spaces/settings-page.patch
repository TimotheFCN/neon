+namespace neon::spaces {
+
+namespace {
+
+// Space colours travel as unsigned 32-bit ARGB numbers.
+double ColorToValue(SkColor color) {
+  return static_cast<double>(color);
+}
+
+std::optional<SkColor> ColorFromValue(const base::Value& value) {
+  if (!value.is_double() && !value.is_int()) {
+    return std::nullopt;
+  }
+  const double number = value.GetDouble();
+  if (number < 0 || number > 0xffffffffu) {
+    return std::nullopt;
+  }
+  const SkColor color = static_cast<SkColor>(number);
+  // A colour is either none or opaque.
+  return SkColorGetA(color) == 0 ? SK_ColorTRANSPARENT
+                                 : SkColorSetA(color, SK_AlphaOPAQUE);
+}
+
+// A black |icon| as a PNG data URL, for the page to use as a mask.
+std::string GetIconDataUrl(const gfx::VectorIcon& icon) {
+  constexpr int kSize = 40;
+  const gfx::Image image(gfx::CreateVectorIcon(icon, kSize, SK_ColorBLACK));
+  scoped_refptr<base::RefCountedMemory> png = image.As1xPNGBytes();
+  return base::StrCat({"data:image/png;base64,", base::Base64Encode(base::span(*png))});
+}
+
+}  // namespace
+
+SpacesSettingsHandler::SpacesSettingsHandler(Profile* profile)
+    : profile_(profile),
+      service_(SpacesServiceFactory::GetForProfile(profile)) {}
+
+SpacesSettingsHandler::~SpacesSettingsHandler() = default;
+
+void SpacesSettingsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesGetState",
+      base::BindRepeating(&SpacesSettingsHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesCreate",
+      base::BindRepeating(&SpacesSettingsHandler::HandleCreateSpace,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesUpdate",
+      base::BindRepeating(&SpacesSettingsHandler::HandleUpdateSpace,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesMove",
+      base::BindRepeating(&SpacesSettingsHandler::HandleMoveSpace,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesDelete",
+      base::BindRepeating(&SpacesSettingsHandler::HandleDeleteSpace,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesGetTabCount",
+      base::BindRepeating(&SpacesSettingsHandler::HandleGetTabCount,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSpacesSetPref",
+      base::BindRepeating(&SpacesSettingsHandler::HandleSetPref,
+                          base::Unretained(this)));
+}
+
+void SpacesSettingsHandler::OnJavascriptAllowed() {
+  if (service_) {
+    observation_.Observe(service_);
+  }
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  for (const char* pref : {kShowSwitcherRowPref, kSwipeToSwitchPref}) {
+    pref_change_registrar_.Add(
+        pref, base::BindRepeating(&SpacesSettingsHandler::SendState,
+                                  base::Unretained(this)));
+  }
+}
+
+void SpacesSettingsHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+  pref_change_registrar_.RemoveAll();
+}
+
+void SpacesSettingsHandler::OnSpacesChanged() {
+  SendState();
+}
+
+void SpacesSettingsHandler::SendState() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("neon-spaces-changed", GetState());
+  }
+}
+
+base::DictValue SpacesSettingsHandler::GetState() const {
+  base::ListValue spaces;
+  if (service_) {
+    for (const Space& space : service_->spaces()) {
+      spaces.Append(
+          base::DictValue()
+              .Set("id", space.id)
+              .Set("name", space.name)
+              .Set("icon", space.icon)
+              .Set("color", ColorToValue(space.color))
+              .Set("isDefault", space.is_default())
+              .Set("tabs", CountTabsInSpace(profile_, space.id)));
+    }
+  }
+  base::ListValue colors;
+  for (SkColor color : GetSpaceColors()) {
+    colors.Append(ColorToValue(color));
+  }
+  base::ListValue icons;
+  base::DictValue icon_urls;
+  for (std::string_view name : GetSpaceVectorIconNames()) {
+    const std::string icon = base::StrCat({kVectorIconPrefix, name});
+    if (const gfx::VectorIcon* vector = GetSpaceVectorIcon(icon)) {
+      icon_urls.Set(icon, GetIconDataUrl(*vector));
+    }
+    icons.Append(icon);
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  return base::DictValue()
+      .Set("available",
+           service_ != nullptr && containers_api::IsAvailable(profile_))
+      .Set("spaces", std::move(spaces))
+      .Set("colors", std::move(colors))
+      .Set("vectorIcons", std::move(icons))
+      .Set("vectorIconUrls", std::move(icon_urls))
+      .Set("showSwitcherRow", prefs->GetBoolean(kShowSwitcherRowPref))
+      .Set("swipeToSwitch", prefs->GetBoolean(kSwipeToSwitchPref));
+}
+
+void SpacesSettingsHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], GetState());
+}
+
+void SpacesSettingsHandler::HandleCreateSpace(const base::ListValue& args) {
+  AllowJavascript();
+  std::optional<std::string> id = CreateSpace(profile_);
+  ResolveJavascriptCallback(args[0], base::Value(id.value_or(std::string())));
+}
+
+void SpacesSettingsHandler::HandleUpdateSpace(const base::ListValue& args) {
+  // [id, name, icon, color]
+  if (!service_ || args.size() != 4 || !args[0].is_string() ||
+      !args[1].is_string() || !args[2].is_string()) {
+    return;
+  }
+  std::optional<SkColor> color = ColorFromValue(args[3]);
+  if (!color) {
+    return;
+  }
+  service_->UpdateSpace(args[0].GetString(), args[1].GetString(),
+                        args[2].GetString(), *color);
+}
+
+void SpacesSettingsHandler::HandleMoveSpace(const base::ListValue& args) {
+  // [id, index]
+  if (!service_ || args.size() != 2 || !args[0].is_string() ||
+      !args[1].is_int() || args[1].GetInt() < 0) {
+    return;
+  }
+  service_->MoveSpace(args[0].GetString(),
+                      static_cast<size_t>(args[1].GetInt()));
+}
+
+void SpacesSettingsHandler::HandleDeleteSpace(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_string()) {
+    return;
+  }
+  DeleteSpace(profile_, args[0].GetString());
+}
+
+void SpacesSettingsHandler::HandleGetTabCount(const base::ListValue& args) {
+  AllowJavascript();
+  // [callback id, space id]
+  const int count = args.size() == 2 && args[1].is_string()
+                        ? CountTabsInSpace(profile_, args[1].GetString())
+                        : 0;
+  ResolveJavascriptCallback(args[0], base::Value(count));
+}
+
+void SpacesSettingsHandler::HandleSetPref(const base::ListValue& args) {
+  // [name, value], for the two toggles only.
+  if (args.size() != 2 || !args[0].is_string() || !args[1].is_bool()) {
+    return;
+  }
+  const std::string& name = args[0].GetString();
+  if (name == "showSwitcherRow") {
+    profile_->GetPrefs()->SetBoolean(kShowSwitcherRowPref, args[1].GetBool());
+  } else if (name == "swipeToSwitch") {
+    profile_->GetPrefs()->SetBoolean(kSwipeToSwitchPref, args[1].GetBool());
+  }
+}
+
+}  // namespace neon::spaces
