+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Appearance > Spaces: the list of spaces (name, icon, colour, order,
+// delete), a button to add one, and the sidebar's two space toggles. Stays in
+// sync with changes made anywhere else (the sidebar, another settings tab).
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../settings_page/settings_subpage.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import type {NeonSpace, NeonSpacesBrowserProxy, NeonSpacesState} from './neon_spaces_browser_proxy.js';
+import {NeonSpacesBrowserProxyImpl} from './neon_spaces_browser_proxy.js';
+import {getCss} from './neon_spaces_page.css.js';
+import {getHtml} from './neon_spaces_page.html.js';
+
+// Labels of the vector icons and colours, by value. Keep in sync with
+// chrome/browser/neon/spaces/space_style.cc.
+const ICON_LABELS: Record<string, string> = {
+  'vector:home': 'Home',
+  'vector:work': 'Work',
+  'vector:code': 'Code',
+  'vector:science': 'Science',
+  'vector:shopping': 'Shopping',
+  'vector:travel': 'Travel',
+  'vector:games': 'Games',
+  'vector:pets': 'Pets',
+  'vector:star': 'Star',
+  'vector:music': 'Music',
+};
+const COLOR_LABELS = [
+  'Blue', 'Red', 'Yellow', 'Green', 'Pink', 'Purple', 'Cyan', 'Orange', 'Grey',
+];
+const EMOJI_OPTION = 'emoji';
+
+export interface SettingsNeonSpacesPageElement {
+  $: {
+    deleteDialog: CrDialogElement,
+    showSwitcherRow: CrToggleElement,
+    swipeToSwitch: CrToggleElement,
+  };
+}
+
+const SettingsNeonSpacesPageElementBase =
+    SettingsViewMixinLit(WebUiListenerMixinLit(CrLitElement));
+
+export class SettingsNeonSpacesPageElement extends
+    SettingsNeonSpacesPageElementBase {
+  static get is() {
+    return 'settings-neon-spaces-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state_: {type: Object},
+      deleting_: {type: Object},
+      deletingTabs_: {type: Number},
+      emojiRows_: {type: Object},
+    };
+  }
+
+  protected accessor state_: NeonSpacesState|null = null;
+  // The space the delete dialog asks about.
+  protected accessor deleting_: NeonSpace|null = null;
+  protected accessor deletingTabs_: number = 0;
+  // Spaces whose icon menu is on "Emoji" while the emoji field is empty.
+  protected accessor emojiRows_: Set<string> = new Set();
+
+  private browserProxy_: NeonSpacesBrowserProxy =
+      NeonSpacesBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'neon-spaces-changed',
+        (state: NeonSpacesState) => this.onStateChanged_(state));
+    this.browserProxy_.getState().then(state => this.onStateChanged_(state));
+  }
+
+  private onStateChanged_(state: NeonSpacesState) {
+    this.state_ = state;
+    if (this.deleting_ &&
+        !state.spaces.some(space => space.id === this.deleting_!.id)) {
+      // Deleted elsewhere while the dialog was open.
+      this.$.deleteDialog.close();
+    }
+  }
+
+  // SettingsViewMixin
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+
+  protected getSpaces_(): NeonSpace[] {
+    return this.state_?.spaces || [];
+  }
+
+  protected getVectorIcons_(): string[] {
+    return this.state_?.vectorIcons || [];
+  }
+
+  protected getColors_(): number[] {
+    return [0, ...(this.state_?.colors || [])];
+  }
+
+  protected iconLabel_(icon: string): string {
+    return ICON_LABELS[icon] || icon;
+  }
+
+  protected colorLabel_(color: number): string {
+    const index = (this.state_?.colors || []).indexOf(color);
+    return index < 0 ? 'No colour' : COLOR_LABELS[index] || 'Colour';
+  }
+
+  protected isVectorIcon_(icon: string): boolean {
+    return icon.startsWith('vector:');
+  }
+
+  protected isEmoji_(space: NeonSpace): boolean {
+    return (space.icon !== '' && !this.isVectorIcon_(space.icon)) ||
+        this.emojiRows_.has(space.id);
+  }
+
+  protected iconOption_(space: NeonSpace): string {
+    return this.isEmoji_(space) ? EMOJI_OPTION : space.icon;
+  }
+
+  // What the chip shows: the emoji, or the name's first letter.
+  protected glyph_(space: NeonSpace): string {
+    if (space.icon && !this.isVectorIcon_(space.icon)) {
+      return space.icon;
+    }
+    if (this.isVectorIcon_(space.icon)) {
+      return '';
+    }
+    return Array.from(space.name)[0]?.toUpperCase() || '';
+  }
+
+  protected cssColor_(color: number): string {
+    const r = (color >>> 16) & 0xff;
+    const g = (color >>> 8) & 0xff;
+    const b = color & 0xff;
+    return `rgb(${r}, ${g}, ${b})`;
+  }
+
+  // The glyph colour that reads on |color|, as the sidebar picks it.
+  protected chipStyle_(space: NeonSpace): string {
+    if (!(space.color >>> 24)) {
+      return '';
+    }
+    const r = (space.color >>> 16) & 0xff;
+    const g = (space.color >>> 8) & 0xff;
+    const b = space.color & 0xff;
+    const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
+    const text = luminance > 0.55 ? '#202124' : '#ffffff';
+    return `background-color: ${this.cssColor_(space.color)}; ` +
+        `border-color: transparent; color: ${text};`;
+  }
+
+  protected vectorIconStyle_(icon: string): string {
+    const url = this.state_?.vectorIconUrls[icon];
+    return url ? `-webkit-mask-image: url("${url}");` : '';
+  }
+
+  protected tabsText_(space: NeonSpace): string {
+    return space.tabs === 1 ? '1 tab' : `${space.tabs} tabs`;
+  }
+
+  private spaceOf_(e: Event): NeonSpace|undefined {
+    const row = (e.target as HTMLElement).closest<HTMLElement>('.space-row');
+    return this.getSpaces_().find(space => space.id === row?.dataset['id']);
+  }
+
+  private update_(space: NeonSpace, changes: Partial<NeonSpace>) {
+    const next = {...space, ...changes};
+    this.browserProxy_.updateSpace(next.id, next.name, next.icon, next.color);
+  }
+
+  protected onNameChange_(e: Event) {
+    const space = this.spaceOf_(e);
+    const input = e.target as CrInputElement;
+    if (!space) {
+      return;
+    }
+    if (input.value.trim() === '') {
+      // A space always has a name.
+      input.value = space.name;
+      return;
+    }
+    this.update_(space, {name: input.value});
+  }
+
+  protected onIconChange_(e: Event) {
+    const space = this.spaceOf_(e);
+    const value = (e.target as HTMLSelectElement).value;
+    if (!space) {
+      return;
+    }
+    const emojiRows = new Set(this.emojiRows_);
+    if (value === EMOJI_OPTION) {
+      emojiRows.add(space.id);
+      this.emojiRows_ = emojiRows;
+      return;
+    }
+    emojiRows.delete(space.id);
+    this.emojiRows_ = emojiRows;
+    this.update_(space, {icon: value});
+  }
+
+  protected onEmojiChange_(e: Event) {
+    const space = this.spaceOf_(e);
+    const value = (e.target as CrInputElement).value.trim();
+    if (!space || value === '') {
+      return;
+    }
+    this.update_(space, {icon: value});
+  }
+
+  protected onColorClick_(e: Event) {
+    const space = this.spaceOf_(e);
+    const button = (e.target as HTMLElement).closest<HTMLElement>('.swatch');
+    if (!space || !button) {
+      return;
+    }
+    this.update_(space, {color: Number(button.dataset['color'])});
+  }
+
+  protected onMoveClick_(e: Event) {
+    const space = this.spaceOf_(e);
+    if (!space) {
+      return;
+    }
+    const delta =
+        (e.target as HTMLElement).classList.contains('move-up') ? -1 : 1;
+    const index = this.getSpaces_().indexOf(space) + delta;
+    // The default space stays first.
+    if (index < 1 || index >= this.getSpaces_().length) {
+      return;
+    }
+    this.browserProxy_.moveSpace(space.id, index);
+  }
+
+  protected async onDeleteClick_(e: Event) {
+    const space = this.spaceOf_(e);
+    if (!space || space.isDefault) {
+      return;
+    }
+    this.deletingTabs_ = await this.browserProxy_.getTabCount(space.id);
+    this.deleting_ = space;
+    this.$.deleteDialog.showModal();
+  }
+
+  protected deleteText_(): string {
+    const tabs = this.deletingTabs_;
+    const close = tabs === 0 ? 'No tabs are open in this space.' :
+        tabs === 1           ? 'Its 1 open tab will close.' :
+                               `Its ${tabs} open tabs will close.`;
+    return `${close} Its cookies and site data will be deleted. ` +
+        'This can\'t be undone.';
+  }
+
+  protected onDeleteConfirmClick_() {
+    if (this.deleting_) {
+      this.browserProxy_.deleteSpace(this.deleting_.id);
+    }
+    this.$.deleteDialog.close();
+  }
+
+  protected onDeleteCancelClick_() {
+    this.$.deleteDialog.cancel();
+  }
+
+  protected onDeleteDialogClose_() {
+    this.deleting_ = null;
+  }
+
+  protected onAddClick_() {
+    this.browserProxy_.createSpace();
+  }
+
+  protected onToggleChange_(e: Event) {
+    const toggle = e.target as CrToggleElement;
+    this.browserProxy_.setPref(
+        toggle.id as 'showSwitcherRow' | 'swipeToSwitch', toggle.checked);
+  }
+}
