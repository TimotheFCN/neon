+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsNeonSpacesPageElement} from './neon_spaces_page.js';
+
+export function getHtml(this: SettingsNeonSpacesPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-subpage page-title="Spaces" route-path="${this.routePath}">
+  <div class="cr-row first">
+    <div class="flex cr-padded-text" aria-hidden="true">
+      Show the space switcher row
+      <div class="cr-secondary-text">
+        The row of space icons at the bottom of the vertical tabs
+      </div>
+    </div>
+    <cr-toggle id="showSwitcherRow" aria-label="Show the space switcher row"
+        ?checked="${this.state_?.showSwitcherRow ?? true}"
+        @change="${this.onToggleChange_}">
+    </cr-toggle>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text" aria-hidden="true">
+      Swipe to switch spaces
+      <div class="cr-secondary-text">
+        A two-finger swipe or a sideways scroll over the vertical tabs
+      </div>
+    </div>
+    <cr-toggle id="swipeToSwitch" aria-label="Swipe to switch spaces"
+        ?checked="${this.state_?.swipeToSwitch ?? true}"
+        @change="${this.onToggleChange_}">
+    </cr-toggle>
+  </div>
+  <div class="cr-row continuation">
+    <h2 class="flex">Your spaces</h2>
+  </div>
+  <div id="spaceList">
+    ${this.getSpaces_().map((space, index) => html`
+      <div class="space-row" data-id="${space.id}"
+          data-icon="${space.icon}" data-color="${space.color}"
+          data-tabs="${space.tabs}">
+        <div class="space-line">
+          <span class="space-chip" style="${this.chipStyle_(space)}"
+              aria-hidden="true">
+            ${this.isVectorIcon_(space.icon) ? html`
+              <span class="vector-glyph"
+                  style="${this.vectorIconStyle_(space.icon)}"></span>
+            ` : html`${this.glyph_(space)}`}
+          </span>
+          <cr-input class="space-name" .value="${space.name}"
+              aria-label="Name of ${space.name}" maxlength="60"
+              @change="${this.onNameChange_}">
+          </cr-input>
+          <span class="space-tabs cr-secondary-text">
+            ${this.tabsText_(space)}
+          </span>
+          <cr-icon-button class="move-up" iron-icon="cr:keyboard-arrow-up"
+              title="Move up" aria-label="Move ${space.name} up"
+              ?disabled="${space.isDefault || index <= 1}"
+              @click="${this.onMoveClick_}">
+          </cr-icon-button>
+          <cr-icon-button class="move-down" iron-icon="cr:keyboard-arrow-down"
+              title="Move down" aria-label="Move ${space.name} down"
+              ?disabled="${space.isDefault || index === this.getSpaces_().length - 1}"
+              @click="${this.onMoveClick_}">
+          </cr-icon-button>
+          <cr-icon-button class="delete" iron-icon="cr:delete"
+              title="${space.isDefault ? 'The default space cannot be deleted' :
+                                         'Delete space'}"
+              aria-label="Delete ${space.name}"
+              ?disabled="${space.isDefault}"
+              @click="${this.onDeleteClick_}">
+          </cr-icon-button>
+        </div>
+        <div class="space-line space-options">
+          <select class="md-select space-icon" aria-label="Icon of ${space.name}"
+              @change="${this.onIconChange_}">
+            <option value="" ?selected="${this.iconOption_(space) === ''}">
+              First letter
+            </option>
+            ${this.getVectorIcons_().map(icon => html`
+              <option value="${icon}"
+                  ?selected="${this.iconOption_(space) === icon}">
+                ${this.iconLabel_(icon)}
+              </option>
+            `)}
+            <option value="emoji"
+                ?selected="${this.iconOption_(space) === 'emoji'}">
+              Emoji
+            </option>
+          </select>
+          <cr-input class="space-emoji" placeholder="Emoji"
+              aria-label="Emoji of ${space.name}"
+              .value="${this.isVectorIcon_(space.icon) ? '' : space.icon}"
+              ?hidden="${!this.isEmoji_(space)}"
+              @change="${this.onEmojiChange_}">
+          </cr-input>
+          <div class="swatches" role="group" aria-label="Colour of ${space.name}">
+            ${this.getColors_().map(color => html`
+              <button class="swatch ${color ? '' : 'none'}"
+                  data-color="${color}" title="${this.colorLabel_(color)}"
+                  aria-label="${this.colorLabel_(color)}"
+                  aria-pressed="${color === space.color}"
+                  style="${color ? `background-color: ${this.cssColor_(color)}` : ''}"
+                  @click="${this.onColorClick_}">
+              </button>
+            `)}
+          </div>
+        </div>
+      </div>
+    `)}
+  </div>
+  <div class="cr-row">
+    <cr-button id="addSpace" @click="${this.onAddClick_}"
+        ?disabled="${!this.state_?.available}">
+      Add space
+    </cr-button>
+  </div>
+</settings-subpage>
+<cr-dialog id="deleteDialog" @close="${this.onDeleteDialogClose_}">
+  <div slot="title">Delete “${this.deleting_?.name || ''}”?</div>
+  <div slot="body">${this.deleteText_()}</div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onDeleteCancelClick_}">
+      Cancel
+    </cr-button>
+    <cr-button id="confirmDelete" class="action-button"
+        @click="${this.onDeleteConfirmClick_}">
+      Delete
+    </cr-button>
+  </div>
+</cr-dialog>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
