+#ifndef CHROME_BROWSER_UI_NEON_SPACES_SPACES_SETTINGS_HANDLER_H_
+#define CHROME_BROWSER_UI_NEON_SPACES_SPACES_SETTINGS_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/neon/spaces/spaces_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class Profile;
+
+namespace neon::spaces {
+
+// Backs the Spaces page of chrome://settings (Appearance > Spaces): lists the
+// spaces and creates, edits, moves and deletes them, and reads and sets the
+// two sidebar toggles. Sends "neon-spaces-changed" with the whole state
+// whenever the space list or a toggle changes, from any window.
+class SpacesSettingsHandler : public content::WebUIMessageHandler,
+                              public SpacesService::Observer {
+ public:
+  explicit SpacesSettingsHandler(Profile* profile);
+  SpacesSettingsHandler(const SpacesSettingsHandler&) = delete;
+  SpacesSettingsHandler& operator=(const SpacesSettingsHandler&) = delete;
+  ~SpacesSettingsHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // SpacesService::Observer:
+  void OnSpacesChanged() override;
+
+ private:
+  base::DictValue GetState() const;
+  void SendState();
+
+  void HandleGetState(const base::ListValue& args);
+  void HandleCreateSpace(const base::ListValue& args);
+  void HandleUpdateSpace(const base::ListValue& args);
+  void HandleMoveSpace(const base::ListValue& args);
+  void HandleDeleteSpace(const base::ListValue& args);
+  void HandleGetTabCount(const base::ListValue& args);
+  void HandleSetPref(const base::ListValue& args);
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<SpacesService> service_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::ScopedObservation<SpacesService, SpacesService::Observer>
+      observation_{this};
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_NEON_SPACES_SPACES_SETTINGS_HANDLER_H_
