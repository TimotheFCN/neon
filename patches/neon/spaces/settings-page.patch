+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+// One space, as chrome/browser/ui/neon/spaces/spaces_settings_handler.cc
+// sends it. |color| is an unsigned ARGB number, 0 for no colour. |icon| is
+// empty (first letter), an emoji, or 'vector:<name>'.
+export interface NeonSpace {
+  id: string;
+  name: string;
+  icon: string;
+  color: number;
+  isDefault: boolean;
+  tabs: number;
+}
+
+export interface NeonSpacesState {
+  available: boolean;
+  spaces: NeonSpace[];
+  colors: number[];
+  vectorIcons: string[];
+  // Black vector icons as PNG data URLs, by icon value, used as masks.
+  vectorIconUrls: Record<string, string>;
+  showSwitcherRow: boolean;
+  swipeToSwitch: boolean;
+}
+
+export interface NeonSpacesBrowserProxy {
+  getState(): Promise<NeonSpacesState>;
+  createSpace(): Promise<string>;
+  updateSpace(id: string, name: string, icon: string, color: number): void;
+  moveSpace(id: string, index: number): void;
+  deleteSpace(id: string): void;
+  getTabCount(id: string): Promise<number>;
+  setPref(name: 'showSwitcherRow'|'swipeToSwitch', value: boolean): void;
+}
+
+export class NeonSpacesBrowserProxyImpl implements NeonSpacesBrowserProxy {
+  getState(): Promise<NeonSpacesState> {
+    return sendWithPromise('neonSpacesGetState');
+  }
+
+  createSpace(): Promise<string> {
+    return sendWithPromise('neonSpacesCreate');
+  }
+
+  updateSpace(id: string, name: string, icon: string, color: number) {
+    chrome.send('neonSpacesUpdate', [id, name, icon, color]);
+  }
+
+  moveSpace(id: string, index: number) {
+    chrome.send('neonSpacesMove', [id, index]);
+  }
+
+  deleteSpace(id: string) {
+    chrome.send('neonSpacesDelete', [id]);
+  }
+
+  getTabCount(id: string): Promise<number> {
+    return sendWithPromise('neonSpacesGetTabCount', id);
+  }
+
+  setPref(name: 'showSwitcherRow'|'swipeToSwitch', value: boolean) {
+    chrome.send('neonSpacesSetPref', [name, value]);
+  }
+
+  static getInstance(): NeonSpacesBrowserProxy {
+    return instance || (instance = new NeonSpacesBrowserProxyImpl());
+  }
+
+  static setInstance(obj: NeonSpacesBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: NeonSpacesBrowserProxy|null = null;
