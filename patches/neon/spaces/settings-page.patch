+const SettingsNeonSpacesEntryElementBase = SettingsViewMixinLit(CrLitElement);
+
+export class SettingsNeonSpacesEntryElement extends
+    SettingsNeonSpacesEntryElementBase {
+  static get is() {
+    return 'settings-neon-spaces-entry';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  protected onClick_() {
+    Router.getInstance().navigateTo(routes.SPACES);
+  }
+
+  // SettingsViewMixin
+  override getFocusConfig() {
+    const map = new Map();
