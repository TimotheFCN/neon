+bool SpacesPagerView::IsActive() const {
+  return model_ && controller_ && controller_->IsActive();
+}
+
+std::string SpacesPagerView::GetVisibleSpaceId() const {
+  return model_ && controller_ ? controller_->GetVisibleSpaceId()
+                               : std::string();
+}
+
+int SpacesPagerView::GetSpaceIndex(const std::string& space_id) const {
+  if (!controller_) {
+    return -1;
+  }
+  std::optional<size_t> index = controller_->service()->GetSpaceIndex(space_id);
+  return index ? static_cast<int>(*index) : -1;
+}
+
+const Space* SpacesPagerView::GetSpace(const std::string& space_id) const {
