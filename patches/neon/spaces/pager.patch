+// A full page turn takes as long as the tab strip's own layout animations.
+constexpr base::TimeDelta kPageTurnDuration = base::Milliseconds(200);
+// A settle shorter than a page is quicker, but not below this share.
+constexpr double kMinDurationShare = 0.4;
+// Releasing past this share of a page turns it.
+constexpr double kTurnThreshold = 1.0 / 3.0;
+// Releasing faster than this (DIPs per second) turns the page in that
+// direction whatever the distance.
+constexpr double kFlingVelocity = 500;
+// The pager's share of the region's extra height against the views below.
+constexpr int kFlexWeight = 10000;
+// Throbbers of peek pages advance at this rate while they show.
+constexpr base::TimeDelta kLoadingAnimationInterval = base::Milliseconds(30);
+
+// How far the pages follow the fingers past the first or last space: |over|
+// pages of finger travel give this many pages of movement.
+double RubberBand(double over) {
+  return 1.0 - 1.0 / (over * 0.55 + 1.0);
+}
+
+void ReportSmoothness(const cc::FrameSequenceMetrics::CustomReportData& data) {
+  if (!data.frames_expected_v3) {
+    return;
+  }
+  base::UmaHistogramCounts1000("Neon.Spaces.Pager.FramesExpected",
+                               data.frames_expected_v3);
+  base::UmaHistogramCounts1000("Neon.Spaces.Pager.FramesDropped",
+                               data.frames_dropped_v3);
+  base::UmaHistogramPercentage(
+      "Neon.Spaces.Pager.Smoothness",
+      100 - static_cast<int>(100.0 * data.frames_dropped_v3 /
+                             data.frames_expected_v3));
+  base::UmaHistogramCounts1000("Neon.Spaces.Pager.Janks", data.jank_count_v3);
+}
+
+}  // namespace
+
+SpacesPagerView::SpacesPagerView(TabStripRegionView& region,
+                                 BrowserView* browser_view,
+                                 std::unique_ptr<views::View> tab_strip_view)
+    : AnimationDelegateViews(this),
+      region_(region),
+      browser_view_(browser_view),
+      model_(browser_view->browser()->GetTabStripModel()) {
+  // Pages move by transform inside the pager's bounds.
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetMasksToBounds(true);
+
+  real_page_ = AddChildView(
+      std::make_unique<SpacePageView>(std::move(tab_strip_view)));
+
+  loading_animation_start_ = base::TimeTicks::Now();
+  model_->AddObserver(this);
+  if (auto* state_controller = tabs::VerticalTabStripStateController::From(
+          browser_view_->browser())) {
+    collapse_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            [](SpacesPagerView* pager, tabs::VerticalTabStripCollapseState) {
+              pager->OnCollapseStateChanged();
+            },
+            base::Unretained(this)));
+  }
+
+  if (SpacesWindowController* controller =
+          SpacesWindowController::FromBrowser(browser_view_->browser())) {
+    BindController(controller);
+  } else {
+    controller_created_subscription_ =
+        SpacesWindowController::RegisterCreatedCallback(base::BindRepeating(
+            [](SpacesPagerView* pager, SpacesWindowController* controller) {
+              if (controller->browser() == pager->browser_view_->browser()) {
+                pager->BindController(controller);
+              }
+            },
+            base::Unretained(this)));
+  }
+}
+
+SpacesPagerView::~SpacesPagerView() {
+  // The row observes the pager: remove it while the pager is whole.
+  SetBottomView(nullptr);
+  animation_.Stop();
+  loading_timer_.Stop();
+  UnbindController();
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+  DestroyPeeks();
+}
+
+void SpacesPagerView::BindController(SpacesWindowController* controller) {
+  controller_created_subscription_ = {};
+  controller_ = controller;
+  controller_->SetPresenter(this);
+  spaces_observation_.Observe(controller_->service());
+  expected_visible_space_ = GetVisibleSpaceId();
+  strip_ = {expected_visible_space_};
+  UpdateActiveState();
+}
+
+void SpacesPagerView::UnbindController() {
+  if (!controller_) {
+    return;
+  }
+  animation_.Stop();
+  spaces_observation_.Reset();
+  if (controller_->presenter() == this) {
+    controller_->SetPresenter(nullptr);
+  }
+  controller_ = nullptr;
+}
+
+void SpacesPagerView::OnControllerDestroying() {
+  UnbindController();
+  UpdateActiveState();
+}
