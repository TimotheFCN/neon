+  SpacesPagerView(const SpacesPagerView&) = delete;
+  SpacesPagerView& operator=(const SpacesPagerView&) = delete;
+  ~SpacesPagerView() override;
+
+  // The pager that holds |tab_strip_view|, if any.
+  static SpacesPagerView* FromTabStripView(views::View* tab_strip_view);
