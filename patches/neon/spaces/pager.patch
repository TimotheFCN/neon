+
+constexpr int kHeaderHeight = 28;
+constexpr int kHeaderIconSize = 16;
+// The header icon sits where the tabs' favicons are.
+constexpr int kTabFaviconInset = 7;
+
+}  // namespace
+
+SpacePageView::SpacePageView(std::unique_ptr<views::View> tab_strip_view) {
+  Init();
+  AddTabStripView(std::move(tab_strip_view));
+}
+
+SpacePageView::SpacePageView(TabStripModel* model,
+                             BrowserView* browser_view,
+                             TabStripRegionView& region)
+    : model_(model) {
+  Init();
+  // A second view of the model, built the way
+  // BaseTabStripRegionView::InitializeTabStrip() builds the window's, but
+  // observing the model like any observer and without hover cards.
+  root_ = std::make_unique<RootTabCollectionNode>(
+      model,
+      base::BindRepeating(&SpacePageView::AddTabStripView,
+                          base::Unretained(this)),
+      base::BindRepeating(&SpacePageView::RemoveTabStripView,
+                          base::Unretained(this)),
+      TabStripOrientation::kVertical);
+  drag_handler_ = std::make_unique<TabDragHandler>(*model, *root_, region);
+  controller_ = std::make_unique<TabStripCollectionController>(
+      model, browser_view, *root_, *drag_handler_,
+      /*hover_card_controller=*/nullptr, TabStripOrientation::kVertical);
+  root_->SetController(controller_.get());
+  // Shows nothing until it is given a space.
+  SetPageSpace(controller_.get(), std::string(), tabs::TabHandle());
+  root_->Init(/*register_as_tab_strip_ui=*/false);
+
+  // A peek page is a picture of a space: it takes no input and is left out of
+  // the accessibility tree (the window's tab strip is the one users act on).
+  SetCanProcessEventsWithinSubtree(false);
+  GetViewAccessibility().SetIsLeaf(true);
+  GetViewAccessibility().SetIsIgnored(true);
+}
+
+SpacePageView::~SpacePageView() {
+  if (root_) {
+    ClearPageSpace(controller_.get());
+    root_->Reset();
+    root_->SetController(nullptr);
+    controller_.reset();
+    drag_handler_.reset();
+    root_.reset();
+  }
+}
+
+void SpacePageView::Init() {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+
+  auto header = std::make_unique<views::View>();
+  auto* layout = header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::TLBR(0,
+                        GetLayoutConstant(
+                            LayoutConstant::kVerticalTabStripHorizontalPadding) +
+                            kTabFaviconInset,
+                        0, kTabFaviconInset),
+      /*between_child_spacing=*/8));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  header_icon_ =
+      header->AddChildView(std::make_unique<SpaceIconView>(kHeaderIconSize));
+  auto label = std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY);
+  label->SetHorizontalAlignment(gfx::ALIGN_TO_HEAD);
+  label->SetFontList(
+      label->font_list().DeriveWithWeight(gfx::Font::Weight::MEDIUM));
+  label->SetElideBehavior(gfx::ELIDE_TAIL);
+  // Drawn on the page's transparent layer.
+  label->SetSubpixelRenderingEnabled(false);
+  header_label_ = header->AddChildView(std::move(label));
+  layout->SetFlexForView(header_label_, 1);
+  header->SetVisible(false);
+  header_ = AddChildView(std::move(header));
+}
+
+views::View* SpacePageView::AddTabStripView(std::unique_ptr<views::View> view) {
+  tab_strip_ = views::AsViewClass<TabStripView>(view.get());
+  CHECK(tab_strip_);
+  return AddChildView(std::move(view));
+}
+
+void SpacePageView::RemoveTabStripView(views::View* view) {
+  CHECK_EQ(view, tab_strip_.get());
+  tab_strip_ = nullptr;
+  RemoveChildViewT(view);
+}
+
+std::unique_ptr<views::View> SpacePageView::TakeTabStripView() {
+  CHECK(!is_peek());
+  views::View* view = std::exchange(tab_strip_, nullptr);
+  return view ? RemoveChildViewT(view) : nullptr;
+}
+
+void SpacePageView::ShowSpace(const std::string& space_id,
+                              tabs::TabInterface* active_tab) {
+  CHECK(is_peek());
+  const tabs::TabHandle new_active =
+      active_tab ? active_tab->GetHandle() : tabs::TabHandle();
+  if (space_id == space_id_ && new_active == active_tab_) {
+    return;
+  }
+  tabs::TabInterface* old_active = active_tab_.Get();
+  const bool space_changed = space_id != space_id_;
+  space_id_ = space_id;
+  active_tab_ = new_active;
+  SetPageSpace(controller_.get(), space_id_, active_tab_);
+  // Tabs work out whether they are active when their selection changes.
+  for (tabs::TabInterface* tab : {old_active, active_tab}) {
+    if (!tab || model_->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    if (TabCollectionNode* node = root_->GetNodeForHandle(tab->GetHandle())) {
+      node->NotifyTabSelectionChanged();
+    }
+  }
+  if (space_changed) {
+    InvalidateTabLayout();
+  }
+}
+
+void SpacePageView::ClearSpace() {
+  if (space_id_.empty()) {
+    return;
+  }
+  ShowSpace(std::string(), nullptr);
+}
+
+void SpacePageView::SetHeader(const Space* space, bool show) {
+  if (space) {
+    header_icon_->SetSpace(*space);
+    header_label_->SetText(base::UTF8ToUTF16(space->name));
+  }
+  if (header_->GetVisible() != (show && space)) {
+    header_->SetVisible(show && space);
+    InvalidateLayout();
+  }
+}
+
+void SpacePageView::SetCollapsed(bool collapsed) {
+  if (tab_strip_) {
+    tab_strip_->SetCollapsedState(collapsed);
+  }
+}
+
+int SpacePageView::GetScroll() const {
+  if (!tab_strip_ || !tab_strip_->unpinned_tabs_scroll_view()) {
+    return 0;
+  }
+  return tab_strip_->unpinned_tabs_scroll_view()->GetVisibleRect().y();
+}
+
+void SpacePageView::ApplyScroll(std::optional<int> offset,
+                                const tabs::TabInterface* tab) {
+  if (!tab_strip_) {
+    return;
+  }
+  views::ScrollView* scroll_view = tab_strip_->unpinned_tabs_scroll_view();
+  if (scroll_view && scroll_view->contents()) {
+    const int max_offset = std::max(
+        0, scroll_view->contents()->height() -
+               scroll_view->GetVisibleRect().height());
+    scroll_view->ScrollToOffset(
+        gfx::PointF(0, std::clamp(offset.value_or(0), 0, max_offset)));
+  }
+  if (offset) {
+    // The tab strip scrolls a newly active tab into view after its next
+    // layout; the space comes back where it was left instead.
+    for (views::ScrollView* view : {scroll_view,
+                                    tab_strip_->pinned_tabs_scroll_view()}) {
+      if (view) {
+        view->RegisterPostLayoutCallback(base::DoNothing());
+      }
+    }
+  } else if (tab) {
+    tab_strip_->ScrollToFitTabs(tab, nullptr);
+  }
+  if (scroll_view) {
+    scroll_view->InvalidateLayout();
+  }
+  if (tab_strip_->pinned_tabs_scroll_view()) {
+    tab_strip_->pinned_tabs_scroll_view()->InvalidateLayout();
+  }
+}
+
+void SpacePageView::StepLoadingAnimations(base::TimeDelta elapsed) {
+  if (!root_) {
+    return;
+  }
+  for (tabs::TabInterface* tab : *model_) {
+    if (TabCollectionNode* node = root_->GetNodeForHandle(tab->GetHandle())) {
+      if (auto* tab_view = views::AsViewClass<TabView>(node->view())) {
+        tab_view->StepLoadingAnimation(elapsed);
+      }
+    }
+  }
+}
+
+void SpacePageView::InvalidateTabLayout() {
+  if (!tab_strip_) {
+    return;
+  }
+  if (views::View* pinned = tab_strip_->GetPinnedTabsContainer()) {
+    pinned->InvalidateLayout();
+  }
+  if (views::View* unpinned = tab_strip_->GetUnpinnedTabsContainer()) {
+    unpinned->InvalidateLayout();
+  }
+  tab_strip_->InvalidateLayout();
+}
+
+bool SpacePageView::SnapTabLayout() {
+  if (!tab_strip_) {
+    return false;
+  }
+  bool snapped = false;
+  std::vector<views::View*> pending = {tab_strip_};
+  while (!pending.empty()) {
+    views::View* view = pending.back();
+    pending.pop_back();
+    for (views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+    // These install a TabCollectionAnimatingLayoutManager as their layout.
+    if (!views::IsViewClass<PinnedTabContainerView>(view) &&
+        !views::IsViewClass<UnpinnedTabContainerView>(view) &&
+        !views::IsViewClass<TabGroupView>(view)) {
+      continue;
+    }
+    auto* manager = static_cast<TabCollectionAnimatingLayoutManager*>(
+        view->GetLayoutManager());
+    if (!manager || !manager->is_animating()) {
+      continue;
+    }
+    std::vector<const views::View*> children(view->children().begin(),
+                                             view->children().end());
+    manager->ResetViewsToTargetLayout(children);
+    snapped = true;
+  }
+  return snapped;
+}
+
+int SpacePageView::GetHeaderHeight() const {
+  return header_->GetVisible() ? kHeaderHeight : 0;
+}
+
+void SpacePageView::Layout(PassKey) {
+  const int header_height = GetHeaderHeight();
+  header_->SetBounds(0, 0, width(), header_height);
+  if (tab_strip_) {
+    tab_strip_->SetBounds(0, header_height, width(),
+                          std::max(0, height() - header_height));
+  }
+}
+
+gfx::Size SpacePageView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  gfx::Size size = tab_strip_ ? tab_strip_->GetPreferredSize(available_size)
+                              : gfx::Size();
+  size.Enlarge(0, GetHeaderHeight());
+  return size;
+}
