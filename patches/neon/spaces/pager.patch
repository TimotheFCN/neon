+namespace neon::spaces {
+
+std::unique_ptr<views::View> WrapTabStripView(
+    TabStripRegionView& region,
+    BrowserView* browser_view,
+    TabStripOrientation orientation,
+    std::unique_ptr<views::View> tab_strip_view) {
+  if (orientation != TabStripOrientation::kVertical || !browser_view) {
+    return tab_strip_view;
+  }
+  // The window's spaces controller is created after its views, so decide
+  // the way SpacesWindowManager does: normal windows of profiles with spaces.
+  BrowserWindowInterface* browser = browser_view->browser();
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !SpacesServiceFactory::GetForProfile(browser->GetProfile())) {
+    return tab_strip_view;
+  }
+  return std::make_unique<SpacesPagerView>(region, browser_view,
+                                           std::move(tab_strip_view));
+}
+
+void UnwrapTabStripView(views::View* tab_strip_view) {
+  SpacesPagerView* pager = SpacesPagerView::FromTabStripView(tab_strip_view);
+  if (!pager || !pager->parent()) {
+    return;
+  }
+  views::View* parent = pager->parent();
+  const size_t index = parent->GetIndexOf(pager).value();
+  std::unique_ptr<views::View> view = pager->TakeTabStripView();
+  // The region set these on the pager; the tab strip view had them before.
+  if (const views::FlexSpecification* flex = pager->GetRegionFlex()) {
+    view->SetProperty(views::kFlexBehaviorKey, *flex);
+  }
+  if (const auto* margins = pager->GetProperty(views::kMarginsKey)) {
+    view->SetProperty(views::kMarginsKey, *margins);
+  }
+  parent->RemoveChildViewT(pager);
+  parent->AddChildViewAt(std::move(view), index);
+}
+
