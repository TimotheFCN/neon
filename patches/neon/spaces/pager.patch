+
+// One page of the sidebar pager: the space's name at the top and a tab strip
+// below. The real page holds the window's own TabStripView, which always shows
+// the visible space. A peek page builds a second, live tab strip on the same
+// tab strip model (its own RootTabCollectionNode and controller, as
+// BaseTabStripRegionView::InitializeTabStrip does) and shows the space it is
+// given; the pager uses it for the neighbouring spaces while pages slide.
+class SpacePageView : public views::View {
+  METADATA_HEADER(SpacePageView, views::View)
+
+ public:
+  // The real page, around the window's tab strip view.
+  explicit SpacePageView(std::unique_ptr<views::View> tab_strip_view);
+  // A peek page: a live tab strip of |model|, input disabled.
+  SpacePageView(TabStripModel* model,
+                BrowserView* browser_view,
+                TabStripRegionView& region);
+  SpacePageView(const SpacePageView&) = delete;
+  SpacePageView& operator=(const SpacePageView&) = delete;
+  ~SpacePageView() override;
+
+  bool is_peek() const { return root_ != nullptr; }
+  TabStripView* tab_strip() const { return tab_strip_; }
+
+  // The real page gives back the window's tab strip view.
+  std::unique_ptr<views::View> TakeTabStripView();
+
+  // Peek pages: shows space |space_id| with |active_tab| drawn as active. The
+  // tab strip lays out again at the next layout; ApplyScroll() then scrolls.
+  void ShowSpace(const std::string& space_id, tabs::TabInterface* active_tab);
+  // Stops showing a space (the page is not in use).
+  void ClearSpace();
+  // The space a peek page shows, or empty.
+  const std::string& space_id() const { return space_id_; }
+  tabs::TabInterface* active_tab() const { return active_tab_.Get(); }
+
+  // Updates the header. Hidden when |show| is false.
+  void SetHeader(const Space* space, bool show);
+
+  // Mirrors the window's tab strip collapse state.
+  void SetCollapsed(bool collapsed);
+
+  // The scroll offset of the unpinned tabs.
+  int GetScroll() const;
+  // Scrolls the unpinned tabs to |offset| exactly, overriding the tab strip's
+  // own scrolling of a newly active tab into view. Without an offset (a space
+  // not shown before), scrolls to the top and then just enough to show |tab|,
+  // the way the tab strip scrolls a newly active tab into view. Takes effect
+  // at the next layout.
+  void ApplyScroll(std::optional<int> offset, const tabs::TabInterface* tab);
+
+  // Advances the throbbers of loading tabs (peek pages; the window steps the
+  // real page).
+  void StepLoadingAnimations(base::TimeDelta elapsed);
+
+  // Invalidates the layout of every container of the tab strip, after the set
+  // of tabs it shows changed.
+  void InvalidateTabLayout();
+
+  // Puts every tab of the tab strip at its place in the current layout at
+  // once. The tab strip animates layout changes that happen while one of its
+  // animations runs (a tab just opened or moved); a change of space must not
+  // animate inside the page while the page itself moves. Returns whether
+  // anything was animating.
+  bool SnapTabLayout();
+
+  // views::View:
+  void Layout(PassKey) override;
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+
+ private:
+  void Init();
+  views::View* AddTabStripView(std::unique_ptr<views::View> view);
+  void RemoveTabStripView(views::View* view);
+  int GetHeaderHeight() const;
+
+  raw_ptr<views::View> header_ = nullptr;
+  raw_ptr<SpaceIconView> header_icon_ = nullptr;
+  raw_ptr<views::Label> header_label_ = nullptr;
+  raw_ptr<TabStripView> tab_strip_ = nullptr;
+
+  // Peek pages only.
+  raw_ptr<TabStripModel> model_ = nullptr;
+  std::unique_ptr<RootTabCollectionNode> root_;
+  std::unique_ptr<TabDragHandler> drag_handler_;
+  std::unique_ptr<TabStripCollectionController> controller_;
+  std::string space_id_;
+  tabs::TabHandle active_tab_;
+};
+
+}  // namespace neon::spaces
