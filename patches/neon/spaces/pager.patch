+
+bool SpacesPagerView::ShouldAnimate() const {
+  // On Linux ShouldRenderRichAnimation() follows the desktop's animation
+  // setting only, so ask for reduced motion too.
+  return gfx::Animation::ShouldRenderRichAnimation() &&
+         !gfx::Animation::PrefersReducedMotion() &&
+         gfx::ScopedAnimationDurationScaleMode::duration_multiplier() > 0 &&
+         GetWidget() && GetWidget()->IsVisible() && width() > 0;
+}
+
+bool SpacesPagerView::PresentSpace(const std::string& space_id) {
+  if (!active_ || GetSpaceIndex(space_id) < 0) {
+    return false;
+  }
+  dragging_ = false;
+  if (!ShouldAnimate()) {
+    // Switches at once, keeping each space's scroll position.
+    animation_.Stop();
+    strip_ = {GetVisibleSpaceId()};
+    position_ = 0;
+    if (GetWidget() && width() > 0) {
+      Commit(space_id);
+    } else {
+      controller_->ActivateSpace(space_id);
+    }
+    SettleAtRest();
+    return true;
+  }
+  if (strip_.size() == 1 && strip_.front() == space_id &&
+      !animation_.is_animating()) {
+    return true;
+  }
+
+  // Keep the spaces on screen where they are and put the target next to
+  // them, on the side of its place in the space order.
+  const int last = static_cast<int>(strip_.size()) - 1;
+  const int first_shown = std::clamp(static_cast<int>(std::floor(position_)),
+                                     0, last);
+  const int last_shown =
+      std::clamp(static_cast<int>(std::ceil(position_)), 0, last);
+  std::vector<std::string> strip(strip_.begin() + first_shown,
+                                 strip_.begin() + last_shown + 1);
+  double position = position_ - first_shown;
+  int target = static_cast<int>(std::ranges::find(strip, space_id) -
+                                strip.begin());
+  if (target == static_cast<int>(strip.size())) {
+    const int nearest = std::clamp(static_cast<int>(std::lround(position)), 0,
+                                   static_cast<int>(strip.size()) - 1);
+    if (GetSpaceIndex(space_id) > GetSpaceIndex(strip[nearest])) {
+      strip.push_back(space_id);
+      target = static_cast<int>(strip.size()) - 1;
+    } else {
+      strip.insert(strip.begin(), space_id);
+      position += 1;
+      target = 0;
+    }
+  }
+  const bool was_moving = animation_.is_animating();
+  animation_.Stop();
+  strip_ = std::move(strip);
+  position_ = position;
+  StartMetrics();
+  Commit(space_id);
+  if (GetVisibleSpaceId() != space_id) {
+    SettleAtRest();
+    return true;
+  }
+  AnimateTo(target, /*ease_in=*/!was_moving);
+  return true;
+}
+
+std::string SpacesPagerView::GetTargetSpaceId() const {
+  if (strip_.size() <= 1 && !dragging_) {
+    return std::string();
+  }
+  // Moves always end on the visible space (see Commit()).
+  return GetVisibleSpaceId();
+}
+
+void SpacesPagerView::Commit(const std::string& space_id) {
+  const std::string visible = GetVisibleSpaceId();
+  if (space_id == visible) {
+    return;
+  }
+  // A scroll the tab strip has pending (a newly active tab scrolled into view
+  // over the next layouts) belongs to where the space is left.
+  if (GetWidget()) {
+    GetWidget()->LayoutRootViewIfNecessary();
+    GetWidget()->LayoutRootViewIfNecessary();
+  }
+  saved_scroll_[visible] = real_page_->GetScroll();
+  SpacePageView* shown = FindPeekShowing(space_id);
+  const std::optional<int> scroll =
+      shown ? std::optional<int>(shown->GetScroll()) : GetSavedScroll(space_id);
+
+  expected_visible_space_ = space_id;
+  controller_->ActivateSpace(space_id);
+  expected_visible_space_ = GetVisibleSpaceId();
+
+  // The real page now shows |space_id| and a peek page takes the slot of the
+  // space that was visible. Lay both out before anything is drawn.
+  UpdateHeaders();
+  AssignPages();
+  if (GetWidget()) {
+    GetWidget()->LayoutRootViewIfNecessary();
+  }
+  real_page_->SnapTabLayout();
+  ScrollPage(real_page_, scroll, model_->GetActiveTab());
+  UpdateTransforms();
+  NotifyPositionChanged();
+}
+
+void SpacesPagerView::ScrollPage(SpacePageView* page,
+                                 std::optional<int> offset,
+                                 const tabs::TabInterface* tab) {
+  // The tab list's height settles over a couple of layouts after the set of
+  // tabs changes; scroll once it holds the offset.
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    if (GetWidget()) {
+      GetWidget()->LayoutRootViewIfNecessary();
+    }
+    page->ApplyScroll(offset, tab);
+    if (GetWidget()) {
+      GetWidget()->LayoutRootViewIfNecessary();
+    }
+    if (!offset || page->GetScroll() == *offset) {
+      return;
+    }
+  }
+}
+
+void SpacesPagerView::AnimateTo(double target, bool ease_in) {
+  animation_start_ = position_;
+  animation_target_ = target;
+  const double distance = std::abs(target - position_);
+  const base::TimeDelta duration =
+      kPageTurnDuration * std::clamp(distance, kMinDurationShare, 1.0);
+  if (distance == 0 || !ShouldAnimate()) {
+    position_ = target;
+    SettleAtRest();
+    return;
+  }
+  animation_.SetSlideDuration(duration);
+  animation_.SetTweenType(ease_in ? gfx::Tween::EASE_IN_OUT
+                                  : gfx::Tween::EASE_OUT);
+  animation_.Reset(0);
+  animation_.Show();
+}
+
+void SpacesPagerView::AnimationProgressed(const gfx::Animation* animation) {
+  position_ = animation_start_ + (animation_target_ - animation_start_) *
+                                     animation_.GetCurrentValue();
+  AssignPages();
+  UpdateTransforms();
+  NotifyPositionChanged();
+}
+
+void SpacesPagerView::AnimationEnded(const gfx::Animation* animation) {
+  position_ = animation_target_;
+  SettleAtRest();
+}
+
+void SpacesPagerView::AnimationCanceled(const gfx::Animation* animation) {
+  // Stop() was called by the pager, which goes on from the current position.
+}
+
+void SpacesPagerView::SettleAtRest() {
+  animation_.Stop();
+  dragging_ = false;
+  expected_visible_space_ = GetVisibleSpaceId();
+  strip_ = {expected_visible_space_};
+  position_ = 0;
+  StopMetrics();
+  UpdateHeaders();
+  AssignPages();
+  UpdateTransforms();
+  NotifyPositionChanged();
+}
+
+bool SpacesPagerView::CanDrag() const {
+  return active_ && GetWidget() && width() > 0 &&
+         region_->IsTabStripEditable();
+}
+
+void SpacesPagerView::BeginDrag() {
+  if (!CanDrag()) {
+    return;
+  }
+  animation_.Stop();
+  // Start from the pages on screen, with a neighbour on each side.
+  const int last = static_cast<int>(strip_.size()) - 1;
+  const int first_shown = std::clamp(static_cast<int>(std::floor(position_)),
+                                     0, last);
+  const int last_shown =
+      std::clamp(static_cast<int>(std::ceil(position_)), 0, last);
+  std::vector<std::string> strip(strip_.begin() + first_shown,
+                                 strip_.begin() + last_shown + 1);
+  double position = position_ - first_shown;
+  const std::vector<Space>& spaces = controller_->service()->spaces();
+  const int before = GetSpaceIndex(strip.front()) - 1;
+  if (before >= 0 && !std::ranges::contains(strip, spaces[before].id)) {
+    strip.insert(strip.begin(), spaces[before].id);
+    position += 1;
+  }
+  const int after = GetSpaceIndex(strip.back()) + 1;
+  if (after > 0 && after < static_cast<int>(spaces.size()) &&
+      !std::ranges::contains(strip, spaces[after].id)) {
+    strip.push_back(spaces[after].id);
+  }
+  strip_ = std::move(strip);
+  position_ = position;
+  drag_start_ = position_;
+  dragging_ = true;
+  StartMetrics();
+  AssignPages();
+  UpdateTransforms();
+  NotifyPositionChanged();
+}
+
+void SpacesPagerView::UpdateDrag(float distance) {
+  if (!dragging_) {
+    return;
+  }
+  const int width = GetPageWidth();
+  if (width <= 0) {
+    return;
+  }
+  const double direction = base::i18n::IsRTL() ? -1 : 1;
+  const double raw = drag_start_ - distance * direction / width;
+  const double last = static_cast<double>(strip_.size()) - 1;
+  if (raw < 0) {
+    position_ = -RubberBand(-raw);
+  } else if (raw > last) {
+    position_ = last + RubberBand(raw - last);
+  } else {
+    position_ = raw;
+  }
+  AssignPages();
+  UpdateTransforms();
+  NotifyPositionChanged();
+}
+
+void SpacesPagerView::EndDrag(float velocity) {
+  if (!dragging_) {
+    return;
+  }
+  dragging_ = false;
+  const double direction = base::i18n::IsRTL() ? -1 : 1;
+  // DIPs per second, positive towards the end of the strip.
+  const double speed = -velocity * direction;
+  const int last = static_cast<int>(strip_.size()) - 1;
+  const int start = std::clamp(static_cast<int>(std::lround(drag_start_)), 0,
+                               last);
+  int target = start;
+  if (std::abs(speed) >= kFlingVelocity) {
+    target = speed > 0 ? static_cast<int>(std::floor(position_)) + 1
+                       : static_cast<int>(std::ceil(position_)) - 1;
+    target = std::clamp(target, start - 1, start + 1);
+  } else if (position_ - start > kTurnThreshold) {
+    target = start + 1;
+  } else if (start - position_ > kTurnThreshold) {
+    target = start - 1;
+  }
+  target = std::clamp(target, 0, last);
+  Commit(strip_[target]);
+  if (GetVisibleSpaceId() != strip_[target]) {
+    SettleAtRest();
+    return;
+  }
+  AnimateTo(target, /*ease_in=*/false);
+}
+
+int SpacesPagerView::GetPageWidth() const {
+  return width();
+}
+
+void SpacesPagerView::AssignPages() {
+  if (!active_ || !peeks_[0]) {
+    return;
+  }
+  const std::string visible = GetVisibleSpaceId();
+  // The real page shows the visible space. A peek page that showed it before
+  // is stale (scroll, active tab): it starts afresh when needed again.
+  for (SpacePageView* peek : peeks_) {
+    if (peek->space_id() == visible) {
+      peek->ClearSpace();
+    }
+  }
+  std::vector<std::string> needed;
+  const int count = static_cast<int>(strip_.size());
+  for (double edge : {std::floor(position_), std::ceil(position_)}) {
+    const int index = static_cast<int>(edge);
+    if (index >= 0 && index < count && strip_[index] != visible &&
+        !std::ranges::contains(needed, strip_[index])) {
+      needed.push_back(strip_[index]);
+    }
+  }
+  const bool at_rest =
+      count == 1 && !dragging_ && !animation_.is_animating();
+  if (at_rest) {
+    // Get the neighbours ready, so a swipe starts without a layout.
+    const std::vector<Space>& spaces = controller_->service()->spaces();
+    const int index = GetSpaceIndex(visible);
+    for (int neighbour : {index - 1, index + 1}) {
+      if (neighbour >= 0 && neighbour < static_cast<int>(spaces.size())) {
+        needed.push_back(spaces[neighbour].id);
+      }
+    }
+  }
+
+  std::array<bool, 2> used = {false, false};
+  for (const std::string& space_id : needed) {
+    for (size_t i = 0; i < peeks_.size(); ++i) {
+      if (!used[i] && peeks_[i]->space_id() == space_id) {
+        used[i] = true;
+        break;
+      }
+    }
+  }
+  bool shown_new_space = false;
+  for (const std::string& space_id : needed) {
+    if (SpacePageView* peek = FindPeekShowing(space_id)) {
+      // Keeps its scroll, follows a change of the space's last active tab.
+      peek->ShowSpace(space_id, controller_->GetLastActiveTabOfSpace(space_id));
+      continue;
+    }
+    for (size_t i = 0; i < peeks_.size(); ++i) {
+      if (!used[i]) {
+        used[i] = true;
+        ShowSpaceInPeek(peeks_[i], space_id);
+        shown_new_space = true;
+        break;
+      }
+    }
+  }
+  if (shown_new_space && GetWidget()) {
+    // The peek pages lay out for their new space before they scroll.
+    GetWidget()->LayoutRootViewIfNecessary();
+    for (size_t i = 0; i < peeks_.size(); ++i) {
+      if (pending_scroll_[i]) {
+        pending_scroll_[i] = false;
+        peeks_[i]->SnapTabLayout();
+        ScrollPage(peeks_[i], GetSavedScroll(peeks_[i]->space_id()),
+                   peeks_[i]->active_tab());
+      }
+    }
+  }
+}
+
+SpacePageView* SpacesPagerView::FindPeekShowing(
+    const std::string& space_id) const {
+  for (SpacePageView* peek : peeks_) {
+    if (peek && !space_id.empty() && peek->space_id() == space_id) {
+      return peek;
+    }
+  }
+  return nullptr;
+}
+
+void SpacesPagerView::ShowSpaceInPeek(SpacePageView* peek,
+                                      const std::string& space_id) {
+  peek->ShowSpace(space_id, controller_->GetLastActiveTabOfSpace(space_id));
+  peek->SetHeader(GetSpace(space_id), active_);
+  for (size_t i = 0; i < peeks_.size(); ++i) {
+    if (peeks_[i] == peek) {
+      pending_scroll_[i] = true;
+    }
+  }
+}
+
+void SpacesPagerView::UpdateTransforms() {
+  const int width = GetPageWidth();
+  const int direction = base::i18n::IsRTL() ? -1 : 1;
+  // Whole pixels, and exactly one page width between neighbours.
+  const int base = static_cast<int>(std::lround(-position_ * width));
+  auto offset_of = [&](int index) {
+    return direction * (index * width + base);
+  };
+  const std::string visible = GetVisibleSpaceId();
+  const int count = static_cast<int>(strip_.size());
+
+  int real_index = static_cast<int>(std::ranges::find(strip_, visible) -
+                                    strip_.begin());
+  if (!active_ || real_index == count) {
+    real_index = 0;
+  }
+  const int real_offset = active_ ? offset_of(real_index) : 0;
+  real_page_->SetTransform(
+      real_offset ? gfx::Transform::MakeTranslation(real_offset, 0)
+                  : gfx::Transform());
+
+  bool peek_shown = false;
+  for (SpacePageView* peek : peeks_) {
+    if (!peek) {
+      continue;
+    }
+    const int index = static_cast<int>(
+        std::ranges::find(strip_, peek->space_id()) - strip_.begin());
+    const bool show = active_ && !peek->space_id().empty() &&
+                      peek->space_id() != visible && index < count &&
+                      std::abs(index - position_) < 1.0;
+    if (show) {
+      peek->SetTransform(gfx::Transform::MakeTranslation(offset_of(index), 0));
+      peek_shown = true;
+    }
+    peek->SetVisible(show);
+  }
+  if (peek_shown && !loading_timer_.IsRunning()) {
+    StepPeekLoadingAnimations();
+    loading_timer_.Start(FROM_HERE, kLoadingAnimationInterval, this,
+                         &SpacesPagerView::StepPeekLoadingAnimations);
+  } else if (!peek_shown) {
+    loading_timer_.Stop();
+  }
+}
+
+void SpacesPagerView::StepPeekLoadingAnimations() {
+  const base::TimeDelta elapsed =
+      base::TimeTicks::Now() - loading_animation_start_;
+  for (SpacePageView* peek : peeks_) {
+    if (peek && peek->GetVisible()) {
+      peek->StepLoadingAnimations(elapsed);
+    }
+  }
+}
+
+void SpacesPagerView::NotifyPositionChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnPagerPositionChanged(strip_, position_);
+  }
+}
+
+void SpacesPagerView::CreatePeeks() {
+  if (peeks_[0] || !model_) {
+    return;
+  }
+  for (size_t i = 0; i < peeks_.size(); ++i) {
+    peeks_[i] = AddChildViewAt(
+        std::make_unique<SpacePageView>(model_, browser_view_, *region_), 0);
+    peeks_[i]->SetVisible(false);
+    peeks_[i]->SetCollapsed(IsCollapsed());
+    pending_scroll_[i] = false;
+  }
+  InvalidateLayout();
+}
+
+void SpacesPagerView::DestroyPeeks() {
+  loading_timer_.Stop();
+  for (raw_ptr<SpacePageView>& peek : peeks_) {
+    if (peek) {
+      RemoveChildViewT(std::exchange(peek, nullptr));
+    }
+  }
+}
+
+void SpacesPagerView::UpdateHeaders() {
+  // Shown in every collapse state, so collapsing or expanding the sidebar
+  // never moves the tabs up or down. Collapsed, only the icon fits.
+  const bool show = active_;
+  real_page_->SetHeader(GetSpace(GetVisibleSpaceId()), show);
+  for (SpacePageView* peek : peeks_) {
+    if (peek) {
+      peek->SetHeader(GetSpace(peek->space_id()), show);
+    }
+  }
+}
+
+bool SpacesPagerView::IsCollapsed() const {
+  auto* state_controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  return state_controller && state_controller->GetCollapseState() !=
+                                 tabs::VerticalTabStripCollapseState::kExpanded;
+}
+
+void SpacesPagerView::OnCollapseStateChanged() {
+  const bool collapsed = IsCollapsed();
+  for (SpacePageView* peek : peeks_) {
+    if (peek) {
+      peek->SetCollapsed(collapsed);
+    }
+  }
+  UpdateHeaders();
+  InvalidateLayout();
+}
+
+void SpacesPagerView::UpdateActiveState() {
+  const bool active = IsActive();
+  if (active != active_) {
+    active_ = active;
+    if (active_) {
+      CreatePeeks();
+    } else {
+      animation_.Stop();
+      DestroyPeeks();
+    }
+    UpdateFlex();
+    PreferredSizeChanged();
+  }
+  SettleAtRest();
+  for (Observer& observer : observers_) {
+    observer.OnPagerSpacesChanged();
+  }
+}
+
+std::optional<int> SpacesPagerView::GetSavedScroll(
+    const std::string& space_id) const {
+  auto it = saved_scroll_.find(space_id);
+  return it == saved_scroll_.end() ? std::nullopt
+                                   : std::optional<int>(it->second);
+}
+
+void SpacesPagerView::StartMetrics() {
+  if (metrics_tracker_ || !GetWidget() || !GetWidget()->GetCompositor()) {
+    return;
+  }
+  move_start_ = base::TimeTicks::Now();
+  metrics_tracker_ =
+      GetWidget()->GetCompositor()->RequestNewCompositorMetricsTracker();
+  metrics_tracker_->Start(base::BindOnce(&ReportSmoothness));
+}
+
+void SpacesPagerView::StopMetrics() {
+  if (!metrics_tracker_) {
+    return;
+  }
+  base::UmaHistogramTimes("Neon.Spaces.Pager.MoveTime",
+                          base::TimeTicks::Now() - move_start_);
+  metrics_tracker_->Stop();
+  metrics_tracker_.reset();
+}
+
+void SpacesPagerView::SetBottomView(std::unique_ptr<views::View> view) {
+  if (bottom_view_) {
+    RemoveChildViewT(std::exchange(bottom_view_, nullptr));
+  }
+  if (view) {
+    bottom_view_ = AddChildView(std::move(view));
+  }
+  InvalidateLayout();
+}
+
+void SpacesPagerView::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpacesPagerView::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpacesPagerView::Layout(PassKey) {
+  const int bottom_height = bottom_view_ && bottom_view_->GetVisible()
+                                ? bottom_view_->GetPreferredSize().height()
+                                : 0;
+  const gfx::Rect pages(0, 0, width(), std::max(0, height() - bottom_height));
+  real_page_->SetBoundsRect(pages);
+  for (SpacePageView* peek : peeks_) {
+    if (peek) {
+      peek->SetBoundsRect(pages);
+    }
+  }
+  if (bottom_view_) {
+    bottom_view_->SetBounds(0, pages.bottom(), width(), bottom_height);
+  }
+  UpdateTransforms();
+}
+
+gfx::Size SpacesPagerView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  gfx::Size size = real_page_->GetPreferredSize(available_size);
+  if (active_ && bottom_view_ && bottom_view_->GetVisible()) {
+    size.Enlarge(0, bottom_view_->GetPreferredSize().height());
+  }
+  return size;
+}
+
+const views::FlexSpecification* SpacesPagerView::GetRegionFlex() const {
+  return region_flex_ ? &*region_flex_
+                      : GetProperty(views::kFlexBehaviorKey);
+}
+
+void SpacesPagerView::UpdateFlex() {
+  if (active_) {
+    if (!region_flex_) {
+      const views::FlexSpecification* flex =
+          GetProperty(views::kFlexBehaviorKey);
+      if (!flex) {
+        // Not added to the region yet.
+        return;
+      }
+      region_flex_ = *flex;
+    }
+    // The bottom buttons below can grow too, with weight 1: they get a
+    // rounded-away share of the extra height.
+    SetProperty(views::kFlexBehaviorKey,
+                views::FlexSpecification(
+                    views::MinimumFlexSizeRule::kScaleToMinimum,
+                    views::MaximumFlexSizeRule::kUnbounded)
+                    .WithWeight(kFlexWeight));
+  } else if (region_flex_) {
+    SetProperty(views::kFlexBehaviorKey, *std::exchange(region_flex_, {}));
+  }
+}
+
+void SpacesPagerView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  if (details.is_add && details.child == this) {
+    // The region sets the flex behaviour before adding the pager.
+    region_flex_.reset();
+    UpdateFlex();
+  }
+}
+
+void SpacesPagerView::AddedToWidget() {
+  SettleAtRest();
+}
+
+void SpacesPagerView::RemovedFromWidget() {
+  animation_.Stop();
+  if (metrics_tracker_) {
+    metrics_tracker_->Cancel();
+    metrics_tracker_.reset();
+  }
+}
+
+void SpacesPagerView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();
+}
+
+void SpacesPagerView::OnSpacesChanged() {
+  UpdateActiveState();
+}
+
+void SpacesPagerView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (tab_strip_model->closing_all()) {
+    animation_.Stop();
+    return;
+  }
+  if (!selection.active_tab_changed() || !active_) {
+    return;
+  }
+  const std::string visible = GetVisibleSpaceId();
+  if (visible != expected_visible_space_) {
+    // Another space was shown without the pager (tab search, a link from
+    // another app, a tab dragged in): show it at rest. The tab strip has not
+    // laid out yet, so it still has the old space's scroll offset.
+    saved_scroll_[expected_visible_space_] = real_page_->GetScroll();
+    SettleAtRest();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SpacesPagerView::RestoreScroll,
+                                  weak_factory_.GetWeakPtr(), visible));
+  }
+}
+
+void SpacesPagerView::RestoreScroll(const std::string& space_id) {
+  if (!active_ || !GetWidget() || GetVisibleSpaceId() != space_id ||
+      strip_.size() != 1) {
+    return;
+  }
+  if (std::optional<int> scroll = GetSavedScroll(space_id)) {
+    ScrollPage(real_page_, scroll, model_->GetActiveTab());
+  }
+}
+
+void SpacesPagerView::OnTabStripModelDestroyed(TabStripModel* tab_strip_model) {
+  animation_.Stop();
+  DestroyPeeks();
+  model_ = nullptr;
+}
