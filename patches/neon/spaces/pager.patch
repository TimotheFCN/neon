+namespace {
+
+// How strongly an icon that is not emphasized is drawn.
+constexpr SkAlpha kFadedAlpha = 0x8c;
+
+class SpaceIconSource : public gfx::CanvasImageSource {
+ public:
+  SpaceIconSource(std::u16string glyph,
+                  SkColor color,
+                  SkColor text_color,
+                  int size)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        glyph_(std::move(glyph)),
+        color_(color),
+        text_color_(text_color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    PaintSpaceIcon(canvas, gfx::RectF(gfx::SizeF(size())), size().width(),
+                   glyph_, color_, text_color_, /*emphasized=*/true);
+  }
+
+ private:
+  const std::u16string glyph_;
+  const SkColor color_;
+  const SkColor text_color_;
+};
+
+}  // namespace
+
+std::u16string GetSpaceGlyph(const Space& space) {
+  if (!space.icon.empty()) {
+    return base::UTF8ToUTF16(space.icon);
+  }
+  std::u16string name = base::UTF8ToUTF16(space.name);
+  if (name.empty()) {
+    return std::u16string();
+  }
+  return base::i18n::ToUpper(name.substr(0, 1));
+}
+
+SpaceIconView::SpaceIconView(int size) : size_(size) {
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+SpaceIconView::~SpaceIconView() = default;
+
+void SpaceIconView::SetSpace(const Space& space) {
+  std::u16string glyph = GetSpaceGlyph(space);
+  if (glyph == glyph_ && space.color == color_) {
+    return;
+  }
+  glyph_ = std::move(glyph);
+  color_ = space.color;
+  SchedulePaint();
+}
+
+void SpaceIconView::SetEmphasized(bool emphasized) {
+  if (emphasized_ != emphasized) {
+    emphasized_ = emphasized;
+    SchedulePaint();
+  }
+}
+
+gfx::Size SpaceIconView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(size_, size_);
+}
+
+void SpaceIconView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  PaintSpaceIcon(canvas, gfx::RectF(GetContentsBounds()), size_, glyph_,
+                 color_, colors->GetColor(kColorTabForegroundActiveFrameActive),
+                 emphasized_);
+}
+
+void PaintSpaceIcon(gfx::Canvas* canvas,
+                    const gfx::RectF& area,
+                    int size,
+                    const std::u16string& glyph,
+                    SkColor color,
+                    SkColor text_color,
+                    bool emphasized) {
+  const bool has_color = SkColorGetA(color) != 0;
+  gfx::RectF bounds = area;
+  bounds.ClampToCenteredSize(gfx::SizeF(size, size));
+  const float radius = size / 4.0f;
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  SkColor glyph_color;
+  if (has_color) {
+    const SkColor fill = SkColorSetA(color, SK_AlphaOPAQUE);
+    flags.setColor(emphasized ? fill : SkColorSetA(fill, kFadedAlpha));
+    canvas->DrawRoundRect(bounds, radius, flags);
+    glyph_color = color_utils::GetColorWithMaxContrast(fill);
+  } else {
+    const float stroke = 1.5f;
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(stroke);
+    flags.setColor(emphasized ? text_color
+                              : SkColorSetA(text_color, kFadedAlpha));
+    gfx::RectF ring = bounds;
+    ring.Inset(stroke / 2);
+    canvas->DrawRoundRect(ring, radius, flags);
+    glyph_color = text_color;
+  }
+  if (!emphasized) {
+    glyph_color = SkColorSetA(glyph_color, kFadedAlpha);
+  }
+  if (glyph.empty()) {
+    return;
+  }
+  const gfx::FontList font_list =
+      gfx::FontList().DeriveWithSizeDelta(size / 2 - 12).DeriveWithWeight(
+          gfx::Font::Weight::SEMIBOLD);
+  canvas->DrawStringRectWithFlags(glyph, font_list, glyph_color,
+                                  gfx::ToEnclosingRect(bounds),
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+ui::ImageModel GetSpaceIconImage(const Space& space, int size) {
+  return ui::ImageModel::FromImageGenerator(
+      base::BindRepeating(
+          [](std::u16string glyph, SkColor color, int size,
+             const ui::ColorProvider* colors) {
+            const SkColor text_color =
+                colors->GetColor(kColorTabForegroundActiveFrameActive);
+            return gfx::CanvasImageSource::MakeImageSkia<SpaceIconSource>(
+                glyph, color, text_color, size);
+          },
+          GetSpaceGlyph(space), space.color, size),
+      gfx::Size(size, size));
+}
+
+BEGIN_METADATA(SpaceIconView)
+END_METADATA
+
