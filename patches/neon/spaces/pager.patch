+// static
+SpacesPagerView* SpacesPagerView::FromTabStripView(
+    views::View* tab_strip_view) {
+  for (views::View* view = tab_strip_view; view; view = view->parent()) {
+    if (auto* pager = views::AsViewClass<SpacesPagerView>(view)) {
+      return pager;
+    }
+  }
+  return nullptr;
+}
