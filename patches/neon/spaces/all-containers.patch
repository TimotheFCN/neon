+#ifndef CHROME_BROWSER_UI_NEON_SPACES_SPACE_TAB_TRACKER_H_
+#define CHROME_BROWSER_UI_NEON_SPACES_SPACE_TAB_TRACKER_H_
+
+#include <string>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace neon::spaces {
+
+// Follows one tab of a normal window with spaces:
+// - remembers the space the tab was last in, so a tab whose page is outside
+//   every space's container for a moment (a blank page that left a WebUI
+//   page) stays in its space until it is reopened there;
+// - tells the window's SpacesWindowController when a page commits in the tab,
+//   so a tab whose page landed in the default partition is reopened in a
+//   space (see SpacesWindowController::RepairStrayTabs()).
+class SpaceTabTracker
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<SpaceTabTracker> {
+ public:
+  SpaceTabTracker(const SpaceTabTracker&) = delete;
+  SpaceTabTracker& operator=(const SpaceTabTracker&) = delete;
+  ~SpaceTabTracker() override;
+
+  // The space the tab was last in, or empty.
+  const std::string& space_id() const { return space_id_; }
+  void set_space_id(std::string space_id) { space_id_ = std::move(space_id); }
+
+  // Whether the tab replaced a tab that had landed outside every space. Such
+  // a tab is not replaced again, so a page that cannot load in a container
+  // does not reopen forever.
