+void SpacesWindowController::OnTabCommitted(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  if (!HasSpaces() || !contents) {
+    return;
+  }
+  if (const Space* space = service_->GetSpaceForContainer(
+          containers_api::GetTabContainerId(contents))) {
+    SpaceTabTracker::GetOrCreateForWebContents(contents)->set_space_id(
+        space->id);
+    return;
+  }
+  if (IsStrayTab(contents)) {
+    ScheduleStrayRepair();
+  }
+}
+
+void SpacesWindowController::TrackTab(content::WebContents* contents) {
+  if (!HasSpaces() || !contents) {
+    return;
+  }
+  SpaceTabTracker* tracker =
+      SpaceTabTracker::GetOrCreateForWebContents(contents);
+  if (const Space* space = service_->GetSpaceForContainer(
+          containers_api::GetTabContainerId(contents))) {
+    tracker->set_space_id(space->id);
+  } else if (!service_->GetSpace(tracker->space_id())) {
+    // Not in a space's container (yet): it belongs to the space that was
+    // visible when it arrived.
+    tracker->set_space_id(service_->GetSpace(last_visible_space_)
+                              ? last_visible_space_
+                              : service_->spaces().front().id);
+  }
+  if (IsStrayTab(contents)) {
+    ScheduleStrayRepair();
+  }
+}
+
+bool SpacesWindowController::IsStrayTab(content::WebContents* contents) const {
+  if (!HasSpaces() || !contents) {
+    return false;
+  }
+  // A tab that has not committed a page yet (a new tab being created, a
+  // noopener window whose SiteInstance gets its container's site when its
+  // page commits) is judged once it has one. Restored tabs have committed
+  // entries from the start.
+  content::NavigationEntry* entry =
+      contents->GetController().GetLastCommittedEntry();
+  if (!entry || entry->IsInitialEntry()) {
+    return false;
+  }
+  return !service_->GetSpaceForContainer(
+      containers_api::GetTabContainerId(contents));
+}
+
+void SpacesWindowController::ScheduleStrayRepair() {
+  if (stray_repair_scheduled_) {
+    return;
+  }
+  stray_repair_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpacesWindowController::RepairStrayTabs,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SpacesWindowController::RepairStrayTabs() {
+  stray_repair_scheduled_ = false;
+  if (!model_ || model_->closing_all() || !HasSpaces()) {
+    return;
+  }
+  // From the end, so the indices of the tabs still to look at do not move.
+  for (int i = model_->count() - 1; i >= 0; --i) {
+    if (i >= model_->count()) {
+      continue;
+    }
+    content::WebContents* contents = model_->GetWebContentsAt(i);
+    if (!IsStrayTab(contents)) {
+      continue;
+    }
+    SpaceTabTracker* tracker =
+        SpaceTabTracker::GetOrCreateForWebContents(contents);
+    const GURL url =
+        contents->GetController().GetLastCommittedEntry()->GetURL();
+    if (global_context::IsGlobalContextURL(url)) {
+      global::MoveTabToGlobalWindow(browser_, i);
+      continue;
+    }
+    if (tracker->is_replacement()) {
+      LOG(WARNING) << "Neon: a tab reopened in a space left it again: "
+                   << url.possibly_invalid_spec();
+      continue;
+    }
+    const Space* space = service_->GetSpace(tracker->space_id());
+    if (!space) {
+      space = &service_->spaces().front();
+    }
+    const std::string space_id = space->id;
+    content::WebContents* replacement = containers_api::OpenTabInContainer(
+        browser_,
+        url.is_empty() ? GURL(chrome::kChromeUINewTabURL) : url,
+        space->container_id, i + 1,
+        /*foreground=*/model_->active_index() == i, model_->IsTabPinned(i));
+    if (!replacement) {
+      continue;
+    }
+    SpaceTabTracker* replacement_tracker =
+        SpaceTabTracker::GetOrCreateForWebContents(replacement);
+    replacement_tracker->set_space_id(space_id);
+    replacement_tracker->set_is_replacement();
+    const int index = model_->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      model_->DetachAndDeleteWebContentsAt(index);
+    }
+  }
 }
 
