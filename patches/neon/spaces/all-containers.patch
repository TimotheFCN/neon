+#include "chrome/browser/ui/neon/spaces/space_tab_tracker.h"
+
+#include "chrome/browser/ui/neon/spaces/spaces_window_controller.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+
+namespace neon::spaces {
+
+SpaceTabTracker::SpaceTabTracker(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<SpaceTabTracker>(*contents) {}
+
+SpaceTabTracker::~SpaceTabTracker() = default;
+
+void SpaceTabTracker::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      handle->IsSameDocument()) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents());
+  if (SpacesWindowController* controller =
+          tab ? SpacesWindowController::FromTab(tab) : nullptr) {
+    controller->OnTabCommitted(tab);
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SpaceTabTracker);
+
