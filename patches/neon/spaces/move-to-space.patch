+namespace neon::spaces {
+
+// The "Reopen in space" submenu of the tab context menu: every space but the
+// tab's own, then "New space". Picking one reopens the tab, or the selected
+// tabs if it is selected, in that space (see ReopenTabsInSpace()).
+class ReopenInSpaceMenuModel : public ui::SimpleMenuModel,
+                               public ui::SimpleMenuModel::Delegate {
+ public:
+  // Command ids of the items, clear of the tab menu's own submenu ids.
+  static constexpr int kNewSpaceCommandId = 2200;
+  static constexpr int kMinSpaceCommandId = 2201;
+
+  // Registers Create() with the tab menu. Once per process.
+  static void Install();
+
+  // The submenu for the tab at |index|, or null if the window shows no spaces
+  // (another layout, a single space) or there is no other space to offer.
+  static std::unique_ptr<ui::SimpleMenuModel> Create(TabStripModel* model,
+                                                     int index);
+
+  ReopenInSpaceMenuModel(Profile* profile,
+                         std::vector<tabs::TabHandle> tabs,
+                         const std::string& current_space_id);
+  ReopenInSpaceMenuModel(const ReopenInSpaceMenuModel&) = delete;
+  ReopenInSpaceMenuModel& operator=(const ReopenInSpaceMenuModel&) = delete;
+  ~ReopenInSpaceMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  raw_ptr<Profile> profile_;
+  std::vector<tabs::TabHandle> tabs_;
+  // The space of each item, by command id.
+  std::vector<std::string> space_ids_;
+};
+
+}  // namespace neon::spaces
