+#include "chrome/browser/ui/views/neon/spaces/space_icon_view.h"
+
+namespace neon::spaces {
+
+namespace {
+
+constexpr int kMenuIconSize = 16;
+
+}  // namespace
+
+// static
+void ReopenInSpaceMenuModel::Install() {
+  static bool installed = false;
+  if (!installed) {
+    installed = true;
+    SetReopenInSpaceMenuFactory(
+        base::BindRepeating(&ReopenInSpaceMenuModel::Create));
+  }
+}
+
+// static
+std::unique_ptr<ui::SimpleMenuModel> ReopenInSpaceMenuModel::Create(
+    TabStripModel* model,
+    int index) {
+  SpacesWindowController* controller =
+      SpacesWindowController::FromModel(model);
+  if (!controller || !controller->IsActive() || !model->ContainsIndex(index)) {
+    return nullptr;
+  }
+  std::vector<tabs::TabHandle> tabs;
+  if (model->IsTabSelected(index)) {
+    for (size_t selected :
+         model->selection_model().GetListSelectionModel().selected_indices()) {
+      tabs.push_back(model->GetTabAtIndex(selected)->GetHandle());
+    }
+  } else {
+    tabs.push_back(model->GetTabAtIndex(index)->GetHandle());
+  }
+  return std::make_unique<ReopenInSpaceMenuModel>(
+      controller->browser()->GetProfile(), std::move(tabs),
+      controller->GetSpaceIdOf(model->GetTabAtIndex(index)));
+}
+
+ReopenInSpaceMenuModel::ReopenInSpaceMenuModel(
+    Profile* profile,
+    std::vector<tabs::TabHandle> tabs,
+    const std::string& current_space_id)
+    : ui::SimpleMenuModel(this), profile_(profile), tabs_(std::move(tabs)) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  for (const Space& space : service->spaces()) {
+    if (space.id == current_space_id) {
+      continue;
+    }
+    const int command_id =
+        kMinSpaceCommandId + static_cast<int>(space_ids_.size());
+    space_ids_.push_back(space.id);
+    AddItemWithIcon(command_id, base::UTF8ToUTF16(space.name),
+                    GetSpaceIconImage(space, kMenuIconSize));
+  }
+  AddSeparator(ui::NORMAL_SEPARATOR);
+  AddItem(kNewSpaceCommandId, u"New space");
+}
+
+ReopenInSpaceMenuModel::~ReopenInSpaceMenuModel() = default;
+
+void ReopenInSpaceMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  std::string space_id;
+  if (command_id == kNewSpaceCommandId) {
+    std::optional<std::string> created = CreateSpace(profile_);
+    if (!created) {
+      return;
+    }
+    space_id = *created;
+  } else {
+    const size_t index = static_cast<size_t>(command_id - kMinSpaceCommandId);
+    if (index >= space_ids_.size()) {
+      return;
+    }
+    space_id = space_ids_[index];
+  }
+  ReopenTabsInSpace(tabs_, space_id);
+}
+
+}  // namespace neon::spaces
