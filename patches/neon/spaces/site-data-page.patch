+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/neon/spaces/site_data_scope.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/neon/containers_api.h"
+#include "chrome/browser/neon/spaces/space.h"
+#include "chrome/browser/neon/spaces/spaces_service.h"
+#include "chrome/browser/neon/spaces/spaces_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/browser/web_ui.h"
+
+namespace neon::spaces {
+
+namespace {
+
+// The container a settings tab's site data pages show, once the user picked
+// one. Empty for the global context.
+class SiteDataScopeData
+    : public content::WebContentsUserData<SiteDataScopeData> {
+ public:
+  ~SiteDataScopeData() override = default;
+
+  std::string container_id;
+
+ private:
+  friend class content::WebContentsUserData<SiteDataScopeData>;
+  explicit SiteDataScopeData(content::WebContents* contents)
+      : content::WebContentsUserData<SiteDataScopeData>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SiteDataScopeData);
+
+Profile* GetProfile(content::WebUI* web_ui) {
+  return Profile::FromBrowserContext(
+      web_ui->GetWebContents()->GetBrowserContext());
+}
+
+SpacesService* GetService(Profile* profile) {
+  return containers_api::IsAvailable(profile)
+             ? SpacesServiceFactory::GetForProfile(profile)
+             : nullptr;
+}
+
+// Whether |container_id| is still a choice: a space's container, or the
+// global context.
+bool IsChoice(SpacesService* service, const std::string& container_id) {
+  return container_id.empty() || service->GetSpaceForContainer(container_id);
+}
+
+// The chosen container, or std::nullopt without spaces.
+std::optional<std::string> GetChosenContainer(content::WebUI* web_ui) {
+  SpacesService* service = GetService(GetProfile(web_ui));
+  if (!service || service->spaces().empty()) {
+    return std::nullopt;
+  }
+  content::WebContents* contents = web_ui->GetWebContents();
+  if (SiteDataScopeData* data = SiteDataScopeData::FromWebContents(contents);
+      data && IsChoice(service, data->container_id)) {
+    return data->container_id;
+  }
+  // The space the settings tab is in, else the first space.
+  const std::string tab_container =
+      containers_api::GetTabContainerId(contents);
+  if (!tab_container.empty() && service->GetSpaceForContainer(tab_container)) {
+    return tab_container;
+  }
+  return service->spaces().front().container_id;
+}
+
+}  // namespace
+
+content::StoragePartition* GetSiteDataStoragePartition(
+    content::WebUI* web_ui) {
+  std::optional<std::string> container_id = GetChosenContainer(web_ui);
+  if (!container_id) {
+    return nullptr;
+  }
+  Profile* profile = GetProfile(web_ui);
+  std::optional<content::StoragePartitionConfig> config =
+      containers_api::GetStoragePartitionConfig(profile, *container_id);
+  return config ? profile->GetStoragePartition(*config) : nullptr;
+}
+
+bool IsSiteDataScoped(content::WebUI* web_ui) {
+  return GetChosenContainer(web_ui).has_value();
+}
+
+SiteDataScopeHandler::SiteDataScopeHandler(Profile* profile)
+    : profile_(profile) {}
+
+SiteDataScopeHandler::~SiteDataScopeHandler() = default;
+
+void SiteDataScopeHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "neonSiteDataGetScope",
+      base::BindRepeating(&SiteDataScopeHandler::HandleGetScope,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonSiteDataSetScope",
+      base::BindRepeating(&SiteDataScopeHandler::HandleSetScope,
+                          base::Unretained(this)));
+}
+
+base::DictValue SiteDataScopeHandler::GetScope() {
+  base::DictValue scope;
+  std::optional<std::string> chosen = GetChosenContainer(web_ui());
+  SpacesService* service = GetService(profile_);
+  if (!chosen || !service) {
+    scope.Set("available", false);
+    return scope;
+  }
+  base::ListValue choices;
+  for (const Space& space : service->spaces()) {
+    choices.Append(base::DictValue()
+                       .Set("id", space.container_id)
+                       .Set("name", space.name));
+  }
+  choices.Append(base::DictValue()
+                     .Set("id", std::string())
+                     .Set("name", "Outside spaces (extensions)"));
+  scope.Set("available", true);
+  scope.Set("choices", std::move(choices));
+  scope.Set("selected", *chosen);
+  return scope;
+}
+
+void SiteDataScopeHandler::HandleGetScope(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], GetScope());
+}
+
+void SiteDataScopeHandler::HandleSetScope(const base::ListValue& args) {
+  // [callback id, container id]
+  AllowJavascript();
+  SpacesService* service = GetService(profile_);
+  if (service && args.size() == 2 && args[1].is_string() &&
+      IsChoice(service, args[1].GetString())) {
+    SiteDataScopeData::CreateForWebContents(web_ui()->GetWebContents());
+    SiteDataScopeData::FromWebContents(web_ui()->GetWebContents())
+        ->container_id = args[1].GetString();
+  }
+  ResolveJavascriptCallback(args[0], GetScope());
+}
+
+}  // namespace neon::spaces
