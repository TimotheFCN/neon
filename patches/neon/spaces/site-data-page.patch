+
+class Profile;
+
+namespace content {
+class StoragePartition;
+class WebUI;
+}  // namespace content
+
+// Which space's data the site data pages of chrome://settings show ("All
+// sites" and the page of one site). Each space keeps its cookies and site
+// storage in its own container, while permissions belong to the profile and
+// are shared by every space. The pages show one space at a time, chosen per
+// settings tab; deleting a site's data there deletes it in that space only.
+namespace neon::spaces {
+
+// The partition the site data pages of |web_ui| read and delete from: the
+// chosen space's container, the default partition (the global context of
+// extensions and browser pages) if that was chosen, or by default the
+// container of the space the settings tab is in. nullptr without spaces,
+// where the pages keep reading the default partition.
+content::StoragePartition* GetSiteDataStoragePartition(content::WebUI* web_ui);
+
+// Whether the site data pages of |web_ui| show one space's data.
+bool IsSiteDataScoped(content::WebUI* web_ui);
+
+// neonSiteDataGetScope: the choices ({id: container id, empty for the global
+// context; name}) and the current one. neonSiteDataSetScope: picks one; the
+// pages then fetch their lists again.
+class SiteDataScopeHandler : public content::WebUIMessageHandler {
+ public:
+  explicit SiteDataScopeHandler(Profile* profile);
+  SiteDataScopeHandler(const SiteDataScopeHandler&) = delete;
+  SiteDataScopeHandler& operator=(const SiteDataScopeHandler&) = delete;
+  ~SiteDataScopeHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  base::DictValue GetScope();
+  void HandleGetScope(const base::ListValue& args);
+  void HandleSetScope(const base::ListValue& args);
+
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_NEON_SPACES_SITE_DATA_SCOPE_H_
