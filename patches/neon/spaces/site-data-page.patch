+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-neon-site-data-space' picks which space's data the
+ * site data pages show ("All sites" and the page of one site). Each space
+ * keeps its cookies and site storage apart; permissions are shared by all
+ * spaces. The choice is kept per settings tab by
+ * chrome/browser/ui/neon/spaces/site_data_scope.cc, and every instance of
+ * this element shows it. Fires 'neon-site-data-space-change' after a change,
+ * once the browser uses the new space. Shows nothing without spaces.
+ * With mode="note" it only says that permissions are shared by all spaces.
+ */
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './neon_site_data_space.css.js';
+import {getHtml} from './neon_site_data_space.html.js';
+
+export interface NeonSiteDataScope {
+  available: boolean;
+  // Container ids; the empty id is the global context.
+  choices?: Array<{id: string, name: string}>;
+  selected?: string;
+}
+
+// Shared by every instance in the page.
+let scope: NeonSiteDataScope|null = null;
+const instances = new Set<SettingsNeonSiteDataSpaceElement>();
+
+// Whether the site data pages show one space's data.
+export function isNeonSiteDataScoped(): boolean {
+  return !!scope?.available;
+}
+
+function update(next: NeonSiteDataScope) {
+  scope = next;
+  instances.forEach(element => element.scope_ = next);
+}
+
+export class SettingsNeonSiteDataSpaceElement extends CrLitElement {
+  static get is() {
+    return 'settings-neon-site-data-space';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      scope_: {type: Object},
+      mode: {type: String},
+    };
+  }
+
+  accessor scope_: NeonSiteDataScope|null = scope;
+  accessor mode: 'select'|'note' = 'select';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    instances.add(this);
+    sendWithPromise<NeonSiteDataScope>('neonSiteDataGetScope').then(update);
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    instances.delete(this);
+  }
+
+  protected async onChange_(e: Event) {
+    const id = (e.target as HTMLSelectElement).value;
+    update(await sendWithPromise<NeonSiteDataScope>(
+        'neonSiteDataSetScope', id));
+    this.fire('neon-site-data-space-change', {id});
+  }
+}
+
+declare global {
+  interface HTMLElementEventMap {
+    'neon-site-data-space-change': CustomEvent<{id: string}>;
+  }
+
+  interface HTMLElementTagNameMap {
+    'settings-neon-site-data-space': SettingsNeonSiteDataSpaceElement;
+  }
+}
+
+customElements.define(
+    SettingsNeonSiteDataSpaceElement.is, SettingsNeonSiteDataSpaceElement);
