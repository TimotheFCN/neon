+#ifndef CHROME_BROWSER_UI_NEON_SPACES_SITE_DATA_SCOPE_H_
+#define CHROME_BROWSER_UI_NEON_SPACES_SITE_DATA_SCOPE_H_
+
+#include "base/memory/raw_ptr.h"
