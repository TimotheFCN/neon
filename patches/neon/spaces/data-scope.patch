+// Reports the end of one removal task, then deletes itself.
+class RemovalObserver : public content::BrowsingDataRemover::Observer {
+ public:
+  RemovalObserver(content::BrowsingDataRemover* remover,
+                  base::OnceCallback<void(uint64_t)> done)
+      : done_(std::move(done)) {
+    observation_.Observe(remover);
+  }
+
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    observation_.Reset();
+    std::move(done_).Run(failed_data_types);
+    delete this;
+  }
+
+ private:
+  base::OnceCallback<void(uint64_t)> done_;
+  base::ScopedObservation<content::BrowsingDataRemover,
+                          content::BrowsingDataRemover::Observer>
+      observation_{this};
+};
+
+const Space* FindSpace(Profile* profile, const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  return service ? service->GetSpace(space_id) : nullptr;
+}
+
+// Counts sites and cache bytes over several partitions; owned by the
+// callbacks it hands out, so it outlives none of the partitions' answers.
+class Counter : public base::RefCounted<Counter> {
+ public:
+  Counter(base::Time begin, base::OnceCallback<void(const DataCount&)> done)
+      : begin_(begin), done_(std::move(done)) {}
+
+  void CountPartition(content::StoragePartition* partition) {
+    Add(1);
+    partition->GetCookieManagerForBrowserProcess()->GetAllCookies(
+        base::BindOnce(&Counter::OnCookies, this));
+    Add(1);
+    partition->GetQuotaManagerProxy()->GetBucketsModifiedBetween(
+        begin_, base::Time::Max(), base::BindOnce(&Counter::OnBuckets, this));
+    if (content::DOMStorageContext* dom_storage =
+            partition->GetDOMStorageContext()) {
+      Add(1);
+      dom_storage->GetLocalStorageUsage(
+          base::BindOnce(&Counter::OnLocalStorage, this));
+    }
+    Add(1);
+    browsing_data::ConditionalCacheCountingHelper::Count(
+        partition, begin_, base::Time::Max(),
+        base::BindOnce(&Counter::OnCache, this));
+  }
+
+  // Called once every partition has been asked.
+  void Start() { Done(); }
+
+ private:
+  friend class base::RefCounted<Counter>;
+  ~Counter() = default;
+
+  void Add(int tasks) { pending_ += tasks; }
+
+  void AddSite(const GURL& url) {
+    if (browsing_data::HasWebScheme(url)) {
+      hosts_.insert(url.GetHost());
+    }
+  }
+
+  void OnCookies(const net::CookieList& cookies) {
+    for (const net::CanonicalCookie& cookie : cookies) {
+      if (cookie.CreationDate() >= begin_) {
+        AddSite(net::cookie_util::CookieOriginToURL(cookie.Domain(),
+                                                    cookie.SecureAttribute()));
+      }
+    }
+    Done();
+  }
+
+  void OnBuckets(const std::set<storage::BucketLocator>& buckets) {
+    for (const storage::BucketLocator& bucket : buckets) {
+      AddSite(bucket.storage_key.origin().GetURL());
+    }
+    Done();
+  }
+
+  void OnLocalStorage(const std::vector<content::StorageUsageInfo>& infos) {
+    for (const content::StorageUsageInfo& info : infos) {
+      if (info.last_modified >= begin_) {
+        AddSite(info.storage_key.origin().GetURL());
+      }
+    }
+    Done();
+  }
+
+  void OnCache(bool is_upper_limit, int64_t bytes) {
+    // A negative size is a net error: count nothing.
+    if (bytes > 0) {
+      count_.cache_bytes += bytes;
+    }
+    count_.cache_is_upper_limit |= is_upper_limit;
+    Done();
+  }
+
+  // Each answer, and Start(), ends one pending task.
+  void Done() {
+    if (--pending_ > 0) {
+      return;
+    }
+    count_.sites = base::checked_cast<int>(hosts_.size());
+    std::move(done_).Run(count_);
+  }
+
+  const base::Time begin_;
+  base::OnceCallback<void(const DataCount&)> done_;
+  // Starts at 1 for Start().
+  int pending_ = 1;
+  std::set<std::string> hosts_;
+  DataCount count_;
+};
+
+}  // namespace
+
+uint64_t GetPerSpaceDataTypes() {
+  return content::BrowsingDataRemover::DATA_TYPE_ON_STORAGE_PARTITION;
+}
+
+std::optional<SpaceRef> GetSpaceOfContainer(Profile* profile,
+                                            const std::string& container_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  if (!service || container_id.empty()) {
+    return std::nullopt;
+  }
+  const Space* space = service->GetSpaceForContainer(container_id);
+  if (!space) {
+    return std::nullopt;
+  }
+  return SpaceRef{space->id, space->name, space->container_id};
+}
+
+bool RemoveSpaceData(Profile* profile,
+                     const std::string& space_id,
+                     base::Time begin,
+                     base::Time end,
+                     uint64_t remove_mask,
+                     uint64_t origin_type_mask,
+                     base::OnceCallback<void(uint64_t)> done) {
+  const Space* space = FindSpace(profile, space_id);
+  std::optional<content::StoragePartitionConfig> config =
+      space ? containers_api::GetStoragePartitionConfig(profile,
+                                                        space->container_id)
+            : std::nullopt;
+  if (!config || space->container_id.empty()) {
+    return false;
+  }
+  // Whatever is not on the partition belongs to every space.
+  remove_mask &= GetPerSpaceDataTypes();
+  content::BrowsingDataRemover* remover = profile->GetBrowsingDataRemover();
+  if (!remove_mask) {
+    std::move(done).Run(0);
+    return true;
+  }
+  auto filter = content::BrowsingDataFilterBuilder::Create(
+      content::BrowsingDataFilterBuilder::Mode::kPreserve);
+  filter->SetStoragePartitionConfig(*config);
+  remover->RemoveWithFilterAndReply(
+      begin, end, remove_mask, origin_type_mask, std::move(filter),
+      new RemovalObserver(remover, std::move(done)));
+  return true;
+}
+
+void WaitForQueuedRemovals(Profile* profile, base::OnceClosure done) {
+  // Tasks run one at a time in the order they were queued, so a task that
+  // removes nothing, queued now, finishes after all of them.
+  content::BrowsingDataRemover* remover = profile->GetBrowsingDataRemover();
+  remover->RemoveAndReply(
+      base::Time(), base::Time::Max(), /*remove_mask=*/0,
+      /*origin_type_mask=*/0,
+      new RemovalObserver(remover,
+                          base::IgnoreArgs<uint64_t>(std::move(done))));
+}
+
+std::vector<std::string> GetAllDataContainerIds(Profile* profile) {
+  std::set<std::string> ids;
+  for (const std::string& id : containers_api::ListUsedContainerIds(profile)) {
+    ids.insert(id);
+  }
+  for (const containers_api::ContainerInfo& info :
+       containers_api::ListContainers(profile)) {
+    ids.insert(info.id);
+  }
+  std::vector<std::string> out = {std::string()};
+  out.insert(out.end(), ids.begin(), ids.end());
+  return out;
+}
+
+void CountData(Profile* profile,
+               const std::vector<std::string>& container_ids,
+               base::Time begin,
+               base::OnceCallback<void(const DataCount&)> done) {
+  auto counter = base::MakeRefCounted<Counter>(begin, std::move(done));
+  for (const std::string& id : container_ids) {
+    std::optional<content::StoragePartitionConfig> config =
+        containers_api::GetStoragePartitionConfig(profile, id);
+    if (!config) {
+      continue;
+    }
+    // Loads the partition if needed: a space's data is on disk even when
+    // none of its pages has been opened yet this session.
+    if (content::StoragePartition* partition =
+            profile->GetStoragePartition(*config)) {
+      counter->CountPartition(partition);
+    }
+  }
+  counter->Start();
+}
+
+std::pair<std::u16string, std::u16string> GetCounterTexts(
+    const DataCount& count) {
+  std::u16string cookies = l10n_util::GetPluralStringFUTF16(
+      IDS_DEL_COOKIES_COUNTER_ADVANCED, count.sites);
+  // As the stock cache counter on desktop: "Less than 1 MB" below a megabyte.
+  std::u16string cache;
+  const base::ByteSize bytes(base::checked_cast<uint64_t>(count.cache_bytes));
+  if (bytes >= base::MiB(1)) {
+    std::u16string size =
+        ui::GetByteDisplayUnits(bytes) >= ui::DataUnits::kMebibyte
+            ? ui::FormatBytes(bytes)
+            : ui::FormatBytesWithUnits(bytes, ui::DataUnits::kMebibyte, true);
+    cache = count.cache_is_upper_limit
+                ? l10n_util::GetStringFUTF16(
+                      IDS_DEL_CACHE_COUNTER_UPPER_ESTIMATE, size)
+                : size;
+  } else {
+    cache = l10n_util::GetStringUTF16(IDS_DEL_CACHE_COUNTER_ALMOST_EMPTY);
+  }
+  return {cookies, cache};
+}
+
+bool ClearSpaceData(Profile* profile,
+                    const std::string& space_id,
+                    base::OnceClosure done) {
+  const Space* space = FindSpace(profile, space_id);
+  std::optional<content::StoragePartitionConfig> config =
+      space ? containers_api::GetStoragePartitionConfig(profile,
+                                                        space->container_id)
+            : std::nullopt;
+  if (!config || space->container_id.empty()) {
+    return false;
+  }
+  // ClearContainerStorage() only clears a loaded partition; the space keeps
+  // its data on disk otherwise, so load it.
+  profile->GetStoragePartition(*config);
+  containers_api::ClearContainerStorage(
+      profile, space->container_id,
+      base::BindOnce(
+          [](base::WeakPtr<Profile> profile, std::string container_id,
+             base::OnceClosure done) {
+            if (profile) {
+              // Reload the space's pages, so none keeps running on data that
+              // is gone. Tabs that were never loaded stay as they are.
+              GlobalBrowserCollection::GetInstance()->ForEach(
+                  [&](BrowserWindowInterface* browser) {
+                    TabStripModel* model = browser->GetTabStripModel();
+                    if (browser->GetProfile() != profile.get() || !model) {
+                      return true;
+                    }
+                    for (int i = 0; i < model->count(); ++i) {
+                      content::WebContents* contents =
+                          model->GetWebContentsAt(i);
+                      if (containers_api::GetTabContainerId(contents) ==
+                              container_id &&
+                          !contents->WasDiscarded() &&
+                          !contents->GetController().NeedsReload() &&
+                          contents->GetController().GetLastCommittedEntry()) {
+                        contents->GetController().Reload(
+                            content::ReloadType::NORMAL,
+                            /*check_for_repost=*/false);
+                      }
+                    }
+                    return true;
+                  });
+            }
+            std::move(done).Run();
+          },
+          profile->GetWeakPtr(), space->container_id, std::move(done)));
+  return true;
+}
+
