+#ifndef CHROME_BROWSER_UI_NEON_SPACES_SPACE_DATA_H_
+#define CHROME_BROWSER_UI_NEON_SPACES_SPACE_DATA_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "base/time/time.h"
+
+class Profile;
+
+// Clearing and counting the data each space keeps apart from the others.
+//
+// A space's own data is everything on its container's storage partition:
+// cookies, site storage (local storage, IndexedDB, Cache Storage, service
+// workers...) and the HTTP cache. History, downloads, passwords, autofill and
+// site settings belong to the profile and are shared by every space.
+namespace neon::spaces {
+
+// The data types of a BrowsingDataRemover mask that a space keeps apart:
+// content::BrowsingDataRemover::DATA_TYPE_ON_STORAGE_PARTITION.
+uint64_t GetPerSpaceDataTypes();
+
+// The space a WebUI or web page belongs to: the space of its tab's container.
+// std::nullopt outside every space (the global context) or when there are no
+// spaces.
+struct SpaceRef {
+  std::string id;
+  std::string name;
+  std::string container_id;
+};
+std::optional<SpaceRef> GetSpaceOfContainer(Profile* profile,
+                                            const std::string& container_id);
+
+// Removes the data types of |remove_mask| that live on a storage partition
+// from the container of space |space_id|, for the time range [begin, end).
+// Runs |done| with the data types that failed. Returns false, without running
+// |done|, if there is no such space.
+bool RemoveSpaceData(Profile* profile,
+                     const std::string& space_id,
+                     base::Time begin,
+                     base::Time end,
+                     uint64_t remove_mask,
+                     uint64_t origin_type_mask,
+                     base::OnceCallback<void(uint64_t)> done);
+
+// Runs |done| once every removal queued on |profile|'s BrowsingDataRemover so
+// far has finished, including those that a removal without a storage
+// partition queues for each container (see ChromeBrowsingDataRemoverDelegate).
+void WaitForQueuedRemovals(Profile* profile, base::OnceClosure done);
+
+// Every storage partition "all spaces" covers, as container ids: the global
+// context (the empty id) and every container in use or listed.
+std::vector<std::string> GetAllDataContainerIds(Profile* profile);
+
+// What clearing would remove from the partitions of |container_ids|, for the
+// time range starting at |begin|.
+struct DataCount {
+  // Sites with cookies or site storage set or changed since |begin|.
+  int sites = 0;
+  // Bytes of HTTP cache entries used since |begin|.
+  int64_t cache_bytes = 0;
+  // Whether |cache_bytes| is only an upper bound (time-limited counts).
+  bool cache_is_upper_limit = false;
+};
+void CountData(Profile* profile,
+               const std::vector<std::string>& container_ids,
+               base::Time begin,
+               base::OnceCallback<void(const DataCount&)> done);
+
+// The counter texts of the clear browsing data dialog for |count|, as the
+// stock counters word them: {cookies and site data, cached files}.
+std::pair<std::u16string, std::u16string> GetCounterTexts(
+    const DataCount& count);
+
+// Clears all the cookies, site storage and cache of space |space_id| (all
+// time), keeping the space and its tabs, then reloads the space's loaded tabs
+// in every window. Runs |done| when finished. Returns false, without running
+// |done|, if there is no such space.
+bool ClearSpaceData(Profile* profile,
+                    const std::string& space_id,
+                    base::OnceClosure done);
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_NEON_SPACES_SPACE_DATA_H_
