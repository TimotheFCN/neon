+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview Talks to chrome/browser/ui/neon/spaces/space_data_handler.cc:
+ * the space scope of the "Delete browsing data" dialog, and clearing a space.
+ */
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+import type {ClearBrowsingDataResult} from './clear_browsing_data_browser_proxy.js';
+
+export interface NeonDataScope {
+  // Whether the profile has spaces.
+  available: boolean;
+  // The space the settings tab is in. Absent outside every space.
+  space?: {id: string, name: string};
+}
+
+export interface NeonDataCounts {
+  // Counter texts, worded as the stock counters word them.
+  cookies: string;
+  cache: string;
+}
+
+export interface NeonDataScopeBrowserProxy {
+  getScope(): Promise<NeonDataScope>;
+  // Deletes the per-space types among |dataTypes| (deletion pref names) from
+  // space |spaceId|.
+  clear(spaceId: string, dataTypes: string[], timePeriod: number):
+      Promise<ClearBrowsingDataResult>;
+  // Resolves once every deletion queued so far is done.
+  waitForRemovals(): Promise<void>;
+  // Counts for space |spaceId|, or for all spaces and the global context
+  // when |spaceId| is empty.
+  count(spaceId: string, timePeriod: number): Promise<NeonDataCounts|null>;
+  // Clears all of space |spaceId|'s data and reloads its tabs.
+  clearSpace(spaceId: string): Promise<boolean>;
+}
+
+export class NeonDataScopeBrowserProxyImpl implements
+    NeonDataScopeBrowserProxy {
+  getScope() {
+    return sendWithPromise<NeonDataScope>('neonDataGetScope');
+  }
+
+  clear(spaceId: string, dataTypes: string[], timePeriod: number) {
+    return sendWithPromise<ClearBrowsingDataResult>(
+        'neonDataClear', spaceId, dataTypes, timePeriod);
+  }
+
+  waitForRemovals() {
+    return sendWithPromise<void>('neonDataWaitForRemovals');
+  }
+
+  count(spaceId: string, timePeriod: number) {
+    return sendWithPromise<NeonDataCounts|null>(
+        'neonDataCount', spaceId, timePeriod);
+  }
+
+  clearSpace(spaceId: string) {
+    return sendWithPromise<boolean>('neonDataClearSpace', spaceId);
+  }
+
+  static getInstance(): NeonDataScopeBrowserProxy {
+    return instance || (instance = new NeonDataScopeBrowserProxyImpl());
+  }
+
+  static setInstance(obj: NeonDataScopeBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: NeonDataScopeBrowserProxy|null = null;
