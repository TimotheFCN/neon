+void ShowClearSpaceDataConfirmation(views::View* anchor,
+                                    Profile* profile,
+                                    const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  const Space* space = service ? service->GetSpace(space_id) : nullptr;
+  if (!anchor || !anchor->GetWidget() || !space) {
+    return;
+  }
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(base::StrCat({u"Clear the data of “",
+                                  base::UTF8ToUTF16(space->name), u"”?"}))
+          .AddParagraph(ui::DialogModelLabel(
+              u"Deletes this space's cookies, site data and cached files, so "
+              u"you will be signed out of its sites. The space and its tabs "
+              u"stay, and open tabs reload. History is shared by all spaces "
+              u"and is kept."))
+          .AddOkButton(
+              base::BindOnce(
+                  [](base::WeakPtr<Profile> profile, std::string space_id) {
+                    if (profile) {
+                      ClearSpaceData(profile.get(), space_id,
+                                     base::DoNothing());
+                    }
+                  },
+                  profile->GetWeakPtr(), space_id),
+              ui::DialogModel::Button::Params().SetLabel(u"Clear data"))
+          .AddCancelButton(base::DoNothing())
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::LEFT_BOTTOM);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
+
