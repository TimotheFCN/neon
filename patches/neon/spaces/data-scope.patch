+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-neon-space-scope' picks what the "Delete browsing
+ * data" dialog deletes from: the space the settings tab is in, or all spaces
+ * (which also covers the global context of extensions and the browser's own
+ * pages). It shows nothing without spaces, or outside every space, where only
+ * "all spaces" makes sense. Fires 'neon-scope-change' with
+ * {available, spaceId}, spaceId being empty for all spaces, once known and on
+ * every change.
+ */
+import 'chrome://resources/cr_elements/cr_chip/cr_chip.js';
+import 'chrome://resources/cr_elements/cr_icon/cr_icon.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {NeonDataScope} from './neon_data_scope_browser_proxy.js';
+import {NeonDataScopeBrowserProxyImpl} from './neon_data_scope_browser_proxy.js';
+import {getCss} from './neon_space_scope.css.js';
+import {getHtml} from './neon_space_scope.html.js';
+
+export interface NeonScopeChangeDetail {
+  available: boolean;
+  spaceId: string;
+}
+
+export class SettingsNeonSpaceScopeElement extends CrLitElement {
+  static get is() {
+    return 'settings-neon-space-scope';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      scope_: {type: Object},
+      spaceSelected_: {type: Boolean},
+    };
+  }
+
+  protected accessor scope_: NeonDataScope|null = null;
+  // Starts on the current space when there is one.
+  protected accessor spaceSelected_: boolean = true;
+
+  override firstUpdated() {
+    NeonDataScopeBrowserProxyImpl.getInstance().getScope().then(scope => {
+      this.scope_ = scope;
+      this.notify_();
+    });
+  }
+
+  // The space id the dialog deletes from, empty for all spaces.
+  getSpaceId(): string {
+    return this.scope_?.space && this.spaceSelected_ ? this.scope_.space.id :
+                                                       '';
+  }
+
+  protected showChips_(): boolean {
+    return !!this.scope_?.available && !!this.scope_.space;
+  }
+
+  protected onSpaceClick_() {
+    this.select_(true);
+  }
+
+  protected onAllClick_() {
+    this.select_(false);
+  }
+
+  private select_(space: boolean) {
+    if (this.spaceSelected_ === space) {
+      return;
+    }
