+#include "content/public/browser/web_ui_message_handler.h"
+
+class Profile;
+
+namespace neon::spaces {
+
+struct DataCount;
+
+// Backs the space scope of chrome://settings' "Delete browsing data" dialog
+// and the "Clear data" action of the Spaces page:
+// - neonDataGetScope: the space the settings tab is in, if any;
+// - neonDataClear: deletes the per-space data types of the dialog from one
+//   space, for a time period;
+// - neonDataWaitForRemovals: resolves once every queued removal is done (the
+//   per-container removals of an "all spaces" deletion finish after the
+//   dialog's own);
+// - neonDataCount: the dialog's two per-partition counters (cookies and site
+//   data, cached files) for one space or for all spaces and the global
+//   context; the stock counters only read the default partition;
+// - neonDataClearSpace: clears all of a space's data and reloads its tabs.
+class SpaceDataHandler : public content::WebUIMessageHandler {
+ public:
+  explicit SpaceDataHandler(Profile* profile);
+  SpaceDataHandler(const SpaceDataHandler&) = delete;
+  SpaceDataHandler& operator=(const SpaceDataHandler&) = delete;
+  ~SpaceDataHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGetScope(const base::ListValue& args);
+  void HandleClear(const base::ListValue& args);
+  void HandleWaitForRemovals(const base::ListValue& args);
+  void HandleCount(const base::ListValue& args);
+  void HandleClearSpace(const base::ListValue& args);
+
+  void Resolve(const std::string& callback_id, base::Value value);
+  void OnCounted(const std::string& callback_id, const DataCount& count);
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<SpaceDataHandler> weak_factory_{this};
+};
+
+}  // namespace neon::spaces
