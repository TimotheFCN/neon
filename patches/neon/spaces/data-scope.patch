+std::optional<browsing_data::TimePeriod> ToTimePeriod(const base::Value& v) {
+  constexpr int kLast =
+      static_cast<int>(browsing_data::TimePeriod::TIME_PERIOD_LAST);
+  if (!v.is_int() || v.GetInt() < 0 || v.GetInt() > kLast) {
+    return std::nullopt;
+  }
+  return static_cast<browsing_data::TimePeriod>(v.GetInt());
+}
+
+}  // namespace
+
+SpaceDataHandler::SpaceDataHandler(Profile* profile) : profile_(profile) {}
+
+SpaceDataHandler::~SpaceDataHandler() = default;
+
+void SpaceDataHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "neonDataGetScope", base::BindRepeating(&SpaceDataHandler::HandleGetScope,
+                                              base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonDataClear", base::BindRepeating(&SpaceDataHandler::HandleClear,
+                                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonDataWaitForRemovals",
+      base::BindRepeating(&SpaceDataHandler::HandleWaitForRemovals,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonDataCount", base::BindRepeating(&SpaceDataHandler::HandleCount,
+                                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "neonDataClearSpace",
+      base::BindRepeating(&SpaceDataHandler::HandleClearSpace,
+                          base::Unretained(this)));
+}
+
+void SpaceDataHandler::OnJavascriptDisallowed() {
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+void SpaceDataHandler::Resolve(const std::string& callback_id,
+                               base::Value value) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(base::Value(callback_id), value);
+  }
+}
+
+void SpaceDataHandler::HandleGetScope(const base::ListValue& args) {
+  // [callback id]
+  AllowJavascript();
+  base::DictValue scope;
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile_);
+  scope.Set("available",
+            service != nullptr && containers_api::IsAvailable(profile_));
+  // The settings page opens as a tab of the visible space, in its container.
+  std::optional<SpaceRef> space = GetSpaceOfContainer(
+      profile_,
+      containers_api::GetTabContainerId(web_ui()->GetWebContents()));
+  if (space) {
+    scope.Set("space",
+              base::DictValue().Set("id", space->id).Set("name", space->name));
+  }
+  ResolveJavascriptCallback(args[0], scope);
+}
+
+void SpaceDataHandler::HandleClear(const base::ListValue& args) {
+  // [callback id, space id, list of deletion pref names, time period]
+  AllowJavascript();
+  const std::string callback_id = args[0].GetString();
+  std::optional<browsing_data::TimePeriod> period;
+  if (args.size() == 4 && args[1].is_string() && args[2].is_list()) {
+    period = ToTimePeriod(args[3]);
+  }
+  base::DictValue result;
+  result.Set("showHistoryNotice", false);
+  result.Set("showPasswordsNotice", false);
+  if (!period) {
+    ResolveJavascriptCallback(args[0], result);
+    return;
+  }
+  uint64_t remove_mask = 0;
+  uint64_t origin_mask = 0;
+  for (const base::Value& pref : args[2].GetList()) {
+    if (!pref.is_string()) {
+      continue;
+    }
+    std::optional<browsing_data::BrowsingDataType> type =
+        browsing_data::GetDataTypeFromDeletionPreference(pref.GetString());
+    if (type == browsing_data::BrowsingDataType::SITE_DATA) {
+      remove_mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+      origin_mask |= content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB;
+    } else if (type == browsing_data::BrowsingDataType::CACHE) {
+      remove_mask |= content::BrowsingDataRemover::DATA_TYPE_CACHE;
+    }
+    // Every other type belongs to the profile, shared by all spaces; the
+    // dialog does not offer them for one space.
+  }
+  const bool started = RemoveSpaceData(
+      profile_, args[1].GetString(),
+      browsing_data::CalculateBeginDeleteTime(*period),
+      browsing_data::CalculateEndDeleteTime(*period), remove_mask, origin_mask,
+      base::BindOnce(
+          [](base::WeakPtr<SpaceDataHandler> self, std::string callback_id,
+             base::DictValue result, uint64_t failed) {
+            if (self) {
+              self->Resolve(callback_id, base::Value(std::move(result)));
+            }
+          },
+          weak_factory_.GetWeakPtr(), callback_id, result.Clone()));
+  if (!started) {
+    ResolveJavascriptCallback(args[0], result);
+  }
+}
+
+void SpaceDataHandler::HandleWaitForRemovals(const base::ListValue& args) {
+  // [callback id]
+  AllowJavascript();
+  WaitForQueuedRemovals(
+      profile_,
+      base::BindOnce(&SpaceDataHandler::Resolve, weak_factory_.GetWeakPtr(),
+                     args[0].GetString(), base::Value()));
+}
+
+void SpaceDataHandler::HandleCount(const base::ListValue& args) {
+  // [callback id, space id or "" for all spaces, time period]
+  AllowJavascript();
+  std::optional<browsing_data::TimePeriod> period;
+  if (args.size() == 3 && args[1].is_string()) {
+    period = ToTimePeriod(args[2]);
+  }
+  if (!period) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  std::vector<std::string> container_ids;
+  if (args[1].GetString().empty()) {
+    container_ids = GetAllDataContainerIds(profile_);
+  } else if (SpacesService* service =
+                 SpacesServiceFactory::GetForProfile(profile_)) {
+    if (const Space* space = service->GetSpace(args[1].GetString())) {
+      container_ids.push_back(space->container_id);
+    }
+  }
+  CountData(profile_, container_ids,
+            browsing_data::CalculateBeginDeleteTime(*period),
+            base::BindOnce(&SpaceDataHandler::OnCounted,
+                           weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SpaceDataHandler::OnCounted(const std::string& callback_id,
+                                 const DataCount& count) {
+  auto [cookies, cache] = GetCounterTexts(count);
+  Resolve(callback_id, base::Value(base::DictValue()
+                                       .Set("cookies", cookies)
+                                       .Set("cache", cache)
+                                       .Set("sites", count.sites)));
+}
+
+void SpaceDataHandler::HandleClearSpace(const base::ListValue& args) {
+  // [callback id, space id]
+  AllowJavascript();
+  const std::string callback_id = args[0].GetString();
+  const bool started =
+      args.size() == 2 && args[1].is_string() &&
+      ClearSpaceData(profile_, args[1].GetString(),
+                     base::BindOnce(&SpaceDataHandler::Resolve,
+                                    weak_factory_.GetWeakPtr(), callback_id,
+                                    base::Value(true)));
+  if (!started) {
+    ResolveJavascriptCallback(args[0], base::Value(false));
+  }
+}
+
