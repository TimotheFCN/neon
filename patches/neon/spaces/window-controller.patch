+#ifndef CHROME_BROWSER_UI_NEON_SPACES_SPACE_TAB_FILTER_H_
+#define CHROME_BROWSER_UI_NEON_SPACES_SPACE_TAB_FILTER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/containers/span.h"
+#include "components/tabs/public/tab_collection_types.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// The calls that Chromium's tab strip model, browser commands and tab strip
+// views make into Neon spaces. Each hook is one line in an existing file. This
+// target only depends on //base and //components/tabs, so the hooked targets
+// can depend on it without a cycle; the logic behind it lives in
+// SpacesWindowController, which registers itself as the delegate.
+//
+// A window shows one space at a time, the space of its active tab (the visible
+// space). A tab of another space is hidden: the vertical tab strip leaves it
+// out, and keyboard tab navigation, the choice of the next active tab and the
+// close commands skip it. Nothing is hidden in incognito, in non-normal
+// windows, outside the vertical layout, or with only the default space.
+namespace neon::spaces {
+
+// Browser commands, outside chrome_command_ids.h so that adding them rebuilds
+// little. Values are clear of Chromium's and Helium's ids.
+inline constexpr int kNextSpaceCommand = 39000;
+inline constexpr int kPreviousSpaceCommand = 39001;
+// "Go to space N" for N = 1..9: kSelectSpaceCommand + N - 1.
+inline constexpr int kSelectSpaceCommand = 39010;
+inline constexpr int kSelectLastSpaceCommand = kSelectSpaceCommand + 8;
+
+// Every spaces command id, for enabling them in a browser.
+base::span<const int> GetCommandIds();
+
+// The name of a spaces command on the shortcuts settings page, or std::nullopt
+// for other commands. English only until spaces have a strings file (M4).
+std::optional<std::u16string> GetCommandLabel(int command_id);
+
+class HooksDelegate {
+ public:
+  virtual ~HooksDelegate() = default;
+
+  // |model| is the model that holds |tab|, or null when the caller does not
+  // know it.
+  virtual bool IsTabHidden(const TabStripModel* model,
+                           const tabs::TabInterface* tab) = 0;
+  // True if the visible space shown by tab strip |key| changed since the last
+  // call for |key|, now that |active_tab| is active.
+  virtual bool TakeVisibleSpaceChange(const void* key,
+                                      const tabs::TabInterface* active_tab) = 0;
+  // Runs a spaces command. Returns false if |command_id| is not one.
+  virtual bool ExecuteCommand(BrowserWindowInterface* browser,
+                              int command_id) = 0;
+};
+
+void SetHooksDelegate(HooksDelegate* delegate);
+
+// Whether |tab| of |model| belongs to a space other than the visible one.
+bool IsTabHidden(const TabStripModel* model, const tabs::TabInterface* tab);
+
+// Same for a tab strip child: a tab, or a group or split (by its first tab).
+bool IsChildHidden(const tabs::ConstChildPtr& child);
+
+bool TakeVisibleSpaceChange(const void* key,
+                            const tabs::TabInterface* active_tab);
+
+// Runs |command_id| if it is a spaces command and returns true, otherwise
+// returns false.
+bool ExecuteCommand(BrowserWindowInterface* browser, int command_id);
+
+// Tab strip views helpers. |Node| is a TabCollectionNode; templates keep this
+// target free of a dependency on the views.
+
+// Whether child view |child| of collection node |parent| is hidden.
+template <typename Node, typename View>
+bool IsChildViewHidden(const Node* parent, const View* child) {
+  if (!parent) {
+    return false;
+  }
+  for (const auto& node : parent->children()) {
+    if (node->view() == child) {
+      return IsChildHidden(node->GetNodeData());
+    }
+  }
+  return false;
+}
+
+// The number of hidden views among |children| of |parent|.
+template <typename Node, typename Views>
+int CountHiddenChildViews(const Node* parent, const Views& children) {
+  int count = 0;
+  for (const auto* child : children) {
+    if (IsChildViewHidden(parent, child)) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+// Called by the root of a tab strip when the active tab changes. When that
+// changes the visible space, the pinned and unpinned containers lay out again
+// to show the new space's tabs.
+template <typename Root>
+void OnActiveTabChanged(Root* root, const tabs::TabInterface* active_tab) {
+  if (!TakeVisibleSpaceChange(root, active_tab)) {
+    return;
+  }
+  for (const auto& node : root->children()) {
+    if (node->view()) {
+      node->view()->InvalidateLayout();
+    }
+  }
+  if (root->view()) {
+    root->view()->InvalidateLayout();
+  }
+}
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_NEON_SPACES_SPACE_TAB_FILTER_H_
