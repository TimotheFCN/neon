+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/neon/spaces/space_tab_filter.h"
+
+#include <array>
+#include <variant>
+
+#include "base/strings/string_number_conversions.h"
+
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace neon::spaces {
+
+namespace {
+
+HooksDelegate* g_delegate = nullptr;
+
+constexpr std::array<int, 11> kCommandIds = {
+    kNextSpaceCommand,       kPreviousSpaceCommand,
+    kSelectSpaceCommand,     kSelectSpaceCommand + 1,
+    kSelectSpaceCommand + 2, kSelectSpaceCommand + 3,
+    kSelectSpaceCommand + 4, kSelectSpaceCommand + 5,
+    kSelectSpaceCommand + 6, kSelectSpaceCommand + 7,
+    kSelectLastSpaceCommand,
+};
+
+}  // namespace
+
+base::span<const int> GetCommandIds() {
+  return kCommandIds;
+}
+
+std::optional<std::u16string> GetCommandLabel(int command_id) {
+  if (command_id == kNextSpaceCommand) {
+    return u"Next space";
+  }
+  if (command_id == kPreviousSpaceCommand) {
+    return u"Previous space";
+  }
+  if (command_id >= kSelectSpaceCommand &&
+      command_id <= kSelectLastSpaceCommand) {
+    return u"Space " +
+           base::NumberToString16(command_id - kSelectSpaceCommand + 1);
+  }
+  return std::nullopt;
+}
+
+void SetHooksDelegate(HooksDelegate* delegate) {
+  g_delegate = delegate;
+}
+
+bool IsTabHidden(const TabStripModel* model, const tabs::TabInterface* tab) {
+  return g_delegate && tab && g_delegate->IsTabHidden(model, tab);
+}
+
+bool IsChildHidden(const tabs::ConstChildPtr& child) {
+  if (!g_delegate) {
+    return false;
+  }
+  if (std::holds_alternative<tabs::ConstDanglingUntriagedTabInterface>(child)) {
+    return IsTabHidden(
+        nullptr,
+        std::get<tabs::ConstDanglingUntriagedTabInterface>(child).get());
+  }
+  const tabs::TabCollection* collection =
+      std::get<tabs::ConstDanglingUntriagedTabCollection>(child).get();
+  if (!collection || collection->TabCountRecursive() == 0) {
+    return false;
+  }
+  return IsTabHidden(nullptr, collection->GetTabAtIndexRecursive(0));
+}
+
+bool TakeVisibleSpaceChange(const void* key,
+                            const tabs::TabInterface* active_tab) {
+  return g_delegate && g_delegate->TakeVisibleSpaceChange(key, active_tab);
+}
+
+bool ExecuteCommand(BrowserWindowInterface* browser, int command_id) {
+  return g_delegate && g_delegate->ExecuteCommand(browser, command_id);
+}
+
+}  // namespace neon::spaces
