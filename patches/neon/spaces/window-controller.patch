+#include "components/keyed_service/core/keyed_service.h"
+
+class BrowserCollection;
+class BrowserWindowInterface;
+class Profile;
+
+namespace neon::spaces {
+
+class SpacesService;
+class SpacesWindowController;
+
+// Gives every normal window of a regular profile a SpacesWindowController,
+// from the moment the window exists, before its first tab.
+class SpacesWindowManager : public KeyedService,
+                            public BrowserCollectionObserver {
+ public:
+  SpacesWindowManager(Profile* profile, SpacesService* service);
+  SpacesWindowManager(const SpacesWindowManager&) = delete;
+  SpacesWindowManager& operator=(const SpacesWindowManager&) = delete;
+  ~SpacesWindowManager() override;
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<SpacesService> service_;
+  std::map<BrowserWindowInterface*, std::unique_ptr<SpacesWindowController>>
+      controllers_;
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
+
+class SpacesWindowManagerFactory : public ProfileKeyedServiceFactory {
+ public:
+  static SpacesWindowManagerFactory* GetInstance();
+
+ private:
+  friend base::NoDestructor<SpacesWindowManagerFactory>;
+
+  SpacesWindowManagerFactory();
+  ~SpacesWindowManagerFactory() override;
+
+  // ProfileKeyedServiceFactory:
+  bool ServiceIsCreatedWithBrowserContext() const override;
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+};
+
+}  // namespace neon::spaces
