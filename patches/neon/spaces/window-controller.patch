+#include "components/prefs/pref_change_registrar.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace neon::spaces {
+
+// The spaces of one normal browser window. The window shows one space at a
+// time, the visible space, which is the space of the active tab. Nothing about
+// it is stored: a tab's space comes from its container, so session restore
+// brings back the tabs in their spaces, the visible space with the active tab,
+// and each space's last active tab through the tabs' last active times.
+//
+// The controller:
+// - answers which tabs are hidden (other spaces) for the hooks in
+//   space_tab_filter.h,
+// - switches space by activating the space's most recently active tab, or a
+//   new tab page in the space when it has none,
+// - picks the container of new tabs opened without a source page,
+// - opens a new tab page in a space whose last tab was closed while other
+//   spaces still have tabs,
+// - keeps each space's tabs together within the pinned and the unpinned tabs,
+//   so ranges of the visible tabs never include hidden ones.
+//
+// All of this is off (IsActive() false) outside the vertical layout and with
+// only the default space, so the window then behaves like stock Helium.
+class SpacesWindowController : public TabStripModelObserver,
+                               public SpacesService::Observer {
+ public:
+  SpacesWindowController(BrowserWindowInterface* browser,
+                         SpacesService* service);
+  SpacesWindowController(const SpacesWindowController&) = delete;
+  SpacesWindowController& operator=(const SpacesWindowController&) = delete;
+  ~SpacesWindowController() override;
+
+  // The controller of a normal window of a regular profile, or null.
+  static SpacesWindowController* FromBrowser(
+      const BrowserWindowInterface* browser);
+  static SpacesWindowController* FromModel(const TabStripModel* model);
+  // The controller whose model holds |tab|, or null.
+  static SpacesWindowController* FromTab(const tabs::TabInterface* tab);
+
+  // Registers the hooks delegate and the new tab container provider. Once per
+  // process.
+  static void InstallHooks();
+
+  BrowserWindowInterface* browser() const { return browser_; }
+  TabStripModel* model() const { return model_; }
+
+  // Whether spaces apply to this window now: vertical layout and more than one
+  // space.
+  bool IsActive() const;
+
+  // The space of |contents| or |tab|, by its container.
+  const std::string& GetSpaceIdOf(content::WebContents* contents) const;
+  const std::string& GetSpaceIdOf(const tabs::TabInterface* tab) const;
+  // The space of the active tab, or the default space with no active tab.
+  const std::string& GetVisibleSpaceId() const;
+
+  // Whether |tab| is in another space than the visible one. Always false when
+  // inactive.
+  bool IsTabHidden(const tabs::TabInterface* tab) const;
+
+  // Shows space |space_id|: activates its most recently active tab, or opens a
+  // new tab page in it. Does nothing if inactive or the space is unknown.
+  void SwitchToSpace(const std::string& space_id);
+  // Shows the space at |index| in the space list.
+  void SwitchToSpaceAt(size_t index);
+  // Shows the next (|delta| 1) or previous (-1) space. Stops at the ends.
+  void SwitchToRelativeSpace(int delta);
+
+  // The container a new tab of this window opens in when it has no source
+  // page: the visible space's, or for a window without tabs yet the visible
+  // space of the last active window. Empty for the default partition.
+  std::string GetContainerForNewTab() const;
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+  // SpacesService::Observer:
+  void OnSpacesChanged() override;
+
+  // A tab of |space_id| was closed. If it was the space's last tab and the
+  // space was visible, leaves a new tab page there, unless the closed tab was
+  // itself an untouched new tab page: then the window moves on to another
+  // space and the space stays empty.
+  void OnSpaceTabClosed(const std::string& space_id, bool was_new_tab_page);
+  void OpenNewTabInSpace(const std::string& space_id);
+  // Shows the space before |space_id| in the list that still has tabs, or the
+  // one after it.
+  void SwitchAwayFrom(const std::string& space_id);
+  bool SpaceHasTabs(const std::string& space_id) const;
+
+  void ScheduleRepair();
+  void RepairContiguity();
+  // Moves tabs in [start, end) so each space's tabs are adjacent. Ranges with
+  // groups or splits are left alone.
+  void RepairRange(int start, int end);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<TabStripModel> model_;
+  raw_ptr<SpacesService> service_;
+  // Set while this controller opens a tab in a given space.
+  std::optional<std::string> pending_new_tab_space_;
+  // The visible space as of the last model change.
+  std::string last_visible_space_;
+  bool repair_scheduled_ = false;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::WeakPtrFactory<SpacesWindowController> weak_factory_{this};
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_NEON_SPACES_SPACES_WINDOW_CONTROLLER_H_
