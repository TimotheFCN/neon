+#include "chrome/browser/ui/neon/spaces/spaces_window_controller.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/neon/containers_api.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
+#include "chrome/browser/ui/neon/spaces/space_tab_filter.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/url_constants.h"
+#include "url/gurl.h"
+
+namespace neon::spaces {
+
+namespace {
+
+std::vector<SpacesWindowController*>& Registry() {
+  static base::NoDestructor<std::vector<SpacesWindowController*>> registry;
+  return *registry;
+}
+
+bool IsDeletion(TabRemovedReason reason) {
+  return reason == TabRemovedReason::kDeleted ||
+         reason == TabRemovedReason::kDeletedAndExpandSidePanel;
+}
+
+// A new tab page nobody has used: closing it should not leave another one.
+bool IsUntouchedNewTabPage(content::WebContents* contents) {
+  const GURL& url = contents->GetLastCommittedURL().is_empty()
+                        ? contents->GetVisibleURL()
+                        : contents->GetLastCommittedURL();
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         (url.host() == chrome::kChromeUINewTabHost ||
+          url.host() == chrome::kChromeUINewTabPageHost) &&
+         !contents->GetController().CanGoBack();
+}
+
+class HooksDelegateImpl : public HooksDelegate {
+ public:
+  bool IsTabHidden(const TabStripModel* model,
+                   const tabs::TabInterface* tab) override {
+    SpacesWindowController* controller =
+        model ? SpacesWindowController::FromModel(model)
+              : SpacesWindowController::FromTab(tab);
+    return controller && controller->IsTabHidden(tab);
+  }
+
+  bool TakeVisibleSpaceChange(const void* key,
+                              const tabs::TabInterface* active_tab) override {
+    std::string space;
+    if (SpacesWindowController* controller =
+            active_tab ? SpacesWindowController::FromTab(active_tab)
+                       : nullptr;
+        controller && controller->IsActive()) {
+      space = controller->GetSpaceIdOf(active_tab);
+    }
+    auto it = last_spaces_.find(key);
+    if (it != last_spaces_.end() && it->second == space) {
+      return false;
+    }
+    last_spaces_[key] = std::move(space);
+    return true;
+  }
+
+  bool ExecuteCommand(BrowserWindowInterface* browser,
+                      int command_id) override {
+    if (!std::ranges::contains(GetCommandIds(), command_id)) {
+      return false;
+    }
+    SpacesWindowController* controller =
+        SpacesWindowController::FromBrowser(browser);
+    if (!controller) {
+      return true;
+    }
+    if (command_id == kNextSpaceCommand) {
+      controller->SwitchToRelativeSpace(1);
+    } else if (command_id == kPreviousSpaceCommand) {
+      controller->SwitchToRelativeSpace(-1);
+    } else {
+      controller->SwitchToSpaceAt(command_id - kSelectSpaceCommand);
+    }
+    return true;
+  }
+
+ private:
+  // The visible space each tab strip last showed, by tab strip.
+  std::map<const void*, std::string> last_spaces_;
+};
+
+std::string GetContainerForNewTabIn(BrowserWindowInterface* browser) {
+  SpacesWindowController* controller =
+      SpacesWindowController::FromBrowser(browser);
+  return controller ? controller->GetContainerForNewTab() : std::string();
+}
+
+}  // namespace
+
+SpacesWindowController::SpacesWindowController(
+    BrowserWindowInterface* browser,
+    SpacesService* service)
+    : browser_(browser),
+      model_(browser->GetTabStripModel()),
+      service_(service) {
+  Registry().push_back(this);
+  model_->AddObserver(this);
+  service_->AddObserver(this);
+  pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+  pref_change_registrar_.Add(
+      prefs::kHeliumLayout,
+      base::BindRepeating(&SpacesWindowController::ScheduleRepair,
+                          base::Unretained(this)));
+  last_visible_space_ = GetVisibleSpaceId();
+}
+
+SpacesWindowController::~SpacesWindowController() {
+  std::erase(Registry(), this);
+  service_->RemoveObserver(this);
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+}
+
+// static
+SpacesWindowController* SpacesWindowController::FromBrowser(
+    const BrowserWindowInterface* browser) {
+  for (SpacesWindowController* controller : Registry()) {
+    if (controller->browser_ == browser) {
+      return controller;
+    }
+  }
+  return nullptr;
+}
+
+// static
+SpacesWindowController* SpacesWindowController::FromModel(
+    const TabStripModel* model) {
+  for (SpacesWindowController* controller : Registry()) {
+    if (controller->model_ == model) {
+      return controller;
+    }
+  }
+  return nullptr;
+}
+
+// static
+SpacesWindowController* SpacesWindowController::FromTab(
+    const tabs::TabInterface* tab) {
+  if (!tab) {
+    return nullptr;
+  }
+  // Compares pointers only, so a tab that is being removed is safe to pass.
+  for (SpacesWindowController* controller : Registry()) {
+    if (controller->model_ &&
+        controller->model_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      return controller;
+    }
+  }
+  return nullptr;
+}
+
+// static
+void SpacesWindowController::InstallHooks() {
+  static base::NoDestructor<HooksDelegateImpl> delegate;
+  SetHooksDelegate(delegate.get());
+  containers_api::SetNewTabContainerProvider(
+      base::BindRepeating(&GetContainerForNewTabIn));
+}
+
+bool SpacesWindowController::IsActive() const {
+  return model_ && service_->spaces().size() > 1 &&
+         browser_->GetProfile()->GetPrefs()->GetInteger(
+             prefs::kHeliumLayout) ==
+             std::to_underlying(HeliumLayoutType::kVertical);
+}
+
+const std::string& SpacesWindowController::GetSpaceIdOf(
+    content::WebContents* contents) const {
+  return service_->GetSpaceIdForContainer(
+      contents ? containers_api::GetTabContainerId(contents) : std::string());
+}
+
+const std::string& SpacesWindowController::GetSpaceIdOf(
+    const tabs::TabInterface* tab) const {
+  return GetSpaceIdOf(tab ? tab->GetContents() : nullptr);
+}
+
+const std::string& SpacesWindowController::GetVisibleSpaceId() const {
+  return GetSpaceIdOf(model_ ? model_->GetActiveTab() : nullptr);
+}
+
+bool SpacesWindowController::IsTabHidden(const tabs::TabInterface* tab) const {
+  if (!tab || !IsActive()) {
+    return false;
+  }
+  const tabs::TabInterface* active_tab = model_->GetActiveTab();
+  if (!active_tab || active_tab == tab) {
+    return false;
+  }
+  return GetSpaceIdOf(tab) != GetSpaceIdOf(active_tab);
+}
+
+void SpacesWindowController::SwitchToSpace(const std::string& space_id) {
+  if (!IsActive() || !service_->GetSpace(space_id) ||
+      space_id == GetVisibleSpaceId()) {
+    return;
+  }
+  int best_index = TabStripModel::kNoTab;
+  base::TimeTicks best_time;
+  for (int i = 0; i < model_->count(); ++i) {
+    content::WebContents* contents = model_->GetWebContentsAt(i);
+    if (GetSpaceIdOf(contents) != space_id) {
+      continue;
+    }
+    const base::TimeTicks time = contents->GetLastActiveTimeTicks();
+    if (best_index == TabStripModel::kNoTab || time > best_time) {
+      best_index = i;
+      best_time = time;
+    }
+  }
+  if (best_index == TabStripModel::kNoTab) {
+    OpenNewTabInSpace(space_id);
+    return;
+  }
+  model_->ActivateTabAt(best_index,
+                        TabStripUserGestureDetails(
+                            TabStripUserGestureDetails::GestureType::kOther));
+}
+
+void SpacesWindowController::SwitchToSpaceAt(size_t index) {
+  if (index < service_->spaces().size()) {
+    SwitchToSpace(service_->spaces()[index].id);
+  }
+}
+
+void SpacesWindowController::SwitchToRelativeSpace(int delta) {
+  std::optional<size_t> current = service_->GetSpaceIndex(GetVisibleSpaceId());
+  if (!current) {
+    return;
+  }
+  const int target = static_cast<int>(*current) + delta;
+  if (target < 0 || target >= static_cast<int>(service_->spaces().size())) {
+    return;
+  }
+  SwitchToSpaceAt(target);
+}
+
+std::string SpacesWindowController::GetContainerForNewTab() const {
+  if (pending_new_tab_space_) {
+    const Space* space = service_->GetSpace(*pending_new_tab_space_);
+    return space ? space->container_id : std::string();
+  }
+  if (!IsActive()) {
+    return std::string();
+  }
+  if (model_->GetActiveTab()) {
+    return service_->GetSpace(GetVisibleSpaceId())->container_id;
+  }
+  // A new window (Ctrl+N) opens on the space of the window it came from, the
+  // last active one.
+  std::string container_id;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        SpacesWindowController* other = FromBrowser(browser);
+        if (!other || other == this || other->service_ != service_ ||
+            !other->model_ || other->model_->empty()) {
+          return true;
+        }
+        container_id = other->GetContainerForNewTab();
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return container_id;
+}
+
+void SpacesWindowController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (tab_strip_model->closing_all()) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kRemoved && IsActive()) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      if (!IsDeletion(removed.remove_reason) || !removed.contents) {
+        continue;
+      }
+      const std::string& space_id = GetSpaceIdOf(removed.contents.get());
+      if (space_id != last_visible_space_ || SpaceHasTabs(space_id) ||
+          model_->empty()) {
+        continue;
+      }
+      // The model is mid-change: act once it is done.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&SpacesWindowController::OnSpaceTabClosed,
+                         weak_factory_.GetWeakPtr(), space_id,
+                         IsUntouchedNewTabPage(removed.contents.get())));
+    }
+  }
+  if (change.type() == TabStripModelChange::kInserted ||
+      change.type() == TabStripModelChange::kMoved) {
+    ScheduleRepair();
+  }
+  last_visible_space_ = GetVisibleSpaceId();
+}
+
+void SpacesWindowController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  ScheduleRepair();
+}
+
+void SpacesWindowController::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  model_ = nullptr;
+}
+
+void SpacesWindowController::OnSpacesChanged() {
+  ScheduleRepair();
+}
+
+void SpacesWindowController::OnSpaceTabClosed(const std::string& space_id,
+                                              bool was_new_tab_page) {
+  if (!model_ || model_->empty() || model_->closing_all() || !IsActive() ||
+      !service_->GetSpace(space_id) || SpaceHasTabs(space_id)) {
+    return;
+  }
+  if (was_new_tab_page) {
+    SwitchAwayFrom(space_id);
+  } else {
+    OpenNewTabInSpace(space_id);
+  }
+}
+
+void SpacesWindowController::OpenNewTabInSpace(const std::string& space_id) {
+  pending_new_tab_space_ = space_id;
+  chrome::AddTabAt(browser_, GURL(), -1, /*foreground=*/true);
+  pending_new_tab_space_.reset();
+}
+
+void SpacesWindowController::SwitchAwayFrom(const std::string& space_id) {
+  const std::vector<Space>& spaces = service_->spaces();
+  std::optional<size_t> index = service_->GetSpaceIndex(space_id);
+  if (!index) {
+    return;
+  }
+  for (size_t i = *index; i-- > 0;) {
+    if (SpaceHasTabs(spaces[i].id)) {
+      SwitchToSpace(spaces[i].id);
+      return;
+    }
+  }
+  for (size_t i = *index + 1; i < spaces.size(); ++i) {
+    if (SpaceHasTabs(spaces[i].id)) {
+      SwitchToSpace(spaces[i].id);
+      return;
+    }
+  }
+}
+
+bool SpacesWindowController::SpaceHasTabs(const std::string& space_id) const {
+  for (int i = 0; i < model_->count(); ++i) {
+    if (GetSpaceIdOf(model_->GetWebContentsAt(i)) == space_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SpacesWindowController::ScheduleRepair() {
+  if (repair_scheduled_) {
+    return;
+  }
+  repair_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpacesWindowController::RepairContiguity,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SpacesWindowController::RepairContiguity() {
+  repair_scheduled_ = false;
+  if (!model_ || model_->empty() || model_->closing_all() || !IsActive()) {
+    return;
+  }
+  RepairRange(0, model_->IndexOfFirstNonPinnedTab());
+  RepairRange(model_->IndexOfFirstNonPinnedTab(), model_->count());
+  // The moves above scheduled another pass; it finds nothing to do.
+}
+
+void SpacesWindowController::RepairRange(int start, int end) {
+  // Order the tabs by the first appearance of their space, keeping their
+  // relative order within a space. A tab added at the end of the strip thus
+  // joins the end of its space's run.
+  std::vector<std::string> space_order;
+  std::vector<std::pair<size_t, tabs::TabInterface*>> tabs;
+  for (int i = start; i < end; ++i) {
+    tabs::TabInterface* tab = model_->GetTabAtIndex(i);
+    // Moving single tabs could break up a group or a split. Leave those
+    // ranges alone.
+    if (tab->GetGroup().has_value() || tab->IsSplit()) {
+      return;
+    }
+    const std::string& space_id = GetSpaceIdOf(tab);
+    auto it = std::ranges::find(space_order, space_id);
+    if (it == space_order.end()) {
+      it = space_order.insert(space_order.end(), space_id);
+    }
+    tabs.emplace_back(it - space_order.begin(), tab);
+  }
+  std::ranges::stable_sort(tabs, {}, &std::pair<size_t, tabs::TabInterface*>::first);
+  int position = start;
+  for (const auto& [order, tab] : tabs) {
+    const int index = model_->GetIndexOfTab(tab);
+    if (index != position) {
+      model_->MoveWebContentsAt(index, position, /*select_after_move=*/false);
+    }
+    ++position;
+  }
+}
+
