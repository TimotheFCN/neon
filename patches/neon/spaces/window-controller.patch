+#include "chrome/browser/ui/neon/spaces/spaces_window_manager.h"
+
+#include "chrome/browser/neon/spaces/spaces_service.h"
+#include "chrome/browser/neon/spaces/spaces_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/neon/spaces/spaces_window_controller.h"
+
+namespace neon::spaces {
+
+SpacesWindowManager::SpacesWindowManager(Profile* profile,
+                                         SpacesService* service)
+    : profile_(profile), service_(service) {
+  GlobalBrowserCollection* browsers = GlobalBrowserCollection::GetInstance();
+  observation_.Observe(browsers);
+  browsers->ForEach([this](BrowserWindowInterface* browser) {
+    OnBrowserCreated(browser);
+    return true;
+  });
+}
+
+SpacesWindowManager::~SpacesWindowManager() = default;
+
+void SpacesWindowManager::Shutdown() {
+  observation_.Reset();
+  controllers_.clear();
+}
+
+void SpacesWindowManager::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      controllers_.contains(browser)) {
+    return;
+  }
+  controllers_[browser] =
+      std::make_unique<SpacesWindowController>(browser, service_);
+}
+
+void SpacesWindowManager::OnBrowserClosed(BrowserWindowInterface* browser) {
+  controllers_.erase(browser);
+}
+
+// static
+SpacesWindowManagerFactory* SpacesWindowManagerFactory::GetInstance() {
+  static base::NoDestructor<SpacesWindowManagerFactory> instance;
+  return instance.get();
+}
+
+SpacesWindowManagerFactory::SpacesWindowManagerFactory()
+    : ProfileKeyedServiceFactory(
+          "NeonSpacesWindowManager",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .Build()) {
+  DependsOn(SpacesServiceFactory::GetInstance());
+  SpacesWindowController::InstallHooks();
+}
+
+SpacesWindowManagerFactory::~SpacesWindowManagerFactory() = default;
+
+bool SpacesWindowManagerFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+std::unique_ptr<KeyedService>
+SpacesWindowManagerFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return nullptr;
+  }
+  return std::make_unique<SpacesWindowManager>(profile, service);
+}
+
+}  // namespace neon::spaces
