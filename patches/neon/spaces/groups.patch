+void SpacesWindowController::RepairGroupsAndSplits() {
+  if (TabGroupModel* groups = model_->group_model()) {
+    for (const tab_groups::TabGroupId& group : groups->ListTabGroups()) {
+      const std::string space_id = GetSpaceIdOfGroup(group);
+      const gfx::Range range = groups->GetTabGroup(group)->ListTabs();
+      std::vector<int> foreign;
+      for (size_t i = range.start(); i < range.end(); ++i) {
+        if (GetSpaceIdOf(model_->GetTabAtIndex(i)) != space_id) {
+          foreign.push_back(static_cast<int>(i));
+        }
+      }
+      if (!foreign.empty()) {
+        model_->RemoveFromGroup(foreign);
+      }
+    }
+  }
+  for (const split_tabs::SplitTabId& split : model_->ListSplits()) {
+    const std::vector<tabs::TabInterface*> tabs =
+        model_->GetSplitData(split)->ListTabs();
+    if (std::ranges::any_of(tabs, [&](const tabs::TabInterface* tab) {
+          return GetSpaceIdOf(tab) != GetSpaceIdOf(tabs.front());
+        })) {
+      model_->RemoveSplit(split);
+    }
+  }
+}
+
+const std::string& SpacesWindowController::GetSpaceIdOfGroup(
+    const tab_groups::TabGroupId& group) {
+  auto it = group_spaces_.find(group);
+  if (it == group_spaces_.end()) {
+    // A group this controller did not see form, for instance one restored
+    // before it existed: the space of its first tab.
+    const gfx::Range range =
+        model_->group_model()->GetTabGroup(group)->ListTabs();
+    it = group_spaces_
+             .emplace(group, GetSpaceIdOf(model_->GetTabAtIndex(range.start())))
+             .first;
+  }
+  return it->second;
+}
