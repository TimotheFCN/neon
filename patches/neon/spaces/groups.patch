+void SpacesWindowController::SetOpeningSavedGroup(
+    const std::optional<base::Uuid>& saved_group) {
+  opening_group_container_.reset();
+  if (!saved_group) {
+    return;
+  }
+  const base::DictValue& containers =
+      browser_->GetProfile()->GetPrefs()->GetDict(kSavedGroupContainersPref);
+  const std::string* container_id =
+      containers.FindString(saved_group->AsLowercaseString());
+  // A container that no longer exists would create a new, empty partition.
+  if (container_id &&
+      (container_id->empty() ||
+       containers_api::GetContainer(browser_->GetProfile(), *container_id))) {
+    opening_group_container_ = *container_id;
+  }
+}
+
+void SpacesWindowController::RecordSavedGroupContainers() {
+  tab_groups::TabGroupSyncService* sync_service =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+          browser_->GetProfile());
+  TabGroupModel* groups = model_->group_model();
+  if (!sync_service || !groups) {
+    return;
+  }
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  base::DictValue containers = prefs->GetDict(kSavedGroupContainersPref).Clone();
+  for (const tab_groups::TabGroupId& group : groups->ListTabGroups()) {
+    std::optional<tab_groups::SavedTabGroup> saved = sync_service->GetGroup(group);
+    if (!saved) {
+      continue;
+    }
+    const gfx::Range range = groups->GetTabGroup(group)->ListTabs();
+    containers.Set(saved->saved_guid().AsLowercaseString(),
+                   containers_api::GetTabContainerId(
+                       model_->GetWebContentsAt(range.start())));
+  }
+  // Forget groups that are no longer saved.
+  std::set<std::string> saved_ids;
+  for (const tab_groups::SavedTabGroup& saved : sync_service->GetAllGroups()) {
+    saved_ids.insert(saved.saved_guid().AsLowercaseString());
+  }
+  std::vector<std::string> stale;
+  for (const auto [id, value] : containers) {
+    if (!saved_ids.contains(id)) {
+      stale.push_back(id);
+    }
+  }
+  for (const std::string& id : stale) {
+    containers.Remove(id);
+  }
+  if (containers != prefs->GetDict(kSavedGroupContainersPref)) {
+    prefs->SetDict(kSavedGroupContainersPref, std::move(containers));
+  }
+}
