   auto start = tabs::TabCollection::TabIterator(left);
   auto end = ++tabs::TabCollection::TabIterator(right);
 
-  return {start, end};
+  std::vector<tabs::TabInterface*> range(start, end);
+  std::erase_if(range, [this](tabs::TabInterface* tab) {
+    return neon::spaces::IsTabHidden(this, tab);
+  });
+  return range;
 }
 
