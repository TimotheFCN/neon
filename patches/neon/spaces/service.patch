+#ifndef CHROME_BROWSER_NEON_SPACES_SPACE_H_
+#define CHROME_BROWSER_NEON_SPACES_SPACE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace neon::spaces {
+
+// The id of the default space, the one that uses the default storage
+// partition. It always exists and is always first.
+inline constexpr char kDefaultSpaceId[] = "default";
+
+// A space: a page of the sidebar with its own tabs, backed by a container (its
+// own cookies and site storage). The default space has no container.
+struct Space {
+  Space();
+  Space(std::string id,
+        std::string name,
+        std::string icon,
+        SkColor color,
+        std::string container_id);
+  Space(const Space&);
+  Space& operator=(const Space&);
+  Space(Space&&);
+  Space& operator=(Space&&);
+  ~Space();
+
+  bool is_default() const { return id == kDefaultSpaceId; }
+
+  // Stored as a dict in the neon.spaces.list pref.
+  base::DictValue ToDict() const;
+  // Returns std::nullopt if |dict| is not a valid space.
+  static std::optional<Space> FromDict(const base::DictValue& dict);
+
+  bool operator==(const Space&) const;
+
+  // Stable id: kDefaultSpaceId or a lowercase UUID.
+  std::string id;
+  std::string name;
+  // An emoji or the name of an icon. Shown by the switcher (M3).
+  std::string icon;
+  SkColor color = SK_ColorTRANSPARENT;
+  // The container the space's tabs live in. Empty for the default space.
+  std::string container_id;
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_NEON_SPACES_SPACE_H_
