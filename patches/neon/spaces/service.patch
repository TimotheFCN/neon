+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/neon/spaces/spaces_service.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace neon::spaces {
+
+namespace {
+
+Space MakeDefaultSpace() {
+  return Space(kDefaultSpaceId, "Default", std::string(), SK_ColorTRANSPARENT,
+               std::string());
+}
+
+bool IsValidContainerId(std::string_view id) {
+  return !id.empty() && std::ranges::all_of(id, [](char c) {
+    return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-';
+  });
+}
+
+}  // namespace
+
+SpacesService::SpacesService(Profile* profile) : profile_(profile) {
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  pref_change_registrar_.Add(
+      kSpacesListPref,
+      base::BindRepeating(&SpacesService::Load, base::Unretained(this)));
+  containers_api::AddObserver(profile_, this);
+  Load();
+}
+
+SpacesService::~SpacesService() = default;
+
+void SpacesService::Shutdown() {
+  // The containers service shuts down after this one; it must not be reached
+  // from the destructor.
+  containers_api::RemoveObserver(profile_, this);
+  pref_change_registrar_.RemoveAll();
+}
+
+// static
+void SpacesService::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(kSpacesListPref);
+}
+
+const Space* SpacesService::GetSpace(std::string_view id) const {
+  for (const Space& space : spaces_) {
+    if (space.id == id) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+Space* SpacesService::FindSpace(std::string_view id) {
+  return const_cast<Space*>(std::as_const(*this).GetSpace(id));
+}
+
+std::optional<size_t> SpacesService::GetSpaceIndex(std::string_view id) const {
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    if (spaces_[i].id == id) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+const std::string& SpacesService::GetSpaceIdForContainer(
+    std::string_view container_id) const {
+  if (!container_id.empty()) {
+    for (const Space& space : spaces_) {
+      if (space.container_id == container_id) {
+        return space.id;
+      }
+    }
+  }
+  return spaces_.front().id;
+}
+
+std::optional<std::string> SpacesService::CreateSpace(std::string_view name,
+                                                      std::string_view icon,
+                                                      SkColor color) {
+  std::optional<std::string> container_id = containers_api::CreateContainer(
+      profile_, name, SkColorSetA(color, SK_AlphaOPAQUE));
+  if (!container_id) {
+    return std::nullopt;
+  }
+  Space space(base::Uuid::GenerateRandomV4().AsLowercaseString(),
+              std::string(name), std::string(icon), color, *container_id);
+  std::string id = space.id;
+  spaces_.push_back(std::move(space));
+  Save();
+  return id;
+}
+
+bool SpacesService::UpdateSpace(std::string_view id,
+                                std::string_view name,
+                                std::string_view icon,
+                                SkColor color) {
+  Space* space = FindSpace(id);
+  if (!space) {
+    return false;
+  }
+  if (!space->is_default()) {
+    containers_api::UpdateContainer(profile_, space->container_id, name,
+                                    SkColorSetA(color, SK_AlphaOPAQUE));
+  }
+  space->name = std::string(name);
+  space->icon = std::string(icon);
+  space->color = color;
+  Save();
+  return true;
+}
+
+bool SpacesService::MoveSpace(std::string_view id, size_t index) {
+  std::optional<size_t> from = GetSpaceIndex(id);
+  if (!from || *from == 0) {
+    return false;
+  }
+  const size_t to = std::clamp<size_t>(index, 1, spaces_.size() - 1);
+  Space space = std::move(spaces_[*from]);
+  spaces_.erase(spaces_.begin() + *from);
+  spaces_.insert(spaces_.begin() + to, std::move(space));
+  Save();
+  return true;
+}
+
+bool SpacesService::DeleteSpace(std::string_view id) {
+  std::optional<size_t> index = GetSpaceIndex(id);
+  if (!index || *index == 0) {
+    return false;
+  }
+  const std::string container_id = spaces_[*index].container_id;
+  spaces_.erase(spaces_.begin() + *index);
+  Save();
+  containers_api::DeleteContainer(profile_, container_id);
+  return true;
+}
+
+void SpacesService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpacesService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpacesService::OnContainersChanged() {
+  Load();
+}
+
+void SpacesService::Load() {
+  std::vector<Space> spaces;
+  Space default_space = MakeDefaultSpace();
+  std::set<std::string> ids = {kDefaultSpaceId};
+  std::set<std::string> container_ids;
+  const bool containers_available = containers_api::IsAvailable(profile_);
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kSpacesListPref)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    std::optional<Space> space = Space::FromDict(value.GetDict());
+    if (!space) {
+      continue;
+    }
+    if (space->is_default()) {
+      // Keeps the user's name, icon and colour; the default space always uses
+      // the default partition.
+      default_space.name = space->name;
+      default_space.icon = space->icon;
+      default_space.color = space->color;
+      continue;
+    }
+    // A space needs a container that exists. Without containers (feature off)
+    // only the default space is left.
+    if (!containers_available || ids.contains(space->id) ||
+        !IsValidContainerId(space->container_id) ||
+        container_ids.contains(space->container_id) ||
+        !containers_api::GetContainer(profile_, space->container_id)) {
+      continue;
+    }
+    ids.insert(space->id);
+    container_ids.insert(space->container_id);
+    spaces.push_back(std::move(*space));
+  }
+  spaces.insert(spaces.begin(), std::move(default_space));
+
+  if (spaces == spaces_) {
+    return;
+  }
+  spaces_ = std::move(spaces);
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}
+
+void SpacesService::Save() {
+  base::ListValue list;
+  for (const Space& space : spaces_) {
+    list.Append(space.ToDict());
+  }
+  // Writing the pref calls Load(), which finds the list it already has.
+  profile_->GetPrefs()->SetList(kSpacesListPref, std::move(list));
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+}
+
+}  // namespace neon::spaces
