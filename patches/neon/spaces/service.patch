+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/neon/spaces/space.h"
+
+#include <utility>
+
+namespace neon::spaces {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kIconKey[] = "icon";
+constexpr char kColorKey[] = "color";
+constexpr char kContainerIdKey[] = "container_id";
+
+}  // namespace
+
+Space::Space() = default;
+Space::Space(std::string id,
+             std::string name,
+             std::string icon,
+             SkColor color,
+             std::string container_id)
+    : id(std::move(id)),
+      name(std::move(name)),
+      icon(std::move(icon)),
+      color(color),
+      container_id(std::move(container_id)) {}
+Space::Space(const Space&) = default;
+Space& Space::operator=(const Space&) = default;
+Space::Space(Space&&) = default;
+Space& Space::operator=(Space&&) = default;
+Space::~Space() = default;
+
+bool Space::operator==(const Space&) const = default;
+
+base::DictValue Space::ToDict() const {
+  base::DictValue dict;
+  dict.Set(kIdKey, id);
+  dict.Set(kNameKey, name);
+  dict.Set(kIconKey, icon);
+  // Stored as a signed int, like Brave's containers background_color.
+  dict.Set(kColorKey, static_cast<int>(color));
+  dict.Set(kContainerIdKey, container_id);
+  return dict;
+}
+
+// static
+std::optional<Space> Space::FromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString(kIdKey);
+  if (!id || id->empty()) {
+    return std::nullopt;
+  }
+  Space space;
+  space.id = *id;
+  if (const std::string* name = dict.FindString(kNameKey)) {
+    space.name = *name;
+  }
+  if (const std::string* icon = dict.FindString(kIconKey)) {
+    space.icon = *icon;
+  }
+  if (std::optional<int> color = dict.FindInt(kColorKey)) {
+    space.color = static_cast<SkColor>(*color);
+  }
+  if (const std::string* container_id = dict.FindString(kContainerIdKey)) {
+    space.container_id = *container_id;
+  }
+  return space;
+}
+
+}  // namespace neon::spaces
