+#ifndef CHROME_BROWSER_NEON_SPACES_SPACES_SERVICE_H_
+#define CHROME_BROWSER_NEON_SPACES_SPACES_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/neon/containers_api.h"
+#include "chrome/browser/neon/spaces/space.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace neon::spaces {
+
+// Profile pref: the ordered space list, a list of Space dicts. The first entry
+// is the default space. Local to the device, not synced.
+inline constexpr char kSpacesListPref[] = "neon.spaces.list";
+
+// The ordered list of spaces of a profile. Each space but the default one owns
+// a container. A tab belongs to the space of its container, see
+// GetSpaceIdForContainer(). Exists for regular profiles only, so incognito has
+// no spaces.
+class SpacesService : public KeyedService,
+                      public containers_api::Observer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The list, the order or a space's name, icon or colour changed.
+    virtual void OnSpacesChanged() = 0;
+  };
+
+  explicit SpacesService(Profile* profile);
+  SpacesService(const SpacesService&) = delete;
+  SpacesService& operator=(const SpacesService&) = delete;
+  ~SpacesService() override;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // The spaces in display order. Never empty: the default space comes first.
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const Space* GetSpace(std::string_view id) const;
+  // The position of space |id| in spaces(), or std::nullopt.
+  std::optional<size_t> GetSpaceIndex(std::string_view id) const;
+
+  // The space whose container is |container_id|. The default partition (empty
+  // id) and containers that no space uses map to the default space.
+  const std::string& GetSpaceIdForContainer(
+      std::string_view container_id) const;
+
+  // Adds a space at the end with a new container of its own. Returns its id,
+  // or std::nullopt if the container could not be created (blank name).
+  std::optional<std::string> CreateSpace(std::string_view name,
+                                         std::string_view icon,
+                                         SkColor color);
+  // Changes a space's name, icon and colour. Returns false if it does not
+  // exist.
+  bool UpdateSpace(std::string_view id,
+                   std::string_view name,
+                   std::string_view icon,
+                   SkColor color);
+  // Moves space |id| to |index|. The default space stays first, so |index| is
+  // clamped to 1 or more. Returns false if |id| is unknown or the default.
+  bool MoveSpace(std::string_view id, size_t index);
+  // Removes space |id| and its container. The default space cannot be
+  // removed. Close the space's tabs first: tabs left open fall back to the
+  // default space, and the container's storage is deleted at a later start
+  // once nothing uses it.
+  bool DeleteSpace(std::string_view id);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  // containers_api::Observer:
+  void OnContainersChanged() override;
+
+  // Reads the pref into |spaces_| and notifies observers if it changed.
+  void Load();
+  void Save();
+  Space* FindSpace(std::string_view id);
+
+  raw_ptr<Profile> profile_;
+  std::vector<Space> spaces_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_NEON_SPACES_SPACES_SERVICE_H_
