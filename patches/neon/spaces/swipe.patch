+#ifndef CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_TRACKER_H_
+#define CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_TRACKER_H_
+
+#include <optional>
+
+#include "base/containers/circular_deque.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace neon::spaces {
+
+// Finger tracking for the two-finger swipe between spaces, independent of
+// where the events come from. A platform adapter feeds it scroll deltas and,
+// when the platform has them, the phase of the gesture. It locks each gesture
+// to an axis: a mostly vertical gesture is left alone (the tab list scrolls),
+// a horizontal one drags the pages.
+//
+// The end of a gesture comes from the platform when it says so: a lift
+// (macOS phases; on Linux a fling start, which Wayland sends on axis stop and
+// Chromium's X11 code makes of the zero scroll libinput sends at lift; or a
+// native tracker on macOS). Without one (X11 drivers that send no zero scroll,
+// wheels) the gesture ends after a short quiet period, and once a lift has
+// ended a gesture the tracker trusts lifts from then on.
+class SpacesSwipeTracker {
+ public:
+  enum class Phase {
+    // A delta without phase information.
+    kUnknown,
+    // Fingers touched the touchpad (macOS "may begin", Wayland hold).
+    kMayBegin,
+    // A delta while the fingers are known to be down.
+    kChanged,
+    // Momentum after the fingers lifted (macOS inertial scrolling).
+    kMomentum,
+    // The momentum ended.
+    kMomentumEnded,
+  };
+
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+    // Whether a horizontal gesture may move the pages now.
+    virtual bool CanSwipe() = 0;
+    virtual void BeginSwipe() = 0;
+    // |distance| in DIPs since BeginSwipe(), positive when the fingers moved
+    // right.
+    virtual void UpdateSwipe(float distance) = 0;
+    // |velocity| in DIPs per second, positive to the right.
+    virtual void EndSwipe(float velocity) = 0;
+  };
+
+  // Axis lock distance, as Chromium's focus mode swipe.
+  static constexpr float kAxisLockThreshold = 15.0f;
+  // Without lift events, a gesture ends this long after its last event.
+  static constexpr base::TimeDelta kQuietTimeout = base::Milliseconds(120);
+  // With lift events, a gesture that sends nothing for this long is over
+  // anyway (a lost lift).
+  static constexpr base::TimeDelta kLostLiftTimeout = base::Seconds(3);
+  // The release velocity is measured over this window before the last event.
+  static constexpr base::TimeDelta kVelocityWindow = base::Milliseconds(100);
+
+  explicit SpacesSwipeTracker(Delegate* delegate);
+  SpacesSwipeTracker(const SpacesSwipeTracker&) = delete;
+  SpacesSwipeTracker& operator=(const SpacesSwipeTracker&) = delete;
+  ~SpacesSwipeTracker();
+
+  // A scroll delta in DIPs, positive when the fingers move right or down
+  // (content follows the fingers). Returns true when the event belongs to a
+  // horizontal swipe and must not reach other views.
+  bool OnScroll(base::TimeTicks time, float dx, float dy, Phase phase);
+
+  // The fingers lifted. |velocity| is the platform's release velocity in DIPs
+  // per second, if it has one. Returns true if a swipe consumed it.
+  bool OnLift(base::TimeTicks time, std::optional<float> velocity);
+
+  bool is_tracking() const { return state_ == State::kTracking; }
+  // Whether lifts are known to arrive (seen once, or the platform always
+  // sends them), so quiet periods no longer end gestures.
+  bool trusts_lifts() const { return trusts_lifts_; }
+  void set_trusts_lifts(bool trusts_lifts) { trusts_lifts_ = trusts_lifts; }
+
+ private:
+  enum class State {
+    kIdle,
+    // Locked to the vertical axis: events pass through until the gesture
+    // ends.
+    kVertical,
+    // Locked to the horizontal axis but the pages cannot move (a tab drag):
+    // events pass through.
+    kIgnored,
+    kTracking,
+    // The swipe ended; momentum events of the same gesture are swallowed.
+    kEnded,
+  };
+
+  void Reset();
+  void EndTracking(std::optional<float> velocity);
+  void OnTimeout();
+  void ArmTimer();
+  float EstimateVelocity() const;
+
+  const raw_ptr<Delegate> delegate_;
+  State state_ = State::kIdle;
+  float total_x_ = 0;
+  float total_y_ = 0;
+  // Horizontal distance at the moment of the axis lock, so the pages start
+  // from where the fingers are instead of jumping by the lock distance.
+  float lock_x_ = 0;
+  base::TimeTicks last_event_;
+  bool trusts_lifts_ = false;
+  struct Sample {
+    base::TimeTicks time;
+    float x;
+  };
+  base::circular_deque<Sample> samples_;
+  base::OneShotTimer timer_;
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_TRACKER_H_
