+namespace neon::spaces {
+
+class SpacesPagerView;
+
+// Turns the scroll and wheel events that reach the sidebar into swipes of the
+// pager. Installed by the pager as a pre-target handler on the tab strip
+// region, so it sees every scroll over the sidebar before the tab list does.
+//
+// - Touchpad scrolls (ui::ScrollEvent) drive SpacesSwipeTracker, which locks
+//   the axis and tracks the fingers. On macOS the momentum phase tells when
+//   fingers touch and lift; Wayland signals the lift with a fling start; X11
+//   has neither, so the tracker ends a gesture after a quiet period.
+// - A notched mouse wheel scrolled sideways (or with Shift) turns one page
+//   per notch with the page animation; smooth wheels are tracked like a
+//   touchpad.
+//
+// A macOS-only patch can feed SpacesSwipeTracker from the native event
+// (NSEvent phases, -trackSwipeEventWithOptions:) instead, without changes to
+// the pager: everything it needs is OnScroll(), OnLift() and the delegate.
+class SpacesSwipeHandler : public ui::EventHandler,
+                           public SpacesSwipeTracker::Delegate {
+ public:
+  explicit SpacesSwipeHandler(SpacesPagerView* pager);
+  SpacesSwipeHandler(const SpacesSwipeHandler&) = delete;
+  SpacesSwipeHandler& operator=(const SpacesSwipeHandler&) = delete;
+  ~SpacesSwipeHandler() override;
+
+  SpacesSwipeTracker& tracker() { return tracker_; }
+
+  // ui::EventHandler:
+  void OnScrollEvent(ui::ScrollEvent* event) override;
+  void OnMouseEvent(ui::MouseEvent* event) override;
+
+  // SpacesSwipeTracker::Delegate:
+  bool CanSwipe() override;
+  void BeginSwipe() override;
+  void UpdateSwipe(float distance) override;
+  void EndSwipe(float velocity) override;
+
+ private:
+  const raw_ptr<SpacesPagerView> pager_;
+  SpacesSwipeTracker tracker_{this};
+  // The time of the last scroll event: an unhandled scroll event comes back
+  // as a wheel event with the same time, which must not count twice.
+  base::TimeTicks last_scroll_time_;
+  // macOS: whether the current gesture went into momentum.
+  bool saw_momentum_ = false;
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_HANDLER_H_
