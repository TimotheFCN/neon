+#ifndef CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_HANDLER_H_
+#define CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACES_SWIPE_HANDLER_H_
