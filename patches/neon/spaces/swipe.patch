+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/neon/spaces/spaces_swipe_handler.h"
+
+#include <cmath>
+#include <cstdlib>
+
+#include "base/i18n/rtl.h"
+#include "build/build_config.h"
+#include "chrome/browser/ui/neon/spaces/spaces_window_controller.h"
+#include "chrome/browser/ui/views/neon/spaces/spaces_pager_view.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+
+namespace neon::spaces {
+
+SpacesSwipeHandler::SpacesSwipeHandler(SpacesPagerView* pager)
+    : pager_(pager) {
+#if BUILDFLAG(IS_MAC)
+  // Every macOS trackpad gesture ends with a phase.
+  tracker_.set_trusts_lifts(true);
+#endif
+}
+
+SpacesSwipeHandler::~SpacesSwipeHandler() = default;
+
+void SpacesSwipeHandler::OnScrollEvent(ui::ScrollEvent* event) {
+  if (!pager_->IsActive()) {
+    return;
+  }
+  const base::TimeTicks time = event->time_stamp();
+  bool consumed = false;
+  switch (event->type()) {
+    case ui::EventType::kScrollFlingStart:
+      // The fingers lifted. Wayland gives the release velocity; X11 sends a
+      // scroll of zero (libinput's scroll stop), and the tracker measures it.
+      consumed = tracker_.OnLift(
+          time, event->x_offset() != 0 || event->y_offset() != 0
+                    ? std::optional<float>(event->x_offset())
+                    : std::nullopt);
+      break;
+    case ui::EventType::kScrollFlingCancel:
+      // Fingers down on the touchpad.
+      tracker_.OnScroll(time, 0, 0, SpacesSwipeTracker::Phase::kMayBegin);
+      break;
+    case ui::EventType::kScroll: {
+      last_scroll_time_ = time;
+      SpacesSwipeTracker::Phase phase = SpacesSwipeTracker::Phase::kUnknown;
+#if BUILDFLAG(IS_MAC)
+      switch (event->momentum_phase()) {
+        case ui::EventMomentumPhase::MAY_BEGIN:
+          saw_momentum_ = false;
+          phase = SpacesSwipeTracker::Phase::kMayBegin;
+          break;
+        case ui::EventMomentumPhase::NONE:
+          phase = SpacesSwipeTracker::Phase::kChanged;
+          break;
+        case ui::EventMomentumPhase::END:
+          if (!saw_momentum_) {
+            // An end before any momentum is the lift.
+            consumed = tracker_.OnLift(time, std::nullopt);
+            if (consumed) {
+              event->SetHandled();
+              event->StopPropagation();
+            }
+            return;
+          }
+          saw_momentum_ = false;
+          phase = SpacesSwipeTracker::Phase::kMomentumEnded;
+          break;
+        case ui::EventMomentumPhase::INERTIAL_UPDATE:
+        case ui::EventMomentumPhase::BLOCKED:
+          saw_momentum_ = true;
+          phase = SpacesSwipeTracker::Phase::kMomentum;
+          break;
+      }
+#endif
+      consumed =
+          tracker_.OnScroll(time, event->x_offset(), event->y_offset(), phase);
+      break;
+    }
+    default:
+      return;
+  }
+  if (consumed) {
+    event->SetHandled();
+    event->StopPropagation();
+  }
+}
+
+void SpacesSwipeHandler::OnMouseEvent(ui::MouseEvent* event) {
+  if (!event->IsMouseWheelEvent() || !pager_->IsActive()) {
+    return;
+  }
+  const base::TimeTicks time = event->time_stamp();
+  if (time == last_scroll_time_) {
+    // A scroll event nobody handled, seen already.
+    return;
+  }
+  ui::MouseWheelEvent* wheel = event->AsMouseWheelEvent();
+  int dx = wheel->x_offset();
+  int dy = wheel->y_offset();
+  if (dx == 0 && wheel->IsShiftDown()) {
+    // Shift turns the wheel sideways.
+    dx = dy;
+    dy = 0;
+  }
+  if (dx == 0 || std::abs(dy) > std::abs(dx)) {
+    return;
+  }
+  bool consumed = false;
+  if (dx % ui::MouseWheelEvent::kWheelDelta == 0) {
+    // A notched wheel: one page per notch, animated. Scrolling left shows
+    // the space on the left.
+    if (pager_->CanDrag() && !tracker_.is_tracking() && pager_->controller()) {
+      const int notches = dx / ui::MouseWheelEvent::kWheelDelta;
+      const int direction = base::i18n::IsRTL() ? 1 : -1;
+      for (int i = 0; i < std::abs(notches); ++i) {
+        pager_->controller()->SwitchToRelativeSpace(
+            notches > 0 ? direction : -direction);
+      }
+    }
+    consumed = true;
+  } else {
+    // A smooth wheel: track it like a touchpad without phases.
+    consumed = tracker_.OnScroll(time, dx, dy,
+                                 SpacesSwipeTracker::Phase::kUnknown);
+  }
+  if (consumed) {
+    event->SetHandled();
+    event->StopPropagation();
+  }
+}
+
+bool SpacesSwipeHandler::CanSwipe() {
+  return pager_->CanDrag();
+}
+
+void SpacesSwipeHandler::BeginSwipe() {
+  pager_->BeginDrag();
+}
+
+void SpacesSwipeHandler::UpdateSwipe(float distance) {
+  pager_->UpdateDrag(distance);
+}
+
+void SpacesSwipeHandler::EndSwipe(float velocity) {
+  pager_->EndDrag(velocity);
+}
+
+}  // namespace neon::spaces
