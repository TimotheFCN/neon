+// Copyright 2026 The Neon Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/neon/spaces/spaces_swipe_tracker.h"
+
+#include <cmath>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+
+namespace neon::spaces {
+
+SpacesSwipeTracker::SpacesSwipeTracker(Delegate* delegate)
+    : delegate_(delegate) {
+  CHECK(delegate_);
+}
+
+SpacesSwipeTracker::~SpacesSwipeTracker() = default;
+
+void SpacesSwipeTracker::Reset() {
+  state_ = State::kIdle;
+  total_x_ = 0;
+  total_y_ = 0;
+  lock_x_ = 0;
+  samples_.clear();
+  timer_.Stop();
+}
+
+void SpacesSwipeTracker::ArmTimer() {
+  timer_.Start(FROM_HERE, trusts_lifts_ ? kLostLiftTimeout : kQuietTimeout,
+               base::BindOnce(&SpacesSwipeTracker::OnTimeout,
+                              base::Unretained(this)));
+}
+
+void SpacesSwipeTracker::OnTimeout() {
+  if (state_ == State::kTracking) {
+    // No lift signal: the fingers stopped, so the gesture is over.
+    EndTracking(std::nullopt);
+  }
+  Reset();
+}
+
+float SpacesSwipeTracker::EstimateVelocity() const {
+  if (samples_.size() < 2) {
+    return 0;
+  }
+  const Sample& last = samples_.back();
+  const Sample* first = &samples_.front();
+  for (const Sample& sample : samples_) {
+    if (last.time - sample.time <= kVelocityWindow) {
+      first = &sample;
+      break;
+    }
+  }
+  const double seconds = (last.time - first->time).InSecondsF();
+  if (seconds < 0.008) {
+    return 0;
+  }
+  return static_cast<float>((last.x - first->x) / seconds);
+}
+
+void SpacesSwipeTracker::EndTracking(std::optional<float> velocity) {
+  CHECK_EQ(state_, State::kTracking);
+  state_ = State::kEnded;
+  delegate_->EndSwipe(velocity.value_or(EstimateVelocity()));
+}
+
+bool SpacesSwipeTracker::OnScroll(base::TimeTicks time,
+                                  float dx,
+                                  float dy,
+                                  Phase phase) {
+  switch (phase) {
+    case Phase::kMayBegin:
+      // Fingers down: a new gesture.
+      if (state_ == State::kTracking) {
+        EndTracking(0);
+      }
+      Reset();
+      last_event_ = time;
+      return false;
+    case Phase::kMomentum:
+    case Phase::kMomentumEnded: {
+      // Momentum belongs to the gesture that just ended: swallow it after a
+      // swipe so the tab list does not scroll.
+      const bool swallow =
+          state_ == State::kEnded || state_ == State::kTracking;
+      if (state_ == State::kTracking) {
+        EndTracking(std::nullopt);
+      }
+      last_event_ = time;
+      if (phase == Phase::kMomentumEnded) {
+        Reset();
+      } else {
+        ArmTimer();
+      }
+      return swallow;
+    }
+    case Phase::kUnknown:
+    case Phase::kChanged:
+      break;
+  }
+
+  // Deltas. After a swipe ended, or after a pause, they start a new gesture.
+  if (state_ == State::kEnded ||
+      (state_ != State::kTracking && !last_event_.is_null() &&
+       time - last_event_ > kQuietTimeout && phase == Phase::kUnknown)) {
+    Reset();
+  }
+  last_event_ = time;
+
+  switch (state_) {
+    case State::kVertical:
+    case State::kIgnored:
+    case State::kEnded:
+      ArmTimer();
+      return false;
+    case State::kIdle: {
+      total_x_ += dx;
+      total_y_ += dy;
+      const float ax = std::abs(total_x_);
+      const float ay = std::abs(total_y_);
+      if (ay >= kAxisLockThreshold && ay > ax) {
+        state_ = State::kVertical;
+      } else if (ax >= kAxisLockThreshold && ax > ay) {
+        if (!delegate_->CanSwipe()) {
+          state_ = State::kIgnored;
+        } else {
+          state_ = State::kTracking;
+          lock_x_ = std::copysign(kAxisLockThreshold, total_x_);
+          samples_.clear();
+          samples_.push_back({time, total_x_ - lock_x_});
+          delegate_->BeginSwipe();
+          delegate_->UpdateSwipe(total_x_ - lock_x_);
+          ArmTimer();
+          return true;
+        }
+      }
+      ArmTimer();
+      return false;
+    }
+    case State::kTracking:
+      total_x_ += dx;
+      total_y_ += dy;
+      samples_.push_back({time, total_x_ - lock_x_});
+      while (samples_.size() > 2 &&
+             samples_.back().time - samples_.front().time >
+                 2 * kVelocityWindow) {
+        samples_.pop_front();
+      }
+      delegate_->UpdateSwipe(total_x_ - lock_x_);
+      ArmTimer();
+      return true;
+  }
+  return false;
+}
+
+bool SpacesSwipeTracker::OnLift(base::TimeTicks time,
+                                std::optional<float> velocity) {
+  // A lift that ends a gesture shows the platform sends lifts. (X11 also
+  // reports the first scroll after start as a lift, outside any gesture.)
+  if (state_ != State::kIdle || total_x_ != 0 || total_y_ != 0) {
+    trusts_lifts_ = true;
+  }
+  last_event_ = time;
+  if (state_ == State::kTracking) {
+    EndTracking(velocity);
+    ArmTimer();
+    return true;
+  }
+  const bool swallow = state_ == State::kEnded;
+  Reset();
+  return swallow;
+}
+
+}  // namespace neon::spaces
