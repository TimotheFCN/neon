+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/neon/spaces/space.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/neon/spaces/spaces_window_controller.h"
+#include "chrome/browser/ui/views/neon/spaces/space_icon_view.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
