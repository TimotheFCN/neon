+class SpaceIconView;
+
+// The row of space icons at the bottom of the sidebar pager, one button per
+// space in order. The visible space's icon sits on a highlight that slides
+// with the pages, so during a swipe or an animated switch it moves between
+// icons as the pages move. A click shows that space.
+//
+// When the icons do not fit (the collapsed sidebar), the row shows only the
+// visible space's icon, which opens a menu of the spaces. The trailing end is
+// kept free for the "new space" button of space management (M4).
+class SpaceSwitcherRow : public views::View,
+                         public SpacesPagerView::Observer,
+                         public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(SpaceSwitcherRow, views::View)
+
+ public:
+  explicit SpaceSwitcherRow(SpacesPagerView* pager);
+  SpaceSwitcherRow(const SpaceSwitcherRow&) = delete;
+  SpaceSwitcherRow& operator=(const SpaceSwitcherRow&) = delete;
+  ~SpaceSwitcherRow() override;
+
+  // Whether only the visible space's icon shows (the icons do not fit).
+  bool IsCompact() const;
+
+  // views::View:
+  void Layout(PassKey) override;
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // SpacesPagerView::Observer:
+  void OnPagerPositionChanged(const std::vector<std::string>& strip,
+                              double position) override;
+  void OnPagerSpacesChanged() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdChecked(int command_id) const override;
+
+ private:
+  class SpaceButton;
+
+  void Rebuild();
+  void OnButtonPressed(const std::string& space_id);
+  void ShowMenu();
+  // The space the row shows as current at the pager's position.
+  std::string GetShownSpaceId() const;
+  // The highlight's bounds at the pager's position, or nullopt when hidden.
+  std::optional<gfx::RectF> GetHighlightBounds() const;
+  SpaceButton* GetButton(const std::string& space_id) const;
+  int GetIconsWidth() const;
+
+  const raw_ptr<SpacesPagerView> pager_;
+  std::vector<raw_ptr<SpaceButton>> buttons_;
+  // Compact mode: the visible space's icon, which opens the menu.
+  raw_ptr<SpaceButton> compact_button_ = nullptr;
+  std::vector<std::string> strip_;
+  double position_ = 0;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  base::ScopedObservation<SpacesPagerView, SpacesPagerView::Observer>
+      pager_observation_{this};
+};
+
+}  // namespace neon::spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_NEON_SPACES_SPACE_SWITCHER_ROW_H_
