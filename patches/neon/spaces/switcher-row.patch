+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/animation/ink_drop_host.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/highlight_path_generator.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/widget/widget.h"
+
+namespace neon::spaces {
+
+namespace {
+
+constexpr int kRowHeight = 36;
+constexpr int kButtonSize = 28;
+constexpr int kIconSize = 18;
+constexpr int kButtonSpacing = 4;
+constexpr int kCornerRadius = 8;
+constexpr int kMenuIconSize = 16;
+// Kept free at the trailing end for the "new space" button (M4), and the
+// same at the leading end so the icons stay centred.
+constexpr int kReservedWidth = kButtonSize + kButtonSpacing;
+
+}  // namespace
+
+class SpaceSwitcherRow::SpaceButton : public views::Button {
+  METADATA_HEADER(SpaceButton, views::Button)
+
+ public:
+  SpaceButton(PressedCallback callback, std::string space_id)
+      : views::Button(std::move(callback)), space_id_(std::move(space_id)) {
+    icon_ = AddChildView(std::make_unique<SpaceIconView>(kIconSize));
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCornerRadius);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InkDrop::Get(this)->SetBaseColor(
+        kColorTabForegroundActiveFrameActive);
+    SetHasInkDropActionOnClick(true);
+  }
+
+  const std::string& space_id() const { return space_id_; }
+
+  void SetSpace(const Space& space) {
+    space_id_ = space.id;
+    icon_->SetSpace(space);
+    const std::u16string name = base::UTF8ToUTF16(space.name);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+  }
+
+  void SetEmphasized(bool emphasized) { icon_->SetEmphasized(emphasized); }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kButtonSize, kButtonSize);
+  }
+  void Layout(PassKey) override { icon_->SetBoundsRect(GetLocalBounds()); }
+
+ private:
+  std::string space_id_;
+  raw_ptr<SpaceIconView> icon_;
+};
+
+BEGIN_METADATA(SpaceSwitcherRow, SpaceButton)
+END_METADATA
+
+SpaceSwitcherRow::SpaceSwitcherRow(SpacesPagerView* pager) : pager_(pager) {
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(u"Spaces");
+  pager_observation_.Observe(pager_);
+  Rebuild();
+}
+
+SpaceSwitcherRow::~SpaceSwitcherRow() = default;
+
+void SpaceSwitcherRow::Rebuild() {
+  for (raw_ptr<SpaceButton>& button : buttons_) {
+    RemoveChildViewT(std::exchange(button, nullptr));
+  }
+  buttons_.clear();
+  if (compact_button_) {
+    RemoveChildViewT(std::exchange(compact_button_, nullptr));
+  }
+  menu_runner_.reset();
+  menu_model_.reset();
+
+  const bool active = pager_->IsActive();
+  SetVisible(active);
+  if (active) {
+    for (const Space& space :
+         pager_->controller()->service()->spaces()) {
+      auto button = std::make_unique<SpaceButton>(
+          base::BindRepeating(&SpaceSwitcherRow::OnButtonPressed,
+                              base::Unretained(this), space.id),
+          space.id);
+      button->SetSpace(space);
+      buttons_.push_back(AddChildView(std::move(button)));
+    }
+    compact_button_ = AddChildView(std::make_unique<SpaceButton>(
+        base::BindRepeating(&SpaceSwitcherRow::ShowMenu,
+                            base::Unretained(this)),
+        std::string()));
+  }
+  strip_ = pager_->strip();
+  position_ = pager_->position();
+  PreferredSizeChanged();
+  InvalidateLayout();
+  OnPagerPositionChanged(strip_, position_);
+}
+
+int SpaceSwitcherRow::GetIconsWidth() const {
+  const int count = static_cast<int>(buttons_.size());
+  return count * kButtonSize + std::max(0, count - 1) * kButtonSpacing;
+}
+
+bool SpaceSwitcherRow::IsCompact() const {
+  return GetIconsWidth() + 2 * kReservedWidth > width();
+}
+
+void SpaceSwitcherRow::Layout(PassKey) {
+  const bool compact = IsCompact();
+  const int y = (height() - kButtonSize) / 2;
+  int x = (width() - GetIconsWidth()) / 2;
+  for (SpaceButton* button : buttons_) {
+    button->SetVisible(!compact);
+    button->SetBounds(x, y, kButtonSize, kButtonSize);
+    x += kButtonSize + kButtonSpacing;
+  }
+  if (compact_button_) {
+    compact_button_->SetVisible(compact);
+    compact_button_->SetBounds((width() - kButtonSize) / 2, y, kButtonSize,
+                               kButtonSize);
+  }
+  OnPagerPositionChanged(strip_, position_);
+}
+
+gfx::Size SpaceSwitcherRow::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(GetIconsWidth() + 2 * kReservedWidth, kRowHeight);
+}
+
+std::string SpaceSwitcherRow::GetShownSpaceId() const {
+  if (strip_.empty()) {
+    return std::string();
+  }
+  const int index =
+      std::clamp(static_cast<int>(std::lround(position_)), 0,
+                 static_cast<int>(strip_.size()) - 1);
+  return strip_[index];
+}
+
+SpaceSwitcherRow::SpaceButton* SpaceSwitcherRow::GetButton(
+    const std::string& space_id) const {
+  for (SpaceButton* button : buttons_) {
+    if (button->space_id() == space_id) {
+      return button;
+    }
+  }
+  return nullptr;
+}
+
+std::optional<gfx::RectF> SpaceSwitcherRow::GetHighlightBounds() const {
+  if (strip_.empty()) {
+    return std::nullopt;
+  }
+  if (IsCompact()) {
+    return compact_button_
+               ? std::optional<gfx::RectF>(
+                     gfx::RectF(compact_button_->GetMirroredBounds()))
+               : std::nullopt;
+  }
+  // Between the icons of the two spaces on screen, in proportion to how far
+  // the pages moved.
+  const double last = static_cast<double>(strip_.size()) - 1;
+  const double position = std::clamp(position_, 0.0, last);
+  const int from = static_cast<int>(std::floor(position));
+  const int to = static_cast<int>(std::ceil(position));
+  SpaceButton* from_button = GetButton(strip_[from]);
+  SpaceButton* to_button = GetButton(strip_[to]);
+  if (!from_button || !to_button) {
+    return std::nullopt;
+  }
+  const gfx::RectF a(from_button->GetMirroredBounds());
+  const gfx::RectF b(to_button->GetMirroredBounds());
+  const float t = static_cast<float>(position - from);
+  return gfx::RectF(a.x() + (b.x() - a.x()) * t, a.y(), a.width(),
+                    a.height());
+}
+
+void SpaceSwitcherRow::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  std::optional<gfx::RectF> highlight = GetHighlightBounds();
+  if (!highlight || !GetColorProvider()) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(
+      GetColorProvider()->GetColor(kColorTabBackgroundActiveFrameActive));
+  canvas->DrawRoundRect(*highlight, kCornerRadius, flags);
+}
+
+void SpaceSwitcherRow::OnPagerPositionChanged(
+    const std::vector<std::string>& strip,
+    double position) {
+  strip_ = strip;
+  position_ = position;
+  const std::string shown = GetShownSpaceId();
+  for (SpaceButton* button : buttons_) {
+    button->SetEmphasized(button->space_id() == shown);
+  }
+  if (compact_button_) {
+    if (const Space* space =
+            pager_->controller()
+                ? pager_->controller()->service()->GetSpace(shown)
+                : nullptr) {
+      compact_button_->SetSpace(*space);
+    }
+  }
+  SchedulePaint();
+}
+
+void SpaceSwitcherRow::OnPagerSpacesChanged() {
+  Rebuild();
+}
+
+void SpaceSwitcherRow::OnButtonPressed(const std::string& space_id) {
+  pager_->ShowSpace(space_id);
+}
+
+void SpaceSwitcherRow::ShowMenu() {
+  if (!pager_->controller()) {
+    return;
+  }
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  const std::vector<Space>& spaces = pager_->controller()->service()->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    menu_model_->AddCheckItem(static_cast<int>(i),
+                              base::UTF8ToUTF16(spaces[i].name));
+    menu_model_->SetIcon(menu_model_->GetItemCount() - 1,
+                         GetSpaceIconImage(spaces[i], kMenuIconSize));
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                          compact_button_->GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kMouse);
+}
+
+void SpaceSwitcherRow::ExecuteCommand(int command_id, int event_flags) {
+  if (!pager_->controller()) {
+    return;
+  }
+  const std::vector<Space>& spaces = pager_->controller()->service()->spaces();
+  if (command_id >= 0 && command_id < static_cast<int>(spaces.size())) {
+    pager_->ShowSpace(spaces[command_id].id);
+  }
+}
+
+bool SpaceSwitcherRow::IsCommandIdChecked(int command_id) const {
+  if (!pager_->controller()) {
+    return false;
+  }
+  const std::vector<Space>& spaces = pager_->controller()->service()->spaces();
+  return command_id >= 0 && command_id < static_cast<int>(spaces.size()) &&
+         spaces[command_id].id == pager_->GetVisibleSpaceId();
+}
+
+BEGIN_METADATA(SpaceSwitcherRow)
+END_METADATA
+
+}  // namespace neon::spaces
