+void ForgetContainerInClosedTabs(Profile* profile, std::string_view id) {
+  if (!GetService(profile) || id.empty()) {
+    return;
+  }
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+  if (service->IsLoaded()) {
+    ClosedTabsForgetter::Forget(service, std::string(id));
+    return;
+  }
+  new ClosedTabsForgetter(service, std::string(id));
+  service->LoadTabsFromLastSession();
+}
