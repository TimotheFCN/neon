+views::Widget* ShowSpaceEditBubble(views::View* anchor,
+                                   Profile* profile,
+                                   const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  const Space* space = service ? service->GetSpace(space_id) : nullptr;
+  if (!anchor || !anchor->GetWidget() || !space) {
+    return nullptr;
+  }
+  if (views::View* current = CurrentEditView().view();
+      current && current->GetWidget()) {
+    current->GetWidget()->CloseNow();
+  }
+
+  auto view = std::make_unique<SpaceEditView>(profile, *space);
+  views::Textfield* name_field = view->name_field();
+  CurrentEditView().SetView(view.get());
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(u"Edit space")
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(view),
+                  views::BubbleDialogModelHost::FieldType::kControl,
+                  name_field),
+              kSpaceNameFieldId)
+          .SetInitiallyFocusedField(kSpaceNameFieldId)
+          .AddOkButton(base::DoNothing(),
+                       ui::DialogModel::Button::Params().SetLabel(u"Done"))
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::LEFT_BOTTOM);
+  views::Widget* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  widget->Show();
+  return widget;
+}
+
+views::Widget* GetSpaceEditBubbleForTesting() {
+  views::View* view = CurrentEditView().view();
+  return view ? view->GetWidget() : nullptr;
+}
+
+void ShowDeleteSpaceConfirmation(views::View* anchor,
+                                 Profile* profile,
+                                 const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  const Space* space = service ? service->GetSpace(space_id) : nullptr;
+  if (!anchor || !anchor->GetWidget() || !space || space->is_default()) {
+    return;
+  }
+  const int tabs = CountTabsInSpace(profile, space_id);
+  std::u16string body;
+  if (tabs == 0) {
+    body = u"No tabs are open in this space.";
+  } else if (tabs == 1) {
+    body = u"Its 1 open tab will close.";
+  } else {
+    body = base::StrCat(
+        {u"Its ", base::NumberToString16(tabs), u" open tabs will close."});
+  }
+  body += u" Its cookies and site data will be deleted. This can't be undone.";
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(base::StrCat(
+              {u"Delete “", base::UTF8ToUTF16(space->name), u"”?"}))
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              base::BindOnce(
+                  [](base::WeakPtr<Profile> profile, std::string space_id) {
+                    if (profile) {
+                      DeleteSpace(profile.get(), space_id);
+                    }
+                  },
+                  profile->GetWeakPtr(), space_id),
+              ui::DialogModel::Button::Params().SetLabel(u"Delete"))
+          .AddCancelButton(base::DoNothing())
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::LEFT_BOTTOM);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
