+void SpaceSwitcherRow::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (!pager_->controller() || reorder_button_) {
+    return;
