+void SpaceSwitcherRow::CreateSpace() {
+  Profile* profile = GetProfile();
+  if (!profile || !pager_->controller()) {
+    return;
+  }
+  std::optional<std::string> space_id = neon::spaces::CreateSpace(profile);
+  if (!space_id) {
+    return;
+  }
+  // The row rebuilt itself when the space was added. Show the space (a new
+  // tab page opens in it), then let the user name it.
+  pager_->ShowSpace(*space_id);
+  EditSpace(*space_id);
+}
+
+void SpaceSwitcherRow::EditSpace(const std::string& space_id) {
+  views::View* anchor = GetButton(space_id);
+  if (!anchor || !anchor->GetVisible()) {
+    anchor = IsCompact() && compact_button_ ? compact_button_.get()
+                                            : static_cast<views::View*>(this);
+  }
+  if (GetWidget()) {
+    GetWidget()->LayoutRootViewIfNecessary();
+  }
+  ShowSpaceEditBubble(anchor, GetProfile(), space_id);
+}
+
+void SpaceSwitcherRow::ConfirmDeleteSpace(const std::string& space_id) {
+  views::View* anchor = GetButton(space_id);
+  if (!anchor || !anchor->GetVisible()) {
+    anchor = this;
+  }
+  ShowDeleteSpaceConfirmation(anchor, GetProfile(), space_id);
+}
+
+bool SpaceSwitcherRow::CanReorder(const SpaceButton* button) const {
+  // The default space stays first; a lone movable icon has nowhere to go.
+  return pager_->controller() && !IsCompact() && buttons_.size() > 2 &&
+         button->space_id() != kDefaultSpaceId &&
+         std::ranges::contains(buttons_, button);
+}
+
+void SpaceSwitcherRow::BeginReorder(SpaceButton* button, int x) {
+  reorder_button_ = button;
+  reorder_grab_ = x - button->x();
+  reorder_x_ = button->x();
+  // Paint above its neighbours while it moves.
+  ReorderChildView(button, children().size());
+  InvalidateLayout();
+}
+
+void SpaceSwitcherRow::UpdateReorder(int x) {
+  if (!reorder_button_) {
+    return;
+  }
+  // Stays within the icons, right of the default space's icon.
+  const int start = GetIconsStart();
+  const int min_x = start + kButtonSize + kButtonSpacing;
+  const int max_x = start + GetIconsWidth() - kButtonSize;
+  reorder_x_ = std::clamp(x - reorder_grab_, min_x, std::max(min_x, max_x));
+  InvalidateLayout();
+}
+
+size_t SpaceSwitcherRow::GetReorderTarget() const {
+  const int slot_width = kButtonSize + kButtonSpacing;
+  const int slot = static_cast<int>(std::lround(
+      static_cast<double>(reorder_x_ - GetIconsStart()) / slot_width));
+  return static_cast<size_t>(
+      std::clamp(slot, 1, static_cast<int>(buttons_.size()) - 1));
+}
+
+void SpaceSwitcherRow::EndReorder(bool commit) {
+  if (!reorder_button_) {
+    return;
+  }
+  const size_t target = GetReorderTarget();
+  SpaceButton* button = std::exchange(reorder_button_, nullptr);
+  const std::string space_id = button->space_id();
+  if (commit) {
+    // Show the new order now; the service confirms it and every window's row
+    // follows. The button is in the middle of handling the release, so the
+    // move, which rebuilds rows, waits for it to finish.
+    std::erase(buttons_, button);
+    buttons_.insert(buttons_.begin() + target, button);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<SpaceSwitcherRow> row, std::string space_id,
+               size_t target) {
+              if (row && row->pager_->controller()) {
+                row->pager_->controller()->service()->MoveSpace(space_id,
+                                                                target);
+              }
+            },
+            weak_factory_.GetWeakPtr(), space_id, target));
+  }
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    ReorderChildView(buttons_[i], i);
+  }
+  InvalidateLayout();
+}
