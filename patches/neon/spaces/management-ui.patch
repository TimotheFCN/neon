+const gfx::VectorIcon* GetSpaceVectorIcon(std::string_view icon) {
+  if (!IsVectorIcon(icon)) {
+    return nullptr;
+  }
+  icon.remove_prefix(std::char_traits<char>::length(kVectorIconPrefix));
+  // Keep in sync with GetSpaceVectorIconNames().
+  static constexpr struct {
+    std::string_view name;
+    const gfx::VectorIcon& icon;
+  } kIcons[] = {
+      {"home", vector_icons::kHomeIcon},
+      {"work", vector_icons::kWorkIcon},
+      {"code", vector_icons::kCodeIcon},
+      {"science", vector_icons::kScienceIcon},
+      {"shopping", vector_icons::kShoppingBagIcon},
+      {"travel", vector_icons::kFlightIcon},
+      {"games", vector_icons::kVideogameAssetIcon},
+      {"pets", vector_icons::kPetsIcon},
+      {"star", vector_icons::kStarFilledIcon},
+      {"music", vector_icons::kHeadphonesIcon},
+  };
+  for (const auto& entry : kIcons) {
+    if (entry.name == icon) {
+      return &entry.icon;
+    }
+  }
+  return nullptr;
+}
