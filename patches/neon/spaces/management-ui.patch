 void SpacesWindowController::OpenNewTabInSpace(const std::string& space_id) {
+  AddTabInSpace(space_id, GURL(), /*foreground=*/true);
+}
+
+content::WebContents* SpacesWindowController::AddTabInSpace(
+    const std::string& space_id,
+    const GURL& url,
+    bool foreground,
+    bool pinned) {
+  // The tab has no opener, so it takes the container GetContainerForNewTab()
+  // gives. A new tab page or a web page in a container is safe; about:blank
+  // would open in the default partition (see containers_api.h).
   pending_new_tab_space_ = space_id;
-  chrome::AddTabAt(browser_, GURL(), -1, /*foreground=*/true);
+  content::WebContents* contents =
+      chrome::AddAndReturnTabAt(browser_, url, -1, foreground,
+                                /*group=*/std::nullopt, pinned);
   pending_new_tab_space_.reset();
+  return contents;
+}
+
+int SpacesWindowController::CountTabsInSpace(
+    const std::string& space_id) const {
+  int count = 0;
+  for (int i = 0; model_ && i < model_->count(); ++i) {
+    if (GetSpaceIdOf(model_->GetWebContentsAt(i)) == space_id) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+void SpacesWindowController::EvacuateSpace(const std::string& space_id,
+                                           const std::string& to_space_id) {
+  if (!model_ || model_->empty()) {
+    return;
+  }
+  const bool visible =
+      model_->GetActiveTab() && GetSpaceIdOf(model_->GetActiveTab()) == space_id;
+  if (visible || CountTabsInSpace(space_id) == model_->count()) {
+    // Leave the space first, so the window never runs out of tabs and the
+    // last-tab rule does not open a new tab page in the space.
+    tabs::TabInterface* tab = GetLastActiveTabOfSpace(to_space_id);
+    if (!tab) {
+      AddTabInSpace(to_space_id, GURL(), /*foreground=*/true);
+    } else {
+      model_->ActivateTabAt(
+          model_->GetIndexOfTab(tab),
+          TabStripUserGestureDetails(
+              TabStripUserGestureDetails::GestureType::kOther));
+    }
+  }
+  last_visible_space_ = GetVisibleSpaceId();
+  for (int i = model_->count() - 1; i >= 0; --i) {
+    if (i < model_->count() &&
+        GetSpaceIdOf(model_->GetWebContentsAt(i)) == space_id) {
+      model_->DetachAndDeleteWebContentsAt(i);
+    }
+  }
 }
 
