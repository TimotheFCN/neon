+// The contents of the edit bubble: name, icon and colour. Every change is
+// saved at once.
+class SpaceEditView : public views::View,
+                      public views::TextfieldController,
+                      public SpacesService::Observer {
+  METADATA_HEADER(SpaceEditView, views::View)
+
+ public:
+  SpaceEditView(Profile* profile, const Space& space)
+      : service_(SpacesServiceFactory::GetForProfile(profile)),
+        space_id_(space.id),
+        icon_(space.icon),
+        color_(space.color) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+        kSectionSpacing));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+
+    name_field_ = AddChildView(std::make_unique<views::Textfield>());
+    name_field_->SetText(base::UTF8ToUTF16(space.name));
+    name_field_->SetAccessibleName(u"Space name");
+    name_field_->SetPlaceholderText(u"Name");
+    name_field_->set_controller(this);
+    name_field_->SelectAll(/*reversed=*/false);
+
+    AddSectionLabel(u"Icon");
+    auto* icon_grid = AddGrid();
+    auto* icons = AddRow(icon_grid);
+    AddIconChoice(icons, std::string(), u"First letter");
+    const auto names = GetSpaceVectorIconNames();
+    for (size_t i = 0; i < names.size(); ++i) {
+      if ((i + 1) % kChoicesPerRow == 0) {
+        icons = AddRow(icon_grid);
+      }
+      AddIconChoice(icons, base::StrCat({kVectorIconPrefix, names[i]}),
+                    kIconLabels[i]);
+    }
+    // Fills the end of the last row of icons.
+    emoji_field_ = icons->AddChildView(std::make_unique<views::Textfield>());
+    emoji_field_->SetAccessibleName(u"Emoji");
+    emoji_field_->SetPlaceholderText(u"Emoji");
+    emoji_field_->SetDefaultWidthInChars(5);
+    emoji_field_->set_controller(this);
+    if (!icon_.empty() && !IsVectorIcon(icon_)) {
+      emoji_field_->SetText(base::UTF8ToUTF16(icon_));
+    }
+
+    AddSectionLabel(u"Colour");
+    auto* color_grid = AddGrid();
+    auto* colors = AddRow(color_grid);
+    AddColorChoice(colors, SK_ColorTRANSPARENT, u"No colour");
+    const auto palette = GetSpaceColors();
+    for (size_t i = 0; i < palette.size(); ++i) {
+      if ((i + 1) % kChoicesPerRow == 0) {
+        colors = AddRow(color_grid);
+      }
+      AddColorChoice(colors, palette[i], kColorLabels[i]);
+    }
+    UpdateSelection();
+    observation_.Observe(service_);
+  }
+
+  ~SpaceEditView() override = default;
+
+  views::Textfield* name_field() const { return name_field_; }
+  const std::string& space_id() const { return space_id_; }
+
+  // views::View:
+  std::string GetObjectName() const override {
+    return base::StrCat({"SpaceEditView/", space_id_});
+  }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    if (sender == emoji_field_) {
+      const std::string icon =
+          NormalizeSpaceIcon(base::UTF16ToUTF8(new_contents));
+      if (!icon.empty()) {
+        icon_ = icon;
+      } else if (!IsVectorIcon(icon_)) {
+        icon_.clear();
+      }
+      UpdateSelection();
+    } else {
+      // The letter choice previews the name's first letter.
+      for (auto& [button, icon] : icon_choices_) {
+        button->SchedulePaint();
+      }
+    }
+    Save();
+  }
+
+  // SpacesService::Observer:
+  void OnSpacesChanged() override {
+    const Space* space = service_->GetSpace(space_id_);
+    if (!space) {
+      // Deleted while being edited.
+      if (GetWidget()) {
+        GetWidget()->Close();
+      }
+      return;
+    }
+    if (space->icon != icon_ || space->color != color_) {
+      icon_ = space->icon;
+      color_ = space->color;
+      UpdateSelection();
+    }
+  }
+
+ private:
+  void AddSectionLabel(std::u16string_view text) {
+    auto* label = AddChildView(std::make_unique<views::Label>(
+        std::u16string(text), views::style::CONTEXT_DIALOG_BODY_TEXT,
+        views::style::STYLE_SECONDARY));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+
+  // A column of rows of choices.
+  views::BoxLayoutView* AddGrid() {
+    auto* grid = AddChildView(std::make_unique<views::BoxLayoutView>());
+    grid->SetOrientation(views::BoxLayout::Orientation::kVertical);
+    grid->SetBetweenChildSpacing(kChoiceSpacing);
+    grid->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStart);
+    return grid;
+  }
+
+  views::BoxLayoutView* AddRow(views::View* parent) {
+    auto* row = parent->AddChildView(std::make_unique<views::BoxLayoutView>());
+    row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    row->SetBetweenChildSpacing(kChoiceSpacing);
+    return row;
+  }
+
+  void AddIconChoice(views::View* row,
+                     std::string icon,
+                     std::u16string_view label) {
+    auto* button = row->AddChildView(std::make_unique<ChoiceButton>(
+        base::BindRepeating(&SpaceEditView::SelectIcon,
+                            base::Unretained(this), icon),
+        base::StrCat({"SpaceIconChoice/", icon.empty() ? "letter" : icon}),
+        label,
+        base::BindRepeating(
+            [](SpaceEditView* view, std::string icon, gfx::Canvas* canvas,
+               const gfx::RectF& bounds, const ui::ColorProvider* colors) {
+              Space preview;
+              preview.icon = icon;
+              preview.color = view->color_;
+              preview.name = base::UTF16ToUTF8(view->name_field_->GetText());
+              PaintSpaceIcon(
+                  canvas, bounds, kChoiceIconSize, GetSpaceGlyph(preview),
+                  preview.color,
+                  colors->GetColor(kColorTabForegroundActiveFrameActive),
+                  /*emphasized=*/true);
+            },
+            base::Unretained(this), icon)));
+    icon_choices_.emplace_back(button, std::move(icon));
+  }
+
+  void AddColorChoice(views::View* row,
+                      SkColor color,
+                      std::u16string_view label) {
+    auto* button = row->AddChildView(std::make_unique<ChoiceButton>(
+        base::BindRepeating(&SpaceEditView::SelectColor,
+                            base::Unretained(this), color),
+        base::StrCat({"SpaceColorChoice/", ColorKey(color)}), label,
+        base::BindRepeating(
+            [](SkColor color, gfx::Canvas* canvas, const gfx::RectF& bounds,
+               const ui::ColorProvider* colors) {
+              gfx::RectF dot = bounds;
+              dot.ClampToCenteredSize(gfx::SizeF(16, 16));
+              cc::PaintFlags flags;
+              flags.setAntiAlias(true);
+              if (SkColorGetA(color)) {
+                flags.setColor(color);
+                canvas->DrawCircle(dot.CenterPoint(), dot.width() / 2, flags);
+                return;
+              }
+              flags.setStyle(cc::PaintFlags::kStroke_Style);
+              flags.setStrokeWidth(1.5f);
+              flags.setColor(
+                  colors->GetColor(kColorTabForegroundActiveFrameActive));
+              canvas->DrawCircle(dot.CenterPoint(), dot.width() / 2 - 0.75f,
+                                 flags);
+            },
+            color)));
+    color_choices_.emplace_back(button, color);
+  }
+
+  void SelectIcon(std::string icon) {
+    icon_ = std::move(icon);
+    if (!emoji_field_->GetText().empty()) {
+      emoji_field_->SetText(std::u16string());
+    }
+    UpdateSelection();
+    Save();
+  }
+
+  void SelectColor(SkColor color) {
+    color_ = color;
+    UpdateSelection();
+    Save();
+  }
+
+  void UpdateSelection() {
+    for (auto& [button, icon] : icon_choices_) {
+      button->SetSelected(icon == icon_);
+      button->SchedulePaint();
+    }
+    for (auto& [button, color] : color_choices_) {
+      button->SetSelected(color == color_);
+    }
+  }
+
+  void Save() {
+    service_->UpdateSpace(space_id_, base::UTF16ToUTF8(name_field_->GetText()),
+                          icon_, color_);
+  }
+
+  const raw_ptr<SpacesService> service_;
+  const std::string space_id_;
+  std::string icon_;
+  SkColor color_;
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+  raw_ptr<views::Textfield> emoji_field_ = nullptr;
+  std::vector<std::pair<raw_ptr<ChoiceButton>, std::string>> icon_choices_;
+  std::vector<std::pair<raw_ptr<ChoiceButton>, SkColor>> color_choices_;
+  base::ScopedObservation<SpacesService, SpacesService::Observer>
+      observation_{this};
+};
+
+BEGIN_METADATA(SpaceEditView)
+END_METADATA
+
+}  // namespace
