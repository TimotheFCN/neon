+// One choice in the icon or colour row: a square button that shows a ring
+// when selected.
+class ChoiceButton : public views::Button {
+  METADATA_HEADER(ChoiceButton, views::Button)
+
+ public:
+  using Painter = base::RepeatingCallback<
+      void(gfx::Canvas*, const gfx::RectF&, const ui::ColorProvider*)>;
+
+  ChoiceButton(PressedCallback callback,
+               std::string object_name,
+               std::u16string_view label,
+               Painter painter)
+      : views::Button(std::move(callback)),
+        object_name_(std::move(object_name)),
+        painter_(std::move(painter)) {
+    SetTooltipText(std::u16string(label));
+    GetViewAccessibility().SetName(std::u16string(label));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kRadioButton);
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCornerRadius);
+    views::FocusRing::Install(this);
+  }
+
+  void SetSelected(bool selected) {
+    if (selected_ != selected) {
+      selected_ = selected;
+      GetViewAccessibility().SetCheckedState(
+          selected ? ax::mojom::CheckedState::kTrue
+                   : ax::mojom::CheckedState::kFalse);
+      SchedulePaint();
+    }
+  }
+  bool selected() const { return selected_; }
+
+  // views::View:
+  std::string GetObjectName() const override { return object_name_; }
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kChoiceSize, kChoiceSize);
+  }
+
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    gfx::RectF bounds(GetLocalBounds());
+    if (selected_ || GetState() == STATE_HOVERED) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(2);
+      SkColor ring = colors->GetColor(kColorTabForegroundActiveFrameActive);
+      flags.setColor(selected_ ? ring : SkColorSetA(ring, 0x40));
+      gfx::RectF ring_bounds = bounds;
+      ring_bounds.Inset(1);
+      canvas->DrawRoundRect(ring_bounds, kCornerRadius, flags);
+    }
+    painter_.Run(canvas, bounds, colors);
+  }
+
+ private:
+  const std::string object_name_;
+  Painter painter_;
+  bool selected_ = false;
+};
