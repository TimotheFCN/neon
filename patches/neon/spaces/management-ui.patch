+//   then every tab of the space closes, in all windows of the profile, without
+//   unload handlers and without recently closed entries;
+// - the space and its container are removed from the lists;
+// - the container's cookies, site storage and cache are cleared now, and its
+//   directory is deleted at the next start;
+// - saved state that refers to the container is dropped: recently closed
+//   tabs and the saved tab group containers pref.
+// The default space cannot be deleted. Returns false if nothing was deleted.
+bool DeleteSpace(Profile* profile, const std::string& space_id);
+
+}  // namespace neon::spaces
