+
+std::vector<BrowserWindowInterface*> GetWindows(Profile* profile) {
+  std::vector<BrowserWindowInterface*> windows;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() == profile && browser->GetTabStripModel()) {
+          windows.push_back(browser);
+        }
+        return true;
+      });
+  return windows;
+}
+
+}  // namespace
+
+int CountTabsInSpace(Profile* profile, const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  if (!service || !service->GetSpace(space_id)) {
+    return 0;
+  }
+  int count = 0;
+  for (BrowserWindowInterface* browser : GetWindows(profile)) {
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      if (service->GetSpaceIdForContainer(containers_api::GetTabContainerId(
+              model->GetWebContentsAt(i))) == space_id) {
+        ++count;
+      }
+    }
+  }
+  return count;
+}
+
+std::optional<std::string> CreateSpace(Profile* profile) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  if (!service || !containers_api::IsAvailable(profile)) {
+    return std::nullopt;
+  }
+  return service->CreateSpace(GetNewSpaceName(service->spaces()),
+                              std::string(),
+                              GetNewSpaceColor(service->spaces()));
+}
+
+bool DeleteSpace(Profile* profile, const std::string& space_id) {
+  SpacesService* service = SpacesServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return false;
+  }
+  const Space* space = service->GetSpace(space_id);
+  std::optional<size_t> index = service->GetSpaceIndex(space_id);
+  if (!space || !index || space->is_default()) {
+    return false;
+  }
+  const std::string container_id = space->container_id;
+  // The default space is first and stays, so there is always a space before.
+  const std::string neighbour = service->spaces()[*index - 1].id;
+
+  for (BrowserWindowInterface* browser : GetWindows(profile)) {
+    if (SpacesWindowController* controller =
+            SpacesWindowController::FromBrowser(browser)) {
+      controller->EvacuateSpace(space_id, neighbour);
+      continue;
+    }
+    // Popups and app windows have no space but can hold a tab of the space's
+    // container (a popup opened by one of its pages). They close with it.
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int i = model->count() - 1; i >= 0; --i) {
+      if (i < model->count() && containers_api::GetTabContainerId(
+                                    model->GetWebContentsAt(i)) == container_id) {
+        model->DetachAndDeleteWebContentsAt(i);
+      }
+    }
+  }
+
+  // |space| is gone after this.
+  if (!service->DeleteSpace(space_id)) {
+    return false;
+  }
+
+  PrefService* prefs = profile->GetPrefs();
+  base::DictValue groups = prefs->GetDict(kSavedGroupContainersPref).Clone();
+  std::vector<std::string> stale;
+  for (const auto [group, value] : groups) {
+    if (value.is_string() && value.GetString() == container_id) {
+      stale.push_back(group);
+    }
+  }
+  if (!stale.empty()) {
+    for (const std::string& group : stale) {
+      groups.Remove(group);
+    }
+    prefs->SetDict(kSavedGroupContainersPref, std::move(groups));
+  }
+
+  containers_api::ForgetContainerInClosedTabs(profile, container_id);
+  containers_api::ClearContainerStorage(
+      profile, container_id,
+      base::BindOnce(
+          [](const std::string& id) {
+            VLOG(1) << "Neon: cleared the storage of deleted container " << id;
+          },
+          container_id));
+  return true;
+}
+
