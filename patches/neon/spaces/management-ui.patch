+void ClearContainerStorage(Profile* profile,
+                           std::string_view id,
+                           base::OnceClosure done) {
+  if (!GetService(profile) || id.empty() ||
+      !containers::IsValidStoragePartitionKeyComponent(id)) {
+    std::move(done).Run();
+    return;
+  }
+  const content::StoragePartitionConfig config =
+      content::StoragePartitionConfig::Create(
+          profile, containers::kContainersStoragePartitionDomain,
+          std::string(id), profile->IsOffTheRecord());
+  // A partition that was never loaded this session has nothing in memory; its
+  // directory goes at the next start.
+  content::StoragePartition* partition =
+      profile->GetStoragePartition(config, /*can_create=*/false);
+  if (!partition) {
+    std::move(done).Run();
+    return;
+  }
+  // Cookies are written to disk in batches; flush once they are cleared so the
+  // file on disk no longer holds them either.
+  base::OnceClosure flush = base::BindOnce(
+      [](content::StoragePartition* partition, base::OnceClosure done) {
+        partition->GetCookieManagerForBrowserProcess()->FlushCookieStore(
+            std::move(done));
+      },
+      base::Unretained(partition), std::move(done));
+  base::RepeatingClosure barrier = base::BarrierClosure(2, std::move(flush));
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL,
+      /*filter_builder=*/nullptr,
+      /*storage_key_policy_matcher=*/base::NullCallback(),
+      network::mojom::CookieDeletionFilter::New(),
+      /*perform_storage_cleanup=*/true, base::Time(), base::Time::Max(),
+      barrier);
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr, barrier);
+}
