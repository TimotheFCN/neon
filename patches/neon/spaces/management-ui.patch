+namespace neon::spaces {
+
+namespace {
+
+constexpr auto kColors = std::to_array<SkColor>({
+    SkColorSetRGB(0x1a, 0x73, 0xe8),  // blue
+    SkColorSetRGB(0xd9, 0x30, 0x25),  // red
+    SkColorSetRGB(0xf9, 0xab, 0x00),  // yellow
+    SkColorSetRGB(0x1e, 0x8e, 0x3e),  // green
+    SkColorSetRGB(0xd0, 0x18, 0x84),  // pink
+    SkColorSetRGB(0x93, 0x34, 0xe6),  // purple
+    SkColorSetRGB(0x00, 0x7b, 0x83),  // cyan
+    SkColorSetRGB(0xe8, 0x71, 0x0a),  // orange
+    SkColorSetRGB(0x5f, 0x63, 0x68),  // grey
+});
+
+constexpr auto kVectorIcons = std::to_array<std::string_view>({
+    "home", "work", "code", "science", "shopping", "travel", "games", "pets",
+    "star", "music",
+});
+
+}  // namespace
+
+base::span<const SkColor> GetSpaceColors() {
+  return kColors;
+}
+
+base::span<const std::string_view> GetSpaceVectorIconNames() {
+  return kVectorIcons;
+}
+
+bool IsVectorIcon(std::string_view icon) {
+  if (!base::StartsWith(icon, kVectorIconPrefix)) {
+    return false;
+  }
+  icon.remove_prefix(std::char_traits<char>::length(kVectorIconPrefix));
+  return std::ranges::contains(kVectorIcons, icon);
+}
+
+std::string NormalizeSpaceIcon(std::string_view icon) {
+  if (IsVectorIcon(icon)) {
+    return std::string(icon);
+  }
+  std::u16string text;
+  base::TrimWhitespace(base::UTF8ToUTF16(icon), base::TRIM_ALL, &text);
+  if (text.empty()) {
+    return std::string();
+  }
+  // Keep the first user-perceived character (an emoji with its modifiers and
+  // joiners counts as one).
+  base::i18n::BreakIterator iter(text, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (iter.Init() && iter.Advance()) {
+    text = text.substr(0, iter.pos());
+  }
+  return base::UTF16ToUTF8(text);
+}
+
+std::string GetNewSpaceName(const std::vector<Space>& spaces) {
+  for (int n = 1;; ++n) {
+    const std::string name = base::StrCat({"Space ", base::NumberToString(n)});
+    if (std::ranges::none_of(
+            spaces, [&](const Space& space) { return space.name == name; })) {
+      return name;
+    }
+  }
+}
+
+SkColor GetNewSpaceColor(const std::vector<Space>& spaces) {
+  for (SkColor color : kColors) {
+    if (std::ranges::none_of(
+            spaces, [&](const Space& space) { return space.color == color; })) {
+      return color;
+    }
+  }
+  return kColors[spaces.size() % kColors.size()];
+}
+
+}  // namespace neon::spaces
