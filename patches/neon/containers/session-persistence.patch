 void ContentSerializedNavigationDriver::Sanitize(
     SerializedNavigationEntry* navigation) const {
+  // Containers: called when loading a SerializedNavigationEntry from disk or
+  // sync, before it is converted to a NavigationEntry. If the virtual URL has
+  // the form "containers+<id>:https://...", strip the prefix from the virtual
+  // URL and the PageState and keep the storage partition key, which
+  // ContentSerializedNavigationBuilder::ToNavigationEntry() copies onto the
+  // NavigationEntry. With containers disabled the URL stays unhandleable.
+  if (!base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return;
+  }
+  auto result =
+      containers::RestoreStoragePartitionKeyFromUrl(navigation->virtual_url());
+  if (!result) {
+    return;
+  }
+  navigation->set_virtual_url_prefix(
+      navigation->virtual_url().spec().substr(0, result->url_prefix_length));
+  navigation->set_virtual_url(result->url);
+  navigation->set_storage_partition_key(result->storage_partition_key);
+  if (!navigation->encoded_page_state().empty()) {
+    navigation->set_encoded_page_state(
+        blink::PageState::CreateFromEncodedData(
+            navigation->encoded_page_state())
+            .RemoveTopURLPrefix(result->url_prefix_length)
+            .ToEncodedData());
+  }
 }
 
