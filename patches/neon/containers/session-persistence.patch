+// Containers: copies the storage partition key parsed from the
+// SerializedNavigationEntry by ContentSerializedNavigationDriver::Sanitize()
+// into the NavigationEntry, so the restored tab gets a SiteInstance in the
+// right storage partition.
+void MaybeRestoreStoragePartitionKey(
+    const SerializedNavigationEntry* navigation,
+    content::NavigationEntry* entry) {
+  if (base::FeatureList::IsEnabled(containers::features::kContainers) &&
+      navigation->storage_partition_key().has_value()) {
+    entry->SetStoragePartitionKeyToRestore(
+        navigation->storage_partition_key().value());
+  }
+}
+
+// Containers: stores the NavigationEntry's storage partition key and its URL
+// prefix ("containers+<id>:") on the SerializedNavigationEntry when saving a
+// session. The prefix is added to the PageState by
+// ContentSerializedNavigationDriver::GetSanitizedPageStateForPickle() and to
+// the virtual URL by SerializedNavigationEntry::WriteToPickle().
+void MaybeSaveStoragePartitionKey(content::NavigationEntry* entry,
+                                  SerializedNavigationEntry* navigation) {
+  if (!base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return;
+  }
+  auto storage_partition_key_to_restore =
+      entry->GetStoragePartitionKeyToRestore();
+  if (!storage_partition_key_to_restore) {
+    return;
+  }
+  auto url_prefix = containers::StoragePartitionKeyToUrlPrefix(
+      *storage_partition_key_to_restore);
+  if (!url_prefix) {
+    return;
+  }
+  navigation->set_virtual_url_prefix(*url_prefix);
+  navigation->set_storage_partition_key(*storage_partition_key_to_restore);
+}
+
