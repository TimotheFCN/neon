+#include "chrome/browser/ui/webui/chrome_web_ui_controller_factory.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/content/browser/tab_restore_utils.h"
+#include "components/containers/core/common/features.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+
+namespace containers {
+
+std::optional<content::StoragePartitionConfig>
+GetStoragePartitionConfigToInherit(const NavigateParams& params) {
+  if (!base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return std::nullopt;
+  }
+
+  if (params.storage_partition_config) {
+    return containers::MaybeInheritStoragePartition(
+        *params.storage_partition_config);
+  }
+
+  if (params.source_site_instance) {
+    return containers::MaybeInheritStoragePartition(
+        params.source_site_instance->GetSecurityPrincipal()
+            .GetStoragePartitionConfig());
+  }
+
+  return std::nullopt;
+}
+
+void MaybeSetContainerSiteInstance(
+    Profile* profile,
+    base::span<const sessions::SerializedNavigationEntry> navigations,
+    int selected_navigation,
+    content::WebContents::CreateParams* create_params) {
+  auto storage_partition_config =
+      containers::GetStoragePartitionConfigToRestore(profile, navigations,
+                                                     selected_navigation);
+  if (!storage_partition_config) {
+    return;
+  }
+
+  const GURL& url = navigations[selected_navigation].virtual_url();
+  // Neon: Brave skips WebUI URLs here, so a container tab showing the new tab
+  // page, settings or history restored into the default partition, and what it
+  // loaded next stayed there. It gets a SiteInstance with no site yet, fixed
+  // to the container's partition, as noopener windows do; its WebUI navigation
+  // assigns the site and later navigations keep the partition.
+  if (ChromeWebUIControllerFactory::GetInstance()->UseWebUIForURL(profile,
+                                                                  url)) {
+    create_params->site_instance =
+        content::SiteInstance::CreateForFixedStoragePartition(
+            profile, GURL(), *storage_partition_config);
+    return;
+  }
+  // A URL without a site (about:blank) cannot use the same trick: once it
+  // commits in a SiteInstance that has no site, the next navigation fails a
+  // CHECK in BrowsingInstance (the instance reports the default partition).
+  // Anchor the partition on a site from the tab's own history instead.
+  if (!content::SiteInstance::ShouldAssignSiteForURL(url)) {
+    for (const auto& navigation : navigations) {
+      const GURL& other = navigation.virtual_url();
+      if (content::SiteInstance::ShouldAssignSiteForURL(other) &&
+          !ChromeWebUIControllerFactory::GetInstance()->UseWebUIForURL(
+              profile, other)) {
+        create_params->site_instance =
+            content::SiteInstance::CreateForFixedStoragePartition(
+                profile, other, *storage_partition_config);
+        return;
+      }
+    }
+    // Nothing to anchor it on: the tab restores in the default partition.
+    return;
+  }
+  create_params->site_instance = tab_util::GetSiteInstanceForNewTab(
+      profile, url, std::move(storage_partition_config));
+}
