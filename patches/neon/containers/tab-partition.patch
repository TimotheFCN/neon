+// Returns the Containers storage partition a new tab created by |params|
+// should use: |params.storage_partition_config| when it is a Containers
+// partition, otherwise the partition of |params.source_site_instance| when that
+// is one, otherwise (Neon) the partition of the innermost
+// ScopedNewTabStoragePartition, otherwise the container the new tab container
+// provider picks for |params.browser|. Returns std::nullopt in every other case
+// and when Containers is disabled. Neon: an extension page that nothing above
+// the scope picked a container for stays in the default partition, where its
+// extension keeps its storage.
+std::optional<content::StoragePartitionConfig>
+GetStoragePartitionConfigToInherit(const NavigateParams& params);
+
+// Neon: picks the storage partition of a new tab that has no opener, no source
+// page and no explicit container: Ctrl+T, the new tab button, links from other
+// apps, bookmarks. Brave master answers the same question with its "open new
+// tabs in" setting (brave-core #40693, GetNewTabTargetStoragePartitionConfig).
+// Neon lets spaces answer it through neon::containers_api, so a new tab opens
+// in the window's visible space. std::nullopt means the default partition.
+using NewTabContainerProvider =
+    base::RepeatingCallback<std::optional<content::StoragePartitionConfig>(
+        BrowserWindowInterface* browser)>;
+void SetNewTabContainerProvider(NewTabContainerProvider provider);
+
+// Neon: while an instance is alive, a new tab that has no opener, source page
+// or explicit container opens in the partition it holds, instead of the one
+// the new tab container provider picks: a container's partition, or the
+// default partition for std::nullopt. Used where Chromium opens tabs by URL
+// on behalf of a tab or a saved entry that has a container (a saved tab group
+// reopened from tab restore, a new split tab). Scopes nest and the innermost
+// one wins. UI thread only.
+class ScopedNewTabStoragePartition {
+ public:
+  explicit ScopedNewTabStoragePartition(
+      std::optional<content::StoragePartitionConfig> config);
+  // The partition of |web_contents|: its container's, or the default one.
+  explicit ScopedNewTabStoragePartition(content::WebContents* web_contents);
+  ScopedNewTabStoragePartition(const ScopedNewTabStoragePartition&) = delete;
+  ScopedNewTabStoragePartition& operator=(
+      const ScopedNewTabStoragePartition&) = delete;
+  ~ScopedNewTabStoragePartition();
+};
+
+// Sets |create_params->site_instance| for a tab restored from |navigations|
+// when the selected navigation belongs to a container, so the restored tab is
+// created in the container's storage partition. WebUI pages get a
+// SiteInstance with no site yet, fixed to that partition; blank pages get one
+// for a site from the tab's history.
+void MaybeSetContainerSiteInstance(
+    Profile* profile,
+    base::span<const sessions::SerializedNavigationEntry> navigations,
+    int selected_navigation,
+    content::WebContents::CreateParams* create_params);
+
+}  // namespace containers
+
+#endif  // CHROME_BROWSER_CONTAINERS_CONTAINERS_NAVIGATOR_UTILS_H_
