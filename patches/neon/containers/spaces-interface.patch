+#ifndef CHROME_BROWSER_NEON_CONTAINERS_API_H_
+#define CHROME_BROWSER_NEON_CONTAINERS_API_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "components/containers/core/browser/containers_service_observer.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// The one interface Neon spaces use to talk to containers. Everything behind it
+// maps onto the Brave containers port (components/containers and
+// chrome/browser/containers), so that if Helium imports Brave's containers
+// itself, only containers_api.cc has to change.
+//
+// A container is a persistent storage partition inside the profile: its own
+// cookies, cache and site storage. The default partition (no container) is
+// not a container and has the empty id.
+namespace neon::containers_api {
+
+struct ContainerInfo {
+  // Lowercase UUID. Also the storage partition name.
+  std::string id;
+  std::string name;
+  // Opaque color, and a value of Brave's containers::mojom::Icon. Kept so that
+  // prefs stay compatible; spaces may ignore the icon.
+  SkColor color = SK_ColorBLACK;
+  int icon = 0;
+};
+
+// Notified when the containers list changes, including changes made by
+// another window.
+class Observer : public containers::ContainersServiceObserver {
+ public:
+  virtual void OnContainersChanged() = 0;
+
+ private:
+  // containers::ContainersServiceObserver:
+  void OnContainersListChanged() final;
+};
+
+// Whether containers are available for |profile|. False for off-the-record
+// profiles (the port itself runs there, Neon does not offer it), for system
+// profiles and when the Containers feature is disabled. Every other function
+// here behaves as if no container existed when this is false.
+bool IsAvailable(Profile* profile);
+
+// The user's containers, in their stored order.
+std::vector<ContainerInfo> ListContainers(Profile* profile);
+
+// The container with |id|. Also finds containers that were removed from the
+// list but are still used by a tab or a saved session.
+std::optional<ContainerInfo> GetContainer(Profile* profile,
+                                          std::string_view id);
+
+// Adds a container at the end of the list and returns its new id, or
+// std::nullopt if |name| is blank or |color| is not opaque.
+std::optional<std::string> CreateContainer(Profile* profile,
+                                           std::string_view name,
+                                           SkColor color,
+                                           int icon = 0);
+
+// Renames or recolors a container. Returns false if it does not exist or the
+// values are invalid.
+bool UpdateContainer(Profile* profile,
+                     std::string_view id,
+                     std::string_view name,
+                     SkColor color,
+                     int icon = 0);
+
+// Removes a container from the list. Its storage is deleted at a later start,
+// once no open tab, saved session or closed-tab entry uses it, so close the
+// container's tabs first. Returns false if it does not exist.
+bool DeleteContainer(Profile* profile, std::string_view id);
+
+// Opens |url| in a new tab of |browser| inside container |id| at |index| (-1
+// for the end). WebUI pages such as the new tab page open in the container
+// too. about:blank does not: a SiteInstance without a site cannot hold a
+// container partition safely, so a blank tab opens in the default partition.
+// Returns the new tab's contents, or nullptr if containers are unavailable or
+// no container |id| exists (GetContainer). Ids are lowercase.
+content::WebContents* OpenTabInContainer(BrowserWindowInterface* browser,
+                                         const GURL& url,
+                                         std::string_view id,
+                                         int index = -1,
+                                         bool foreground = true,
+                                         bool pinned = false);
+
+// The container of |web_contents|, or the empty string for the default
+// partition. Works for discarded tabs too.
+std::string GetTabContainerId(content::WebContents* web_contents);
+
+// Picks the container of a new tab that has no opener, no source page and no
+// explicit container: Ctrl+T, the new tab button, links from other apps,
+// bookmarks. |browser| is the window the tab opens in. The provider returns a
+// container id, or the empty string for the default partition. There is one
+// provider per process; spaces sets it.
+using NewTabContainerProvider =
+    base::RepeatingCallback<std::string(BrowserWindowInterface* browser)>;
+void SetNewTabContainerProvider(NewTabContainerProvider provider);
+
+void AddObserver(Profile* profile, Observer* observer);
+void RemoveObserver(Profile* profile, Observer* observer);
+
+}  // namespace neon::containers_api
+
+#endif  // CHROME_BROWSER_NEON_CONTAINERS_API_H_
