+#include "chrome/browser/neon/containers_api.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/containers/containers_navigator_utils.h"
+#include "chrome/browser/containers/containers_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/browser/containers_service.h"
+#include "components/containers/core/browser/containers_settings_handler.h"
+#include "components/containers/core/common/features.h"
+#include "components/containers/core/mojom/containers.mojom.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace neon::containers_api {
+
+namespace {
+
+using containers::mojom::ContainerOperationError;
+
+containers::ContainersService* GetService(Profile* profile) {
+  // The containers port also runs in off-the-record profiles (Brave's factory
+  // uses WithRegular(kOwnInstance)), but Neon offers containers, and so
+  // spaces, in regular profiles only.
+  if (!profile || profile->IsOffTheRecord() ||
+      !base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return nullptr;
+  }
+  return ContainersServiceFactory::GetForProfile(profile);
+}
+
+ContainerInfo ToInfo(const containers::mojom::ContainerPtr& container) {
+  return {container->id, container->name, container->background_color,
+          static_cast<int>(container->icon)};
+}
+
+containers::mojom::ContainerPtr MakeContainer(std::string_view id,
+                                              std::string_view name,
+                                              SkColor color,
+                                              int icon) {
+  return containers::mojom::Container::New(
+      std::string(id), std::string(name),
+      static_cast<containers::mojom::Icon>(icon), color);
+}
+
+// ContainersSettingsHandler is a mojo interface, but its implementation answers
+// synchronously. This collects the answer.
+struct Result {
+  bool called = false;
+  std::optional<ContainerOperationError> error;
+};
+
+base::OnceCallback<void(std::optional<ContainerOperationError>)> Collect(
+    Result* result) {
+  return base::BindOnce(
+      [](Result* result, std::optional<ContainerOperationError> error) {
+        result->called = true;
+        result->error = error;
+      },
+      base::Unretained(result));
+}
+
+}  // namespace
+
+void Observer::OnContainersListChanged() {
+  OnContainersChanged();
+}
+
+bool IsAvailable(Profile* profile) {
+  return GetService(profile) != nullptr;
+}
+
+std::vector<ContainerInfo> ListContainers(Profile* profile) {
+  std::vector<ContainerInfo> result;
+  if (auto* service = GetService(profile)) {
+    for (const auto& container : service->GetContainers()) {
+      result.push_back(ToInfo(container));
+    }
+  }
+  return result;
+}
+
+std::optional<ContainerInfo> GetContainer(Profile* profile,
+                                          std::string_view id) {
+  auto* service = GetService(profile);
+  if (!service) {
+    return std::nullopt;
+  }
+  if (auto container = service->GetRuntimeContainerById(id)) {
+    return ToInfo(container);
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> CreateContainer(Profile* profile,
+                                           std::string_view name,
+                                           SkColor color,
+                                           int icon) {
+  auto* service = GetService(profile);
+  if (!service) {
+    return std::nullopt;
+  }
+  containers::ContainersSettingsHandler handler(profile->GetPrefs());
+  Result result;
+  handler.AddContainer(MakeContainer("", name, color, icon), Collect(&result));
+  CHECK(result.called);
+  if (result.error) {
+    return std::nullopt;
+  }
+  // AddContainer appends the new container, with a fresh id, to the list.
+  auto containers = service->GetContainers();
+  CHECK(!containers.empty());
+  return containers.back()->id;
+}
+
+bool UpdateContainer(Profile* profile,
+                     std::string_view id,
+                     std::string_view name,
+                     SkColor color,
+                     int icon) {
+  if (!GetService(profile) || id.empty()) {
+    return false;
+  }
+  containers::ContainersSettingsHandler handler(profile->GetPrefs());
+  Result result;
+  handler.UpdateContainer(MakeContainer(id, name, color, icon),
+                          Collect(&result));
+  CHECK(result.called);
+  return !result.error;
+}
+
+bool DeleteContainer(Profile* profile, std::string_view id) {
+  if (!GetService(profile) || id.empty()) {
+    return false;
+  }
+  containers::ContainersSettingsHandler handler(profile->GetPrefs());
+  Result result;
+  handler.RemoveContainer(std::string(id), Collect(&result));
+  CHECK(result.called);
+  return !result.error;
+}
+
+content::WebContents* OpenTabInContainer(BrowserWindowInterface* browser,
+                                         const GURL& url,
+                                         std::string_view id,
+                                         int index,
+                                         bool foreground,
+                                         bool pinned) {
+  if (!browser) {
+    return nullptr;
+  }
+  Profile* profile = browser->GetProfile();
+  auto* service = GetService(profile);
+  // Ids are lowercase UUIDs. An uppercase id would pass the character check,
+  // but the containers+<id>: prefix is lowercased when the session is saved,
+  // so the tab would restore into another partition. A stale id would
+  // silently create a new partition.
+  if (!service || !containers::IsValidStoragePartitionKeyComponent(id) ||
+      id != base::ToLowerASCII(id) || !service->GetRuntimeContainerById(id)) {
+    return nullptr;
+  }
+
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.storage_partition_config = content::StoragePartitionConfig::Create(
+      profile, containers::kContainersStoragePartitionDomain, std::string(id),
+      profile->IsOffTheRecord());
+  params.disposition = foreground ? WindowOpenDisposition::kNewForegroundTab
+                                  : WindowOpenDisposition::kNewBackgroundTab;
+  params.tabstrip_index = index;
+  int add_types = foreground ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE;
+  if (index >= 0) {
+    add_types |= AddTabTypes::ADD_FORCE_INDEX;
+  }
+  if (pinned) {
+    add_types |= AddTabTypes::ADD_PINNED;
+  }
+  params.tabstrip_add_types = add_types;
+  Navigate(&params);
+  return params.navigated_or_inserted_contents;
+}
+
+std::string GetTabContainerId(content::WebContents* web_contents) {
+  if (!base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return std::string();
+  }
+  return containers::GetContainerIdForWebContents(web_contents);
+}
+
+void SetNewTabContainerProvider(NewTabContainerProvider provider) {
+  if (!provider) {
+    containers::SetNewTabContainerProvider({});
+    return;
+  }
+  containers::SetNewTabContainerProvider(base::BindRepeating(
+      [](const NewTabContainerProvider& provider,
+         BrowserWindowInterface* browser)
+          -> std::optional<content::StoragePartitionConfig> {
+        Profile* profile = browser->GetProfile();
+        if (!GetService(profile)) {
+          return std::nullopt;
+        }
+        const std::string id = provider.Run(browser);
+        if (id.empty() || !containers::IsValidStoragePartitionKeyComponent(id)) {
+          return std::nullopt;
+        }
+        return content::StoragePartitionConfig::Create(
+            profile, containers::kContainersStoragePartitionDomain, id,
+            profile->IsOffTheRecord());
+      },
+      std::move(provider)));
+}
+
+void AddObserver(Profile* profile, Observer* observer) {
+  if (auto* service = GetService(profile)) {
+    service->AddObserver(observer);
+  }
+}
+
+void RemoveObserver(Profile* profile, Observer* observer) {
+  if (auto* service = GetService(profile)) {
+    service->RemoveObserver(observer);
+  }
+}
+
+}  // namespace neon::containers_api
