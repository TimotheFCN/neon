+#include "components/containers/content/browser/platform_auth_helper.h"
+
+#include "base/feature_list.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/common/features.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace containers {
+
+bool ShouldSkipPlatformAuth(content::NavigationThrottleRegistry& registry) {
+  // Container tabs share a normal profile (not OTR), so without this guard
+  // PlatformAuthNavigationThrottle would inject device-account identity across
+  // isolated container storage partitions.
+  if (base::FeatureList::IsEnabled(features::kContainers)) {
+    content::WebContents* web_contents =
+        registry.GetNavigationHandle().GetWebContents();
+    return !GetContainerIdForWebContents(web_contents).empty();
+  }
+  return false;
+}
+
+}  // namespace containers
