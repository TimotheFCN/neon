+#ifndef COMPONENTS_CONTAINERS_CONTENT_BROWSER_PLATFORM_AUTH_HELPER_H_
+#define COMPONENTS_CONTAINERS_CONTENT_BROWSER_PLATFORM_AUTH_HELPER_H_
+
+#include "base/component_export.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace containers {
+
+// Whether platform single sign-on (Cloud AP on Windows, Extensible Enterprise
+// SSO on macOS) must be skipped for the navigation of |registry|: true in a
+// container tab. Container tabs share a regular profile, so without this the
+// platform auth throttle would attach the device account's identity to every
+// container, with no way for the user to prevent it.
+//
+// Neon: moved from brave/browser/enterprise/platform_auth_helper.cc
+// (brave::ShouldSkipPlatformAuth) into the containers component, so the
+// enterprise target can call it without depending on chrome/browser code.
+COMPONENT_EXPORT(CONTAINERS_CONTENT_BROWSER)
+bool ShouldSkipPlatformAuth(content::NavigationThrottleRegistry& registry);
+
+}  // namespace containers
+
+#endif  // COMPONENTS_CONTAINERS_CONTENT_BROWSER_PLATFORM_AUTH_HELPER_H_
