+#include "chrome/browser/ui/neon/global/global_window.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/neon/global_context.h"
+#include "chrome/browser/neon/spaces/spaces_service.h"
+#include "chrome/browser/neon/spaces/spaces_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/base_window.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace neon::global {
+
+namespace {
+
+// The size of a global window for a page, before it is fitted to the window
+// it is centred on.
+constexpr gfx::Size kPageSize(960, 720);
+
+BrowserWindowInterface* GetLastActiveNormalWindow(Profile* profile) {
+  BrowserWindowInterface* found = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != profile ||
+            browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            !browser->GetWindow()) {
+          return true;
+        }
+        found = browser;
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return found;
+}
+
+// The global window of |profile| that shows |url|, ignoring the fragment.
+BrowserWindowInterface* FindGlobalWindowShowing(Profile* profile,
+                                                const GURL& url) {
+  BrowserWindowInterface* found = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != profile ||
+            browser->GetType() != BrowserWindowInterface::TYPE_POPUP ||
+            !browser->GetTabStripModel() || !browser->GetWindow()) {
+          return true;
+        }
+        content::WebContents* contents =
+            browser->GetTabStripModel()->GetActiveWebContents();
+        if (contents && contents->GetVisibleURL().GetWithoutRef() ==
+                            url.GetWithoutRef()) {
+          found = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return found;
+}
+
+bool IsRoutedDisposition(WindowOpenDisposition disposition) {
+  switch (disposition) {
+    case WindowOpenDisposition::kCurrentTab:
+    case WindowOpenDisposition::kSingletonTab:
+    case WindowOpenDisposition::kSwitchToTab:
+    case WindowOpenDisposition::kNewForegroundTab:
+    case WindowOpenDisposition::kNewBackgroundTab:
+    case WindowOpenDisposition::kNewWindow:
+      return true;
+    default:
+      return false;
+  }
+}
+
+}  // namespace
+
+void InstallGlobalWindowRouting() {
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  global_context::SetNavigateRouter(base::BindRepeating(&RouteNavigation));
+}
+
+bool IsGlobalWindowEnabled(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return false;
+  }
+  spaces::SpacesService* service =
+      spaces::SpacesServiceFactory::GetForProfile(profile);
+  return service && !service->spaces().empty();
+}
+
+void RouteNavigation(NavigateParams& params) {
+  if (!global_context::IsGlobalContextURL(params.url) ||
+      params.contents_to_insert || !IsRoutedDisposition(params.disposition)) {
+    return;
+  }
+  BrowserWindowInterface* browser = params.browser;
+  Profile* profile =
+      browser ? browser->GetProfile() : params.initiating_profile.get();
+  if (!IsGlobalWindowEnabled(profile)) {
+    return;
+  }
+  if (!browser) {
+    browser = GetLastActiveNormalWindow(profile);
+  }
+  // A window without tabs was made for this navigation (chrome.windows.create
+  // of a normal window): leave it its tab, which the window's spaces then move
+  // to a global window.
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser->GetTabStripModel() || browser->GetTabStripModel()->empty()) {
+    return;
+  }
+  // runtime.openOptionsPage and similar singleton navigations bring back the
+  // window that already shows the page.
+  if (params.disposition == WindowOpenDisposition::kSingletonTab ||
+      params.disposition == WindowOpenDisposition::kSwitchToTab) {
+    if (BrowserWindowInterface* existing =
+            FindGlobalWindowShowing(profile, params.url)) {
+      existing->GetWindow()->Activate();
+      params.disposition = WindowOpenDisposition::kIgnoreAction;
+      return;
+    }
+  }
+  const gfx::Rect bounds = GetCenteredBounds(profile, browser, kPageSize);
+  params.browser = browser;
+  params.disposition = WindowOpenDisposition::kNewPopup;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  params.tabstrip_add_types = AddTabTypes::ADD_ACTIVE;
+  params.tabstrip_index = -1;
+  if (!bounds.IsEmpty()) {
+    params.window_features.bounds = bounds;
+    params.window_features.has_x = params.window_features.has_y = true;
+    params.window_features.has_width = params.window_features.has_height =
+        true;
+  }
+}
+
+void MoveTabToGlobalWindow(BrowserWindowInterface* browser, int index) {
+  TabStripModel* model = browser ? browser->GetTabStripModel() : nullptr;
+  if (!model || !model->ContainsIndex(index)) {
+    return;
+  }
+  Profile* profile = browser->GetProfile();
+  BrowserWindowCreateParams create_params(BrowserWindowInterface::TYPE_POPUP,
+                                          *profile,
+                                          /*from_user_gesture=*/false);
+  create_params.initial_bounds = GetCenteredBounds(profile, browser, kPageSize);
+  BrowserWindowInterface* popup = CreateBrowserWindow(std::move(create_params));
+  if (!popup || !popup->GetTabStripModel()) {
+    return;
+  }
+  std::unique_ptr<content::WebContents> contents =
+      model->DetachWebContentsAtForInsertion(index);
+  popup->GetTabStripModel()->AddWebContents(
+      std::move(contents), 0, ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+      AddTabTypes::ADD_ACTIVE);
+  popup->GetWindow()->Show();
+}
+
+gfx::Rect GetCenteredBounds(Profile* profile,
+                            BrowserWindowInterface* anchor,
+                            const gfx::Size& size) {
+  if (!anchor || anchor->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    anchor = GetLastActiveNormalWindow(profile);
+  }
+  if (!anchor || !anchor->GetWindow()) {
+    return gfx::Rect();
+  }
+  const gfx::Rect window = anchor->GetWindow()->GetBounds();
+  if (window.IsEmpty()) {
+    return gfx::Rect();
+  }
+  gfx::Rect bounds(std::min(size.width(), window.width() * 9 / 10),
+                   std::min(size.height(), window.height() * 9 / 10));
+  bounds.set_origin(
+      window.CenterPoint() -
+      gfx::Vector2d(bounds.width() / 2, bounds.height() / 2));
+  return bounds;
+}
+
+void CenterExtensionPopupBounds(Profile* profile,
+                                bool position_given,
+                                gfx::Rect& bounds) {
+  if (position_given || bounds.IsEmpty() || !IsGlobalWindowEnabled(profile)) {
+    return;
+  }
+  const gfx::Rect centered =
+      GetCenteredBounds(profile, /*anchor=*/nullptr, bounds.size());
+  if (!centered.IsEmpty()) {
+    bounds = centered;
+  }
+}
+
+}  // namespace neon::global
