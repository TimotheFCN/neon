+#ifndef CHROME_BROWSER_NEON_GLOBAL_CONTEXT_H_
+#define CHROME_BROWSER_NEON_GLOBAL_CONTEXT_H_
+
+#include "base/functional/callback.h"
+
+class GURL;
+struct NavigateParams;
+
+// The global context. With spaces, every space the user sees is a container,
+// and the default storage partition holds only the browser's own background
+// work and the extensions. Pages that belong to that context open outside any
+// space: today in a separate popup window (chrome/browser/ui/neon/global),
+// later in an overlay. This file holds the decision of what belongs there, so
+// that both surfaces share it, and the seam chrome::Navigate() calls.
+namespace neon::global_context {
+
+// Whether |url| is a page of the global context: an extension's own page
+// (options page, full-page UI, any chrome-extension:// URL opened as a tab).
+// Such a page needs the default partition, where its extension keeps its
+// storage and its background runs.
+bool IsGlobalContextURL(const GURL& url);
+
+// Called by chrome::Navigate() before it picks a window. The UI layer
+// registers a router that may send |params| to a global window instead of a
+// tab of a space. One router per process.
+using NavigateRouter = base::RepeatingCallback<void(NavigateParams& params)>;
+void SetNavigateRouter(NavigateRouter router);
+void MaybeRouteNavigation(NavigateParams* params);
+
+}  // namespace neon::global_context
+
+#endif  // CHROME_BROWSER_NEON_GLOBAL_CONTEXT_H_
