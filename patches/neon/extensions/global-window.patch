+#ifndef CHROME_BROWSER_UI_NEON_GLOBAL_GLOBAL_WINDOW_H_
+#define CHROME_BROWSER_UI_NEON_GLOBAL_GLOBAL_WINDOW_H_
+
+#include "ui/gfx/geometry/rect.h"
+
+class BrowserWindowInterface;
+class Profile;
+struct NavigateParams;
+
+// The interim surface of the global context: a popup browser window (no tab
+// strip), centred on the browser window that was active. Pages that
+// neon::global_context::IsGlobalContextURL() accepts open there instead of in
+// a tab of a space, and stay in the default storage partition. A later
+// milestone replaces the window with an overlay; it reuses the decision in
+// chrome/browser/neon/global_context.h and RouteNavigation() below.
+//
+// Applies only to profiles with spaces. Without spaces (containers off), the
+// browser opens these pages in tabs, as stock Helium does.
+namespace neon::global {
+
+// Registers RouteNavigation() with chrome::Navigate(). Once per process.
+void InstallGlobalWindowRouting();
+
+// Whether |profile| has spaces, so that global pages leave the tab strip.
+bool IsGlobalWindowEnabled(Profile* profile);
+
+// Sends |params| to a global window when it would show a global page in a
+// tab, or in the current tab, of a normal window with spaces: a new popup
+// window centred on that window, or the global window that already shows the
+// page for a singleton navigation (runtime.openOptionsPage).
+void RouteNavigation(NavigateParams& params);
+
+// Moves the tab at |index| of |browser| into a new global window, keeping
+// the live page. For a global page that reached a tab of a space by another
+// path (a restored session, an older profile).
+void MoveTabToGlobalWindow(BrowserWindowInterface* browser, int index);
+
+// The bounds of a new global window of |size| centred on |anchor|, the last
+// active normal window of |profile| when null. Empty without such a window.
+gfx::Rect GetCenteredBounds(Profile* profile,
+                            BrowserWindowInterface* anchor,
+                            const gfx::Size& size);
+
+// For chrome.windows.create with type "popup": centres the window on the last
+// active normal window when the extension gave no position. Called from the
+// windows API with the bounds it computed.
+void CenterExtensionPopupBounds(Profile* profile,
+                                bool position_given,
+                                gfx::Rect& bounds);
+
+}  // namespace neon::global
+
+#endif  // CHROME_BROWSER_UI_NEON_GLOBAL_GLOBAL_WINDOW_H_
