+#include "chrome/browser/neon/extension_tab_target.h"
+
+#include "base/feature_list.h"
+#include "chrome/browser/containers/containers_navigator_utils.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/common/features.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+
+namespace neon {
+
+std::unique_ptr<containers::ScopedNewTabStoragePartition>
+ScopeExtensionTabToOpener(content::WebContents* opener) {
+  if (!opener ||
+      !base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return nullptr;
+  }
+  const content::StoragePartitionConfig& config =
+      opener->GetSiteInstance()->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  if (!containers::IsContainersStoragePartition(config)) {
+    return nullptr;
+  }
+  return std::make_unique<containers::ScopedNewTabStoragePartition>(config);
+}
+
+}  // namespace neon
