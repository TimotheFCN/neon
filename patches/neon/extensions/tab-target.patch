+#ifndef CHROME_BROWSER_NEON_EXTENSION_TAB_TARGET_H_
+#define CHROME_BROWSER_NEON_EXTENSION_TAB_TARGET_H_
+
+#include <memory>
+
+#include "chrome/browser/containers/containers_navigator_utils.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Where a tab that an extension opens for the user lands (chrome.tabs.create):
+// - an extension page goes to the global window
+//   (chrome/browser/neon/global_context.h);
+// - a tab opened with an opener tab goes to the opener's space;
+// - any other tab goes to the space visible in the target window, as a tab
+//   opened without a source page does (the new tab container provider).
+namespace neon {
+
+// For a tab |opener| opens on behalf of an extension: while the returned
+// scope lives, a new tab without a source page opens in |opener|'s
+// container. Null when |opener| is null or in no container.
+std::unique_ptr<containers::ScopedNewTabStoragePartition>
+ScopeExtensionTabToOpener(content::WebContents* opener);
+
+}  // namespace neon
+
+#endif  // CHROME_BROWSER_NEON_EXTENSION_TAB_TARGET_H_
